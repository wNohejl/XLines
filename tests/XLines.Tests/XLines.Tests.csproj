<Project Sdk="Microsoft.NET.Sdk">

  <!-- The framework, the test packages and IsPackable come from tests/Directory.Build.props. -->

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <!-- Recorded provider payloads, copied next to the test assembly so parsing is
       verified against real response shapes without a network call. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XLines.Core\XLines.Core.csproj" />
    <ProjectReference Include="..\..\src\XLines.Data\XLines.Data.csproj" />
    <ProjectReference Include="..\..\src\XLines.Reliability\XLines.Reliability.csproj" />
    <ProjectReference Include="..\..\src\XLines.Ingestion\XLines.Ingestion.csproj" />
  </ItemGroup>

</Project>
