@namespace XLines.Desk.Primitives
@using XLines.Desk.Windowing

@*
    TEMPLATE-ABLE — see .claude/skills/apple-mudblazor. One dependency does not travel:
    <Glyph> is XLines-local (it is how the desk draws a bare icon from Mud's set), so the
    extracted template substitutes <MudIcon> for it. Everything else here is portable.

    The desk's button, and the reason it wraps MudBlazor rather than sitting beside it.
    Panels hold a lot of these, and a call site that has to remember Variant, Color,
    Ripple, DropShadow and a class string is one that will drift from the call site next
    to it. Here the caller states how loud (Emphasis) and whether it destroys (Role), and
    the styling is not their problem.

    The MudButton underneath is deliberately its plainest variant — Text + Inherit, which
    contributes almost no visual rules of its own — plus Ripple off, because a ripple is
    Material's answer to a press and this system answers with a fast state change instead.
    Everything the button looks like comes from .desk-btn in desk.css. See
    css/mud-bridge.css for why that stack resolves the way it does, and docs ADR 0016
    for the hierarchy this button replaced.
*@

@if (_native)
{
    @*  ADR 0034, step 1: the same key without MudBlazor. .desk-btn already draws all of it, so the
        element is a <button> and nothing else. The caller's own attributes go first and the
        button's go last, which is the order MudButton resolves them in: a caller can add an
        attribute, and cannot take the class, the type or the disabled state away. A press stops
        here, as MudButton's does, so a key inside a pressable row does not also press the row. *@
    <button @ref="_element"
            title="@Title"
            aria-busy="@(Busy ? "true" : null)"
            @attributes="Extra"
            type="@NativeType"
            class="@Classes"
            disabled="@Disabled"
            @onclick="PressAsync"
            @onclick:stopPropagation="true">
        @if (Icon is not null)
        {
            <Glyph Icon="@Icon" />
        }
        @ChildContent
    </button>
}
else
{
    <MudButton @ref="_button"
               Class="@Classes"
               Variant="Variant.Text"
               Color="Color.Inherit"
               Ripple="false"
               DropShadow="false"
               ButtonType="@ButtonType"
               Disabled="@Disabled"
               OnClick="PressAsync"
               aria-busy="@(Busy ? "true" : null)"
               title="@Title"
               @attributes="Extra">
        @if (Icon is not null)
        {
            <Glyph Icon="@Icon" />
        }
        @ChildContent
    </MudButton>
}

@code {
    /// <summary>The label. Omit it for an icon-only button — then <see cref="Title"/> is required.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A MudBlazor icon string, drawn bare through <c>Glyph</c> so buttons use the same icon set as the chrome.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>
    /// How much weight this button claims. See <see cref="DeskEmphasis"/> — exactly one
    /// Filled per context.
    /// </summary>
    [Parameter] public DeskEmphasis Emphasis { get; set; } = DeskEmphasis.Plain;

    /// <summary>Whether pressing this destroys something. See <see cref="DeskRole"/>.</summary>
    [Parameter] public DeskRole Role { get; set; } = DeskRole.Normal;

    [Parameter] public DeskKeySize Size { get; set; } = DeskKeySize.Medium;

    /// <summary>
    /// Work this button started is still running. Runs the in-flight shimmer and refuses
    /// further presses, without going grey — an occupied control is not an inert one.
    /// </summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Tooltip, and the accessible name when there is no label to read.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public ButtonType ButtonType { get; set; } = ButtonType.Button;

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// A busy key refuses the press but is not disabled: it keeps its emphasis, its tab stop and
    /// the focus it has. Disabling it threw focus to the page the moment work began — a popover
    /// closing onto a key that had just gone busy could not give focus back to it — and a key
    /// that says it is busy (aria-busy) has already said why it will not act.
    /// </summary>
    private Task PressAsync(MouseEventArgs e) => Busy ? Task.CompletedTask : OnClick.InvokeAsync(e);

    /// <summary>Extra classes, appended last so a one-off can still win.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private MudButton? _button;
    private ElementReference _element;

    /// <summary>
    /// Whether this key draws without MudBlazor (ADR 0034). Read once: a desk is one or the other
    /// for its whole life. A container that says nothing, a render test's for one, is the desk
    /// as it was.
    /// </summary>
    private bool _native;

    [Inject] private IServiceProvider Services { get; set; } = default!;

    protected override void OnInitialized()
        => _native = (Services.GetService(typeof(DeskNative)) as DeskNative ?? DeskNative.Off).Button;

    private string NativeType => ButtonType switch
    {
        ButtonType.Submit => "submit",
        ButtonType.Reset => "reset",
        _ => "button"
    };

    /// <summary>
    /// Puts the keyboard on this button. Exposed because <c>@ref</c> on a component hands
    /// back the component, not an element, so a caller that needs to move focus here — the
    /// alert's default confirm is the one in the tree — has no other route through the
    /// boundary. MudBlazor already holds the underlying <c>ElementReference</c>; this only
    /// forwards it, and is a no-op before the first render has produced an element.
    /// </summary>
    public ValueTask FocusAsync()
        => _native
            ? _element.Context is null ? ValueTask.CompletedTask : _element.FocusAsync()
            : _button?.FocusAsync() ?? ValueTask.CompletedTask;

    private string Classes => string.Join(' ', Parts().Where(p => p is { Length: > 0 }));

    private IEnumerable<string?> Parts()
    {
        yield return "desk-btn";
        yield return _native ? "desk-btn--native" : null;

        yield return Emphasis switch
        {
            DeskEmphasis.Filled => "desk-btn--filled",
            DeskEmphasis.Tinted => "desk-btn--tinted",
            _ => "desk-btn--plain"
        };

        yield return Role is DeskRole.Destructive ? "desk-btn--destructive" : null;

        yield return Size switch
        {
            DeskKeySize.Small => "desk-btn--sm",
            DeskKeySize.Large => "desk-btn--lg",
            _ => null
        };

        // An icon with no label is a square, so it does not read as a clipped button.
        yield return Icon is not null && ChildContent is null ? "desk-btn--icon" : null;
        yield return Busy ? "desk-btn--busy" : null;
        yield return Class;
    }
}
