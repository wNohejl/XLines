@using XLines.Desk.Windowing
@implements IDisposable
@inject WindowManager Manager
@inject IDeskAlerts Alerts

@*
    The toolbar: the whole catalogue, in one strip that does not move.

    Every openable window is drawn exactly once, always, in catalogue order and grouped the
    way the catalogue groups things — whether or not it is open. State is painted onto that
    fixed furniture rather than changing what the furniture is:

      · Closed   — a quiet key. Press it and the window opens.
      · Open     — the same key, lit, carrying its window's pulse so state travels up here.
      · Current  — washed in the accent, and staying that way wherever the pointer goes.
      · Collapsed — open but put away; said quietly, so it does not read as a column.

    Earlier arrangements appended open windows as tabs, which rearranged the strip on every
    open and close: the key you were reaching for slid sideways, and a subject window with a
    long name pushed the whole catalogue along with it. A toolbar whose contents move is a
    toolbar you have to re-read. Nothing is added here and nothing is removed, so every key
    keeps its place for the whole session.

    Subject windows — an order, a customer, a product, a comparison — appear nowhere in the strip.
    They are about a subject rather than a destination, several can exist at once, and their
    names are long. They live where they already are, as columns on the desk.

    Two separate signals, because they answer two questions:

      · Which one am I in?   The current key's wash, which does not depend on the pointer.
      · Which one am I on?   The marble, which follows the pointer and settles back on the
                             current key when it leaves.

    The marble alone could not do both: it travels on hover, so the moment you reached for
    anything else the answer to the first question left with it.
*@

<div class="bar__strip"
     role="toolbar"
     aria-label="Windows">

    @{
        var groups = CatalogueGroups;

        // Walked once here so the slot numbers come out of the same pass that draws them.
        var total = groups.Sum(g => g.Count);

        if (_refs.Length != total)
            _refs = new ElementReference[total];

        var currentSlot = groups.SelectMany(g => g).ToList().FindIndex(i => i.IsCurrent);

        if (currentSlot < 0)
            currentSlot = 0;

        var slot = 0;

        if (_groupRefs.Length != groups.Count)
            _groupRefs = new ElementReference[groups.Count];
    }

    @* One run, in catalogue order, that does not move — but folded. Each catalogue group is
       one key in the strip, and its windows hang under it as a menu that opens on hover,
       on a press (for touch and keyboard), or when the arrows walk into it. The strip
       reads as five words rather than fourteen, and every window still has exactly one
       key, in catalogue order, whether or not it is open: the furniture is the same, it is
       just kept in drawers.

       The marble travels across the group keys and rests on the group that holds the
       current window. Inside a drawer the keys glide their own plate, like a launcher. *@
    <div class="bar__run" data-glide="marble" role="group" aria-label="Windows">
        @for (var g = 0; g < groups.Count; g++)
        {
            var group = groups[g];
            var name = group[0].Definition!.Group;
            var openInGroup = group.Where(i => i.Open is not null).ToList();
            var currentInGroup = group.Any(i => i.IsCurrent);
            var pinned = _pinned == name;
            var groupIndex = g;
            var firstSlot = slot;

            <div class="bar__menu @(pinned ? "bar__menu--pinned" : null)"
                 @onpointerleave="e => OnLeave(e, name)">
                <button class="bar__group @(currentInGroup ? "bar__group--current" : null) @(openInGroup.Count > 0 ? "bar__group--open" : null)"
                        type="button"
                        aria-haspopup="true"
                        aria-expanded="@(pinned ? "true" : "false")"
                        title="@GroupTip(name, openInGroup)"
                        data-glide-rest="@(currentInGroup ? "" : null)"
                        @ref="_groupRefs[groupIndex]"
                        @onkeydown="e => OnGroupKey(e, name, firstSlot, firstSlot + group.Count - 1)"
                        @onclick="() => TogglePin(name)">
                    <span class="bar__group-name">@name</span>
                    <Glyph Icon="@DeskIcons.ExpandMore" />

                    @if (openInGroup.Count > 0)
                    {
                        <span class="bar__group-pulse @PulseClass(Worst(openInGroup))" aria-hidden="true"></span>
                    }
                </button>

                <div class="bar__menu-panel" role="menu" aria-label="@name" data-glide>
                    @foreach (var item in group)
                    {
                        var index = slot++;
                        var open = item.Open;

                        <button class="bar__key @(item.IsCurrent ? "bar__key--current" : null) @(open is not null ? "bar__key--open" : null) @(open?.Minimised == true ? "bar__key--collapsed" : null)"
                                type="button"
                                role="menuitem"
                                aria-current="@(item.IsCurrent ? "true" : null)"
                                tabindex="@(index == currentSlot || (pinned && index == firstSlot) ? "0" : "-1")"
                                title="@Tip(item)"
                                aria-label="@Label(item)"
                                aria-keyshortcuts="@(open is not null ? "Delete" : null)"
                                data-close-window="@open?.Id"
                                @ref="_refs[index]"
                                @onkeydown="e => OnKeyDown(e, index)"
                                @onclick="() => Press(item)">
                            <Glyph Icon="@item.Icon" />
                            <span class="bar__key-name">@item.Title</span>

                            @if (open is not null)
                            {
                                <span class="bar__pulse @PulseClass(open.Pulse)" aria-hidden="true"></span>

                                @* The pointer's way to close a window from where every window is
                                   listed, as a tab's row has in its menu (DeskMenuItem's remove):
                                   a glyph at the row's end, not a key of its own — the keyboard
                                   closes with Delete on the row, a middle click closes too. *@
                                <span class="bar__close" title="Close @item.Title" aria-hidden="true"
                                      @onclick="() => CloseAsync(open)" @onclick:stopPropagation="true">
                                    <Glyph Icon="@DeskIcons.Close" />
                                </span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ElementReference[] _refs = [];

    /// <summary>The group whose drawer is held open by a press or by keyboard travel, if any.</summary>
    private string? _pinned;

    /// <summary>One place in the bar: a window that is open, or one that could be.</summary>
    private sealed record Item(
        string Icon,
        string Title,
        WindowDefinition? Definition,
        WindowInstance? Open,
        bool IsCurrent);

    // Both signals: the row's changes move keys between open and closed, and a window's own
    // status is the dot and the tooltip its key carries. Of all the chrome above the desk, the
    // bar is the one piece a status line reaches.
    protected override void OnInitialized()
    {
        Manager.Changed += OnChanged;
        Manager.WindowChanged += OnWindowChanged;

        // What the first render is about to draw; set here rather than in OnParametersSet, which
        // a re-render from outside runs again before ShouldRender asks.
        _drawn = Signature();
    }

    /// <summary>The signature of what the bar last drew. See <see cref="ShouldRender"/>.</summary>
    private string? _drawn;

    /// <summary>
    /// Both signals reach the bar for every change on the desk — a divider dragged, a workspace
    /// saved, any window's status — and most move nothing it draws. It draws again only when
    /// <see cref="Signature"/> differs from the last it drew, or when a key is waiting to take
    /// keyboard focus after the render (which needs that render to happen).
    /// </summary>
    protected override bool ShouldRender()
    {
        var signature = Signature();

        if (_focusAfterRender is null && signature == _drawn)
            return false;

        _drawn = signature;
        return true;
    }

    /// <summary>
    /// Every value the markup above reads, read the way it reads it: from the same catalogue walk,
    /// so a value the bar draws cannot be left out of the comparison without being left out of
    /// the bar. Per key: its definition's group, icon, title and description; the window open on
    /// it — id, collapsed, pulse, status line, and whether it shows in its column or waits behind
    /// which window; whether it is current. Then the drawer pinned open. Nothing else is drawn:
    /// the group key's tip, pulse and wash are functions of these.
    /// </summary>
    private string Signature()
    {
        var text = new System.Text.StringBuilder();

        foreach (var group in CatalogueGroups)
        {
            text.Append('\u001d');

            foreach (var item in group)
            {
                text.Append('\u001e')
                    .Append(item.Definition?.Group).Append('\u001f')
                    .Append(item.Icon).Append('\u001f')
                    .Append(item.Title).Append('\u001f')
                    .Append(item.Definition?.Description).Append('\u001f')
                    .Append(item.IsCurrent ? '1' : '0');

                if (item.Open is { } open)
                {
                    var showing = Manager.ColumnOf(open.Id)?.Showing;

                    text.Append('\u001f').Append(open.Id)
                        .Append('\u001f').Append(open.Minimised ? '1' : '0')
                        .Append('\u001f').Append((int)open.Pulse)
                        .Append('\u001f').Append(open.StatusText)
                        .Append('\u001f').Append(Manager.IsShowing(open) ? '1' : '0')
                        .Append('\u001f').Append(showing == open ? null : showing?.Title);
                }
            }
        }

        return text.Append('\u001d').Append(_pinned).ToString();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnWindowChanged(string _) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Manager.Changed -= OnChanged;
        Manager.WindowChanged -= OnWindowChanged;
    }

    /// <summary>
    /// The catalogue, always, grouped the way the catalogue groups it — with whichever
    /// window is open attached to its own entry.
    ///
    /// <para>
    /// Every entry is present whether or not it is open, because the strip's job is to be in
    /// the same place every time you look at it. An entry that disappeared when its window
    /// opened, or a tab that appeared beside it, would move every key to its right.
    /// </para>
    ///
    /// <para>
    /// Subject windows — an order, a customer, a product, a comparison — have no catalogue entry
    /// and deliberately get none here. They are about a subject rather than a destination,
    /// there can be several at once, and their names are long: appending them is exactly what
    /// made the strip unreadable. They are reachable where they already are, as columns on
    /// the desk, and a collapsed one still leaves its own stub to press.
    /// </para>
    /// </summary>
    private List<List<Item>> CatalogueGroups => Manager.Catalog.All
        .Where(d => !d.RequiresSubject)
        .GroupBy(d => d.Group)
        .Select(g => g.Select(d =>
        {
            var open = Manager.Windows.FirstOrDefault(w => w.Definition.Key == d.Key);

            return new Item(d.Icon, d.Title, d, open, open is not null && open.Id == Manager.FocusedId);
        }).ToList())
        .Where(g => g.Count > 0)
        .ToList();

    /// <summary>
    /// The strip in the order it is drawn. Only the keyboard needs this — the render builds
    /// the same order inline and keeps the slot numbers from that one pass.
    /// </summary>
    private List<Item> Flat => CatalogueGroups.SelectMany(g => g).ToList();

    private static string PulseClass(PulseState pulse) => pulse switch
    {
        PulseState.Healthy => "pulse--healthy",
        PulseState.Warn => "pulse--warn",
        PulseState.Critical => "pulse--critical",
        PulseState.Active => "pulse--active",
        _ => "pulse--idle"
    };

    // A window waiting as a tab is open but not in view: its key shows it, bringing it forward.
    private string Label(Item item)
        => item.Open is null
            ? $"Open {item.Title}"
            : item.Open.Minimised
                ? $"Restore {item.Title}"
                : !Manager.IsShowing(item.Open)
                    ? $"Show {item.Title}"
                    : $"Focus {item.Title}";

    /// <summary>An icon has to carry its name somewhere, and a closed one carries it here.</summary>
    private string Tip(Item item)
    {
        if (item.Open is null)
            return $"{item.Title} — {item.Definition?.Description}";

        var state = item.Open.Minimised
            ? " — collapsed, press to restore"
            : Manager.ColumnOf(item.Open.Id) is { } column && column.Showing != item.Open
                ? $" — a tab behind {column.Showing.Title}, press to show"
                : null;

        return string.IsNullOrEmpty(item.Open.StatusText)
            ? $"{item.Title}{state}"
            : $"{item.Title} · {item.Open.StatusText}{state}";
    }

    /// <summary>Open it, or go to it. Focus restores a collapsed column on the way.</summary>
    private void Press(Item item)
    {
        // The drawer has done its job once a key inside it is pressed.
        _pinned = null;

        if (item.Open is not null)
            Manager.Focus(item.Open.Id);
        else if (item.Definition is not null)
            Manager.Open(item.Definition);
    }

    // The drawer stays open on a close: the row is still there, now as a closed key, and the next
    // window to close is usually the row beside it.
    private Task CloseAsync(WindowInstance window) => WindowClosing.CloseAsync(Manager, Alerts, window);

    private void TogglePin(string group) => _pinned = _pinned == group ? null : group;

    private void Unpin(string group)
    {
        if (_pinned == group)
            _pinned = null;
    }

    // A touch lifts off its target the moment the tap ends, and pointerleave follows it: the drawer
    // a tap had just pinned closed again under the finger. Only a pointer that hovers leaves.
    private void OnLeave(PointerEventArgs e, string group)
    {
        if (e.PointerType != "touch")
            Unpin(group);
    }

    private ElementReference[] _groupRefs = [];

    /// <summary>A key to focus once the drawer holding it is drawn open: a closed drawer's keys cannot take focus.</summary>
    private int? _focusAfterRender;

    /// <summary>
    /// A group key is a menu button: Down opens its drawer on the first window, Up on the last,
    /// Escape closes it. Enter and Space press it, which pins the drawer and leaves focus on the key.
    /// Without this only the drawer holding the current window could be reached from the keyboard.
    /// </summary>
    private void OnGroupKey(KeyboardEventArgs e, string group, int first, int last)
    {
        if (e.CtrlKey || e.MetaKey || e.AltKey)
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                _pinned = group;
                _focusAfterRender = first;
                break;
            case "ArrowUp":
                _pinned = group;
                _focusAfterRender = last;
                break;
            case "Escape":
                Unpin(group);
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not { } index)
            return;

        _focusAfterRender = null;

        if (index < _refs.Length)
        {
            try
            {
                await _refs[index].FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Not attached yet in a test renderer.
            }
        }
    }

    /// <summary>The loudest pulse among a group's open windows, so a critical Ops still shows on a closed drawer.</summary>
    private static PulseState Worst(List<Item> open) => open
        .Select(i => i.Open!.Pulse)
        .OrderByDescending(p => p switch
        {
            PulseState.Critical => 4,
            PulseState.Warn => 3,
            PulseState.Active => 2,
            PulseState.Healthy => 1,
            _ => 0
        })
        .First();

    private static string GroupTip(string group, List<Item> open)
        => open.Count == 0
            ? $"{group} windows"
            : $"{group} — open: {string.Join(", ", open.Select(i => i.Title))}";

    private async Task OnKeyDown(KeyboardEventArgs e, int pressedOn)
    {
        var flat = Flat;
        var last = flat.Count - 1;

        if (last < 0)
            return;

        // The key the keystroke landed on. Each key handles its own keydown and says which it
        // is, so this never has to be inferred from focus events — which a hidden document
        // does not dispatch — or from the current window, which is where focus may not be.
        var current = Math.Clamp(pressedOn, 0, last);

        // Closing from the keyboard: acts on the key that has focus, and only if it has a
        // window — there is nothing to close about a closed key.
        // Escape closes the drawer and hands focus back to its group key: the key that held it is
        // about to be hidden.
        if (e.Key == "Escape")
        {
            var group = flat[current].Definition?.Group;
            _pinned = null;

            var index = CatalogueGroups.FindIndex(g => g[0].Definition?.Group == group);
            if (index >= 0 && index < _groupRefs.Length)
                await _groupRefs[index].FocusAsync();

            return;
        }

        // Delete closes the window the key names, by the one road every close key takes: a window
        // holding unsaved input asks first. It used to close it outright, and Backspace with it —
        // the easiest key there is to press by accident — so it is Delete alone now.
        if (e.Key == "Delete")
        {
            if (flat[current].Open is { } window)
                await WindowClosing.CloseAsync(Manager, Alerts, window);

            return;
        }

        var next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => current == last ? 0 : current + 1,
            "ArrowLeft" or "ArrowUp" => current == 0 ? last : current - 1,
            "Home" => 0,
            "End" => last,
            _ => current
        };

        if (next == current)
            return;

        // Arrows walk the bar without opening anything: pressing is what opens. Moving
        // focus to a closed window would otherwise open a window per keystroke.
        // Walking into another group's drawer opens it; a focused key in a closed drawer
        // would be a key nobody can see.
        // Focused after the render that opens its drawer, since a key in a closed one cannot be.
        _pinned = flat[next].Definition?.Group;
        _focusAfterRender = next;
        await Task.CompletedTask;
    }
}
