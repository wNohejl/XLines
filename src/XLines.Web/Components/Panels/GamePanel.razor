@using XLines.Core.Entities
@using XLines.Data.CrossReference
@using XLines.Desk.Primitives
@using XLines.Web.Components.Snippets
@using XLines.Desk.Windowing
@inherits PanelBase

@*
    The consolidated game view: lines, team data and players, in the order that matters right
    now.

    A pregame game is read top-down — what's the number, who's playing, how have they been
    playing — because nothing on the board has happened yet. A live game is read the other way:
    the score is the headline, "top bets" means what's still open rather than what closed, and
    team/player form is read as "does the game so far match the form" rather than a preview.
    Same three sections either way; only the order changes, because the question being asked of
    them changes.

    Team and player names are the way into their own history — following one is what "building
    on form" means: a flat aggregate here, a game log or a recent-record one click away.
*@

@* The failure line sits above whatever the window already holds, as the Board's does. The
   window refreshes on its own game's notices and every journal signal, and one refresh that failed used to
   replace a loaded scoreboard, its lines and its players with the sentence. *@
@if (Failed)
{
    <PanelLoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (_row is null)
{
    @if (!Failed)
    {
        @* The scoreboard's two rows and the first rows of the lines, in the places they will
           land — a sentence saying the game is loading is a placeholder shaped like nothing. *@
        <DeskSkeleton Shape="DeskSkeletonShape.Block" Width="45%" Height="56px" />
        <DeskSkeleton Lines="3" />
    }
}
else
{
    var game = _row.Game;
    var isLive = game.Status == GameStatus.Live;
    var situation = PlayState.Situation(game);
    var lastPlay = PlayState.LastPlay(game);
    var (lineHome, lineAway) = Linescores.Parse(_bout is null && game.Status is GameStatus.Live or GameStatus.Final ? game.Linescore : null);

    @*
        The window is a flow of cards (.wflow): the matchup, the score by period, head to head, the
        lines (two tracks once two fit), team data and your bets each one card, as many across as
        the window's width allows, so a wide window gets more cards rather than wider ones; the
        players, a box score or a fight's tale of the tape take the row beneath, centred.
        It was one column of loose parts — the teams undivided, the date floating under them, Place
        wager a screen away at the far edge, and the sections running together (user mock-up, Nov 22).
    *@
    <div class="wflow gamewin">
    @* The matchup card: any tags on the first line, the two teams divided by an inset hairline,
       and at its foot one quiet line — when it starts and which season it counts toward, or the
       state of play — with the keys that open its companion windows trailing inside the card. *@
    <div class="wsection gamecard">
    <div class="wgroup">
    <PanelTitle>
        <ChildContent>
            @* Two rows, away over home, the winner heavier than the loser. *@
            <Scoreboard Game="game"
                        OnTeam="@((int teamId) => Manager.OpenTeam(teamId, teamId == game.AwayTeamId ? game.AwayTeam?.Name : game.HomeTeam?.Name, WindowId))" />
        </ChildContent>
        <Tags>
            @* A scheduled game's phase is its start time, which the detail line already says;
               the Board gives it no status tag, and neither does its window. While it is on, the
               tag is the period and clock rather than the word "Live" (PlayState). *@
            @if (game.Status != GameStatus.Scheduled)
            {
                <Tag State="@StatusState(game.Status)" Live="@isLive">@Phase(game)</Tag>
            }
            @if (game.DoubleHeaderGame is { } number)
            {
                <Tag State="DeskState.Info">Game @number of a doubleheader</Tag>
            }
            @if (_bout is { } card)
            {
                @* A fight belongs to a card, not a season (ADR 0021). *@
                @if (FightSports.CardName(card) is { Length: > 0 } cardName)
                {
                    <Tag State="DeskState.Info">@cardName</Tag>
                }
                @if (card.TitleFight)
                {
                    <Tag State="DeskState.Info">Title fight</Tag>
                }
            }
        </Tags>
        @* When, and which season it counts toward, on the one quiet line under the title. The
           season was an Info tag on the title's row, where beside the two stacked clubs it floated
           mid-row, away from the name it qualified, with the date alone on the line below. A
           February game that is the prior year's postseason still says so: "2025 postseason". A
           fight belongs to a card, not a season (ADR 0021), so it keeps its card tag above. *@
        <Detail>
            @*  While a game is on, the line is the state of play — "CHI ball, 2nd & 6 at NE 34 ·
                Last: D.Maye pass incomplete…" — in place of a start time that has passed. With
                only a score to move the title could only jump between scores (spec 2026-10-24 §3);
                the down and the last play change every play. Nothing is drawn for a field ESPN
                did not send, and the start comes back when there is no state of play to give. *@
            @if (situation is not null)
            {
                <span class="gamelive__situation">@situation</span>
            }
            @if (lastPlay is not null)
            {
                @* The whole play is the line's tooltip, which keyboard focus raises as well as
                   hover: the line gives way to the window with an ellipsis. *@
                <DeskTooltip Text="@(game.LastPlay!)">
                    <span class="gamelive__last" tabindex="0">Last: @lastPlay</span>
                </DeskTooltip>
            }
            @if (situation is null && lastPlay is null)
            {
                <span>@Starts(game.StartsAt)@(_bout is null ? $" · {SeasonWords(game)}" : "")</span>
            }
            @if (_bout is { } bout)
            {
                <span>@BoutFrame(bout)</span>
                @if (FightSports.ResultLine(game, bout) is { } result)
                {
                    <span class="ptitle__em">@result</span>
                }
            }
            @if (!isLive && (game.AwayProbablePitcher is not null || game.HomeProbablePitcher is not null))
            {
                @* In full here, where there is room: the Board shortens them to surnames. *@
                <span>
                    Starters
                    <span class="ptitle__em">@(game.AwayProbablePitcher ?? "TBD")</span> vs
                    <span class="ptitle__em">@(game.HomeProbablePitcher ?? "TBD")</span>
                </span>
            }
        </Detail>
        <Keys>
            @* Only what applies to the whole game. Movement opens under each market's row and
               Head to head in its own card, in place rather than in windows of their own; the
               season switch sits in the two blocks it chooses for (Team data, Players). *@
            <DeskRow data-glide="">
                @* The game play by play, in a window of its own beside this one. Offered for an
                   NFL game once it has kicked off (GamecastPanel.Offered): a final keeps the key,
                   because its plays stay stored. Tinted, as a key opening a window is. *@
                @if (GamecastPanel.Offered(game))
                {
                    <DeskButton Icon="@DeskIcons.SportsFootball" Emphasis="DeskEmphasis.Tinted"
                                Title="Follow this game play by play in the Gamecast window"
                                OnClick="() => Manager.OpenGamecast(game.Id, WindowShortcuts.Describe(game))">
                        Gamecast
                    </DeskButton>
                }
                @* The wager wizard preloaded from this game: its form opens on this matchup
                   rather than on a game search. A visitor has no wager to log (ADR 0018). *@
                @if (Manager.Access.CanOperate)
                {
                    <WagerKey Kind="WagerKind.Place"
                              Title="Log a bet on this game in the Place wager window"
                              OnClick="() => Manager.OpenWager(game)" />
                }
            </DeskRow>
        </Keys>
    </PanelTitle>
    </div>
    </div>

    @* The score by period, once one has been played: the Gamecast's own part, so the two windows
       word a quarter, an inning and a total the same way, here as a card of its own beside the
       matchup. A fight has rounds but no points by round, and a game the feed holds no line score
       for draws nothing — not even an empty card. *@
    @if (lineHome.Count > 0 || lineAway.Count > 0)
    {
        <div class="wsection gamescore">
            <div class="wgroup">
                <Linescore Sport="@game.Sport?.Key" Class="linescore--inset"
                           AwayAbbrev="@(game.AwayTeam?.Abbrev ?? "Away")" HomeAbbrev="@(game.HomeTeam?.Abbrev ?? "Home")"
                           Away="lineAway" Home="lineHome"
                           AwayTotal="game.AwayScore" HomeTotal="game.HomeScore" />
            </div>
        </div>
    }

    @* The matchup's history, about the game rather than any one part of it. Closed it is one row
       carrying the record; open, the last meetings, with the full record one key further. A card
       of its own (GameHeadToHead). *@
    <GameHeadToHead GameId="GameId" HomeName="@SideName(true)" AwayName="@SideName(false)"
                    IsFight="@(_bout is not null)"
                    Sport="@game.Sport?.Key" HomeAbbrev="@game.HomeTeam?.Abbrev" AwayAbbrev="@game.AwayTeam?.Abbrev"
                    OnOpenWindow="() => Manager.OpenHeadToHead(GameId, WindowShortcuts.Describe(game), WindowId)" />

    @* The lines and the team data are cards of the overview, beside the matchup, rather than two
       small cards behind two tabs while three quarters of a wide window stood empty (user, Nov 22).
       The lines take two tracks once two fit (.gamewin__pair), so a side's number and price stay
       on one line and an opened market has the room it needs. *@
    @RenderMarkets(isLive)

    @if (_bout is null && (HasTeamData || _seasonOptions.Count > 1))
    {
        @RenderTeamData()
    }

    @* The journal wired into the desk: what you have riding on this game, where you are
       looking at it, rather than in a list in another window. A card: its name in the bar, the
       Journal link trailing it, a row per bet. Up to two bets show as rows; from three they fold
       behind one row that says what is riding, so a busy game's bets do not push its lines below
       the fold. *@
    @if (_bets.Count > 0)
    {
        <section class="wsection gamebets" aria-labelledby="@BetsHeadingId">
            <div class="wgroup">
                <div class="wgroup__bar">
                    <h3 class="wgroup__title" id="@BetsHeadingId">Your bets on this game</h3>
                    <div class="wgroup__keys">
                        <DeskLink Destination="journal" OnClick="() => Manager.OpenJournal()">Journal</DeskLink>
                    </div>
                </div>
                @if (_bets.Count >= FoldBetsAt)
                {
                    <div class="wgroup__row gamebets__fold">
                        <DeskDisclosure Label="@BetsSummary(_bets)" @bind-Open="_betsOpen">
                            @RenderBets()
                        </DeskDisclosure>
                    </div>
                }
                else
                {
                    @RenderBets()
                }
            </div>
        </section>
    }

    @* What genuinely needs the whole row takes it, beneath the overview: the players (or the box
       score), and for a fight the tale of the tape and the fight stats. The block is centred at a
       table's reading width, not the window's (.gameroster__block), and from a wide flow the away
       side reads left and the home side right, each a stack of its cards. Only a fight has two
       wide readings to switch between, so only a fight has tabs, and they sit on the block's own
       leading edge. *@
    @if (_bout is not null)
    {
        <div class="wsection wsection--span gameroster">
            <div class="gameroster__block">
                <DeskTabs TValue="Section" Tabs="@FightSections" Label="Fight sections" @bind-Value="_section">
                    @if (context == Section.Tape)
                    {
                        <TaleOfTheTape GameId="GameId" OnFighter="@(((int TeamId, string Name) f) => Manager.OpenTeam(f.TeamId, f.Name, WindowId))" />
                    }
                    else
                    {
                        <div class="gameroster__cols">
                            @RenderBoxScore()
                        </div>
                    }
                </DeskTabs>
            </div>
        </div>
    }
    else if (HasBox || HasRoster)
    {
        <div class="wsection wsection--span gameroster">
            <PanelSection Class="gameroster__block" Title="@(HasBox ? "Box score" : "Players")"
                          Keys="@(!HasBox && _seasonOptions.Count > 1 ? RenderSeason("Season for player data") : null)">
                <div class="gameroster__cols">
                    @RenderPlayers()
                </div>
            </PanelSection>
        </div>
    }
    </div>
}

@code {
    /// <summary>The bet rows, folded or not (GameBetRows).</summary>
    private RenderFragment RenderBets() => @<GameBetRows Bets="_bets" />;

    /// <summary>An open roster row's snippet (ActionsFor): the player's last five games.</summary>
    private static RenderFragment RecentSnippet(int id) => @<PlayerRecentSnippet PlayerId="id" />;

    @* The lines, a card of the overview named in its bar. Only the name turns on whether the game
       is under way: before it the prices are the lines being offered, during it what is still open
       to bet — the same card, a different question, and the bar is where that gets said. An
       unpriced game still answers "what is the number", with the reason there isn't one. *@
    private RenderFragment RenderMarkets(bool isLive) => @<text>
        @if (_row!.Unpriced is { } reason)
        {
            <section class="wsection gamelines" aria-labelledby="@LinesHeadingId">
                <div class="wgroup">
                    <div class="wgroup__bar">
                        <h3 class="wgroup__title" id="@LinesHeadingId">@(isLive ? "Top bets" : "Lines")</h3>
                    </div>
                    <EmptyState>@reason</EmptyState>
                </div>
            </section>
        }
        else
        {
            @*
                A grouped list, a row per market and a column per side: away then home, as the
                title reads, and Over then Under. Each cell is the side and its number, with the
                book holding it by name beneath in secondary ink.

                It was three clusters of the Board's price cell side by side in the left third of
                the window — tiny prices, a two-letter monogram (PN, DK, MG) nobody had been told
                how to read, and a rail of ticks under each. The cell is built for a dense grid
                where the same books repeat down a column; here there are six numbers and room
                to name them. The rest of the market — every book's price — is the cell's
                disclosure under its row, and the Line movement window. A live price is a door: pressed, it opens the wager
                window on that side at that book, as the Board's prices do.
            *@
            <section class="wsection gamelines gamewin__pair" aria-labelledby="@LinesHeadingId">
                <div class="wgroup">
                    <div class="wgroup__bar">
                        <h3 class="wgroup__title" id="@LinesHeadingId">@(isLive ? "Top bets" : "Lines")</h3>
                    </div>
                    @* A game reads away then home, as its title does; a fight reads red corner
                       (home) first, as its card bills it and the Board's row now leads (ADR 0021). *@
                    @if (_bout is null)
                    {
                        @LineRow("Moneyline", _row.Moneyline.Second, _row.Moneyline.First, SideName(false), SideName(true), total: false, SideAbbrev(false), SideAbbrev(true))
                    }
                    else
                    {
                        @LineRow("Moneyline", _row.Moneyline.First, _row.Moneyline.Second, SideName(true), SideName(false), total: false, SideAbbrev(true), SideAbbrev(false))
                    }
                    @* A fight has no spread (ADR 0021). *@
                    @if (_bout is null)
                    {
                        @LineRow("Spread", _row.Spread.Second, _row.Spread.First, SideName(false), SideName(true), total: false, SideAbbrev(false), SideAbbrev(true))
                    }
                    @LineRow(_bout is null ? "Total" : "Total rounds", _row.Total.First, _row.Total.Second, "Over", "Under", total: true)
                </div>
                <p class="wgroup__foot">@LinesFoot</p>
            </section>
        }
    </text>;

    /// <summary>
    /// One market: its name leading, then the two sides, each a cell of <see cref="LineCell"/>.
    ///
    /// <para>
    /// The name is a disclosure (HIG, disclosure triangles): pressed, the market opens under its
    /// row — how each book moved it before the start, every book's close after — where the
    /// Movement key used to open a window that, once the game started, had nothing to show. The
    /// side cells keep their own press, the wager door. One market open at a time, as one row is
    /// on every other list on the desk.
    /// </para>
    /// </summary>
    private RenderFragment LineRow(string market, BestOffer? first, BestOffer? second, string firstSide, string secondSide, bool total, string? firstAbbrev = null, string? secondAbbrev = null) => @<text>
        @{
            var key = MarketKey(market);
            var open = _openMarket == key;
            var region = $"gamemove-{WindowId}-{key}";
        }
        @* Not a FormRow: the name is a press of its own, not a label, so the row lays out its
           name and its two sides itself (.gamelines__row, in the form row's columns). *@
        <div class="wgroup__row gamelines__row @(open ? "gamelines__row--open" : null)">
            <button type="button" class="gamelines__toggle disclosure__summary"
                    aria-expanded="@(open ? "true" : "false")" aria-controls="@region"
                    @onclick="() => ToggleMarket(key)">
                <span class="disclosure__triangle" aria-hidden="true"><Glyph Icon="@DeskIcons.ArrowRight" /></span>
                <span>@market</span>
            </button>
            <div class="gamelines__sides">
                @LineCell(first, firstSide, total, key, firstAbbrev)
                @LineCell(second, secondSide, total, key, secondAbbrev)
            </div>
        </div>
        @if (open)
        {
            <div class="wgroup__row gamelines__detail">
                <MarketMovement Id="@region" GameId="GameId" Market="@key" MarketName="@market"
                                First="first" Second="second" FirstSide="@firstSide" SecondSide="@secondSide"
                                Sport="@_row!.Game.Sport?.Key" FirstAbbrev="@(total ? null : firstAbbrev)" SecondAbbrev="@(total ? null : secondAbbrev)"
                                Closing="@_row!.PricesAreClosing" PricedAt="@_row.PricedAt"
                                Expanded="@_expandedMarkets.Contains(key)" Polled="_polled"
                                ExpandedChanged="@((bool all) => SetMarketExpanded(key, all))"
                                OnOpenWindow="() => Manager.OpenMovement(GameId, WindowShortcuts.Describe(_row.Game))" />
            </div>
        }
    </text>;

    /// <summary>
    /// Which season the team data and rosters are drawn from, in the bar of each block it
    /// chooses for — the Team data card and the Players block — rather than stranded at the
    /// window's far left above them. Both switches are the one choice: moving either moves both.
    /// It sat on the title's row, four controls wide, while the lines never read it. Hides itself
    /// for a fight, which has no season (ADR 0021), and when there is one season to draw on.
    /// </summary>
    private RenderFragment RenderSeason(string label) => @<text>
        @if (_bout is null && _seasonOptions.Count > 1)
        {
            <DeskSwitch Options="_seasonOptions" Label="@label" Mono="true"
                        Size="DeskKeySize.Small"
                        Value="_seasonYear ?? 0" ValueChanged="@((int year) => SetSeasonAsync(year))" />
        }
    </text>;

    /// <summary>
    /// A side's best number and the book holding it: "Cowboys +3.5 −110" over "DraftKings". A
    /// total names its number bare ("Over 47.5"), since the side already says which way. Value
    /// against the fair price follows the book on a live price; a close says it is one.
    ///
    /// <para>
    /// A live price the operator can take is a real <c>&lt;button type="button"&gt;</c>, which
    /// presses on Enter and Space without scrolling the window (HIG 2); any other is a plain
    /// reading. One reset rule in xlines.css makes the two look the same.
    /// </para>
    /// </summary>
    private RenderFragment LineCell(BestOffer? offer, string side, bool total, string market, string? abbrev) => @<text>
        @* Every book's price is the cell's tooltip, raised by keyboard focus as well as hover —
           a title on the reading reached a pointer only — and its line breaks are kept. A cell
           with no price has no books to list and no tooltip. *@
        @if (CanTake(offer))
        {
            <DeskTooltip Text="@(EveryBook(offer!) + "\nPress to place a wager on this side.")">
                <button type="button" class="gamelines__cell gamelines__cell--take"
                        @onclick="() => Take(market, offer)">@LineInside(offer, side, total, abbrev)</button>
            </DeskTooltip>
        }
        else if (offer is not null)
        {
            <DeskTooltip Text="@EveryBook(offer)">
                <div class="gamelines__cell" tabindex="0">@LineInside(offer, side, total, abbrev)</div>
            </DeskTooltip>
        }
        else
        {
            <div class="gamelines__cell">@LineInside(offer, side, total, abbrev)</div>
        }
    </text>;

    /// <summary>What a side's cell shows: spans only, since a button holds phrasing content.</summary>
    private RenderFragment LineInside(BestOffer? offer, string side, bool total, string? abbrev) => @<text>
        @{
            // A club's side leads with its crest, and the book beneath starts at the name rather
            // than under the crest; Over and Under, and a fighter, have none.
            var sport = _row?.Game.Sport?.Key;
            var crested = !total && TeamLogos.Has(sport, abbrev);
        }
        <span class="gamelines__price">
            @if (crested)
            {
                <TeamMark Sport="@sport" Abbrev="@abbrev" />
            }
            <span class="gamelines__side">@side</span>
            @if (offer is null)
            {
                <span class="dim">—</span>
            }
            else
            {
                @* The number and its price are one reading and never part on a wrap: in a narrow
                   card the pair drops beneath the side's name whole, never "+3.5" over "−105". *@
                <span class="gamelines__num">
                    @if (offer.Line is { } line)
                    {
                        <span>@(total ? Math.Abs(line).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : OddsMath.FormatLine(line, offer.Outcome))</span>
                    }
                    <span>@OddsMath.FormatPrice(offer.PriceAmerican)</span>
                </span>
            }
        </span>
        <span class="gamelines__book@(crested ? " gamelines__book--crested" : "")">
            @if (offer is null)
            {
                @:Not priced
            }
            else
            {
                @BookNames.Display(offer.Book)@(offer.IsClosing ? " · closing" : "")
                @if (!offer.IsClosing && offer.Ev is { } ev)
                {
                    <span class="@(ev > 0 ? "up" : null)"> · @PriceCell.EvLabel(ev)</span>
                }
            }
        </span>
    </text>;

    @* One card, a row per side, away then home as the title reads, divided by an inset hairline.
       They were two loose stacks side by side with nothing to say they were one reading. *@
    private RenderFragment RenderTeamData() => @<text>
        <section class="wsection gameteams" aria-labelledby="@TeamsHeadingId">
            <div class="wgroup">
                <div class="wgroup__bar">
                    <h3 class="wgroup__title" id="@TeamsHeadingId">Team data</h3>
                    @if (_seasonOptions.Count > 1)
                    {
                        <div class="wgroup__keys">@RenderSeason("Season for team data")</div>
                    }
                </div>
                @RenderTeamRecord(_awayTeam, _row!.Game.AwayTeamId, _row.Game.AwayTeam?.Name ?? "Away", SideAbbrev(false))
                @RenderTeamRecord(_homeTeam, _row.Game.HomeTeamId, _row.Game.HomeTeam?.Name ?? "Home", SideAbbrev(true))
            </div>
        </section>
    </text>;

    private RenderFragment RenderTeamRecord(TeamForm? form, int teamId, string name, string? abbrev) => @<text>
        <div class="wgroup__row gameteams__row">
            @* The crest before the link, not inside it: the link's hover rule runs under its label,
               and a crest is not part of what is pressed. *@
            <span class="gameteam__name">
                <TeamMark Sport="@_row?.Game.Sport?.Key" Abbrev="@abbrev" />
                <DeskLink Destination="team" Icon="@DeskIcons.Shield"
                          OnClick="() => Manager.OpenTeam(teamId, name, WindowId)">@name</DeskLink>
            </span>

            @* "In the window" read as the desk window this sits in; the reach is the season
               switched above. One game is a game. *@
            @if (form is null || form.Recent.Count == 0)
            {
                <div class="meta">No games on record for this season.</div>
            }
            else
            {
                <div class="meta">
                    @form.Record over @form.Recent.Count.ToString("N0") @(form.Recent.Count == 1 ? "game" : "games")
                </div>
                <DeskRow>
                    <FormRun Log="@FormResult.From(form.Recent)" />
                </DeskRow>
            }
        </div>
    </text>;

    /// <summary>
    /// Who is playing, or what they did.
    ///
    /// <para>
    /// Before a game these are two rosters and their recent form, because that is the only
    /// evidence there is. Once it is under way the box score exists, and showing a thirty-day
    /// average instead would be answering a question nobody asked while looking at a specific
    /// game — the line that matters is the one from this one.
    /// </para>
    /// </summary>
    private RenderFragment RenderPlayers() => @<text>
        @if (HasBox)
        {
            @RenderBoxScore()
        }
        else
        {
            @* Two columns, away then home as the title reads, each a stack of the side's cards; one
               column, away above home, in a narrower flow (.gameroster__cols). A roster in units
               where the sport names them (NFL): a back read under columns chosen by the side's
               defenders showed a row of dashes. *@
            <div class="gameroster__side" data-side="away">
                @foreach (var (unit, players) in Units(_matchup!.Away))
                {
                    @RenderRoster(players, Titled(_row!.Game.AwayTeam?.Name ?? "Away", unit), SideAbbrev(false))
                }
            </div>
            <div class="gameroster__side" data-side="home">
                @foreach (var (unit, players) in Units(_matchup.Home))
                {
                    @RenderRoster(players, Titled(_row!.Game.HomeTeam?.Name ?? "Home", unit), SideAbbrev(true))
                }
            </div>
        }
    </text>;

    /// <summary>The box score, a card a side: the two columns of .gameroster__cols, away first.</summary>
    private RenderFragment RenderBoxScore() => @<text>
        @if (HasBox)
        {
            <BoxScoreSide Side="_box!.Away" Team="@(_row!.Game.AwayTeam?.Name ?? "Away")" OnPlayer="OpenBoxPlayer"
                          Sport="@_row.Game.Sport?.Key" Abbrev="@SideAbbrev(false)" />
            <BoxScoreSide Side="_box.Home" Team="@(_row.Game.HomeTeam?.Name ?? "Home")" OnPlayer="OpenBoxPlayer"
                          Sport="@_row.Game.Sport?.Key" Abbrev="@SideAbbrev(true)" />
        }
    </text>;

    private RenderFragment RenderRoster(IReadOnlyList<PlayerForm> side, string teamName, string? abbrev) => @<text>
        @if (side.Count > 0)
        {
            @* The side's crest leads its rule at the large size, as the box score's does. *@
            <PanelSection>
                <TitleContent><TeamMark Sport="@_row?.Game.Sport?.Key" Abbrev="@abbrev" Size="TeamMarkSize.Large" />@teamName</TitleContent>
                <ChildContent>
                @*
                    The row opens the way every other row on the desk opens.

                    This table had its own disclosure — a bare "Last 5" key in a trailing column and
                    a second <tr> underneath — written before RowActions existed. Converting the
                    table is the moment to stop having two of those: the keys and the snippet now
                    come from the shared strip, in the widest cell, exactly as the Board does it.
                    That is the row-drilldown spec's "one interaction to learn, and it holds all the
                    way down" being cashed in rather than restated.
                *@
                <RosterTable Side="side" Class="gameplayers"
                             RowClass="@(p => _openPlayer == p.PlayerId ? "board__row--open" : null)"
                             OnRowClick="@((PlayerForm p) => TogglePlayer(p.PlayerId))">
                    <NameContent Context="player">
                        <span title="@player.Name">
                            <DeskLink Destination="player" Icon="@DeskIcons.Person"
                                      OnClick="() => Manager.OpenPlayer(player.PlayerId, player.Name, WindowId)">@player.Name</DeskLink>
                        </span>

                        @if (_openPlayer == player.PlayerId)
                        {
                            @* Keyed by the player so moving to another row is a fresh strip
                               rather than one still showing the previous player's snippet. *@
                            <RowActions @key="player.PlayerId" Actions="ActionsFor(player)" />
                        }
                    </NameContent>
                </RosterTable>
                </ChildContent>
            </PanelSection>
        }
    </text>;
}
