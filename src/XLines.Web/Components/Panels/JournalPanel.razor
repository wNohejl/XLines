@using XLines.Data
@using XLines.Ingestion.Services
@using XLines.Desk.Windowing
@inherits PanelBase
@using static XLines.Web.Components.Panels.JournalDisplay
@using XLines.Web.Services
@using XLines.Web.Windowing

@*
    The slip is a tab of the Journal, as it is of the wager window: the bets banked this session
    sit one click from the bets already logged, with the count on the tab, and no third window.

    The whole window — tabs, toolbar, ledgers, footnote — stands at a table's reading width
    (.wmeasure), centred when the window is wider. Maximised, a ledger row put "Chicago Bears −1.5"
    at one edge and its price, stake and result 700px away, and the toolbar's keys sat 900px from
    the filters they act beside; at the measure the keys end where the rows' own keys do.
*@
<div class="wmeasure journal">
<DeskTabs TValue="JournalTab" Tabs="Tabs" Label="Journal sections" Context="tab"
          Value="_tab" ValueChanged="@((JournalTab t) => _tab = t)">
@if (tab == JournalTab.Slip)
{
    <SlipPanel />
}
else
{
<PanelToolbar Message="@_message">
    <ChildContent>
        @* Status stays on the row while it fits. The toolbar folds its pickers and then its keys,
           but what stays on the row cannot fold, so at ~480px the switch, More and Place wager
           were wider than the window and Place wager was cut off at its edge. Under that width
           the switch steps off the row (xlines.css, .journal-status) and its twin below, first
           in More, takes its place: the key the window is for is never clipped. *@
        <div class="journal-status journal-status--row">
            <DeskSwitch Options="Statuses" Label="Status"
                        Value="_status" ValueChanged="@((JournalStatus s) => FilterAsync(() => _status = s))" />
        </div>
    </ChildContent>
    @* Period, sport and book are the narrower cuts; a narrow Journal folds them into More and
       keeps status and the keys on the row, then folds the keys before Place wager as well. *@
    <Overflow>
        <div class="ptoolbar__item journal-status journal-status--more">
            <span class="ptoolbar__label" aria-hidden="true">Status</span>
            <DeskSwitch Options="Statuses" Label="Status"
                        Value="_status" ValueChanged="@((JournalStatus s) => FilterAsync(() => _status = s))" />
        </div>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Placed within</span>
            <DeskSwitch Options="Periods" Label="Placed within"
                        Value="_days" ValueChanged="@((int d) => FilterAsync(() => _days = d))" />
        </div>
        @* Two leagues and "all" is a fixed set of three, so it is a segment beside the other two
           rather than a pop-up that hides the alternatives (HIG: segmented controls). *@
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Sport</span>
            <DeskSwitch Options="SportOptions" Label="Sport"
                        Value="@(_sport ?? "")" ValueChanged="@((string s) => FilterAsync(() => _sport = s is { Length: > 0 } ? s : null))" />
        </div>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Book</span>
            <DeskSelect TValue="string" aria-label="Book"
                        Value="_bookFilter" ValueChanged="@((string? b) => FilterAsync(() => _bookFilter = b))">
                <option value="">All books</option>
                <XLines.Web.Components.Snippets.BookOptions Books="_books" />
            </DeskSelect>
        </div>
    </Overflow>
    @* Secondary: the last thing to fold, into the top of More, when even the pickers there
       leave the row too wide. Place wager, the key this window is for, never leaves it. *@
    <SecondaryActions>
        @* Parlays are logged from the slip (spec §5.4), the tab beside this one. Build parlay
           fills it leg by leg, from the same wager window Place wager opens. *@
        <DeskButton Icon="@DeskIcons.Gavel" OnClick="SettleAsync" Busy="@_busy">
            Settle finished games
        </DeskButton>
        <DeskButton Icon="@DeskIcons.Link"
                    Title="Find each leg's game and add it to the slip as a parlay leg"
                    OnClick="BuildParlay">
            Build parlay
        </DeskButton>
    </SecondaryActions>
    <Actions>
        @* The same window the Board's Place wager opens, here on a game search: one form records
           a bet, whichever door it is reached by, so the door has the one name and glyph every
           window gives it (WagerKey). Tinted, not Filled: it opens a window rather than
           committing anything here. *@
        <WagerKey Kind="WagerKind.Place"
                  Title="Find the game and log the bet in the wager window"
                  OnClick="OpenWager" />
    </Actions>
</PanelToolbar>

@if (_mode == FormMode.Entry)
{
    @* The form names the row it edits on the line under its title, so "Edit entry" is about
       something before the eye reaches the fields. *@
    <PanelForm Title="Edit entry" Class="pform--grouped">
    <Detail>@(_editing is { } editing ? $"Placed {Starts(editing.PlacedAt)}" : null)</Detail>
    <ChildContent>

        @if (_editing is { IsGraded: true })
        {
            <Note>
                This entry is graded. Changing the game, market, selection, line, price, stake or book
                sends it back to pending, and settlement grades it again from the game.
            </Note>
        }

        @* The wager window's grouped form, row for row (apple-hig-components, forms.md): the
           label leads in one column, the control trails, one inset rule between rows. A typed
           price is said in the group's footer, under the rows it qualifies, rather than in a
           box of its own above them. A section card named in its bar, as the parlay form's two
           are: hand-spelled without one, the two edit forms were two shapes for one job. *@
        <FormGroup Title="Bet" GroupClass="jform" Footer="@(_entry.ManualPrice ? ManualPriceNote : null)">
            <ChildContent>
                @LegFields(_entry)

                <FormRow Label="Stake">
                    <StakeRow Stake="_entry.Stake" StakeChanged="@(s => Edit("stake", () => _entry.Stake = s))"
                              PriceAmerican="@ReadPrice(_entry.PriceTaken)"
                              Error="@(Touched("stake") ? StakeError(_entry.Stake) : null)" />
                </FormRow>
                <FormRow Label="Book">
                    @BookPicker(_entry.Book, SetEntryBookAsync)
                </FormRow>
                <FormRow Label="Note">
                    <DeskField TValue="string" Class="wfield--fill" aria-label="Note"
                               placeholder="Optional" Value="_entry.Note"
                               ValueChanged="@((string? n) => Edit("note", () => _entry.Note = n))" />
                </FormRow>
            </ChildContent>
        </FormGroup>

    </ChildContent>
    <Footer>
        @* A disabled key that does not say what it is waiting for is a key the operator
           has to guess at — and a tooltip only tells the one who hovers. The reason is text
           on the row, and the key points a screen reader at it. The row is a KeyRow: Cancel,
           the reason, Save last, and an id of its own, so two Journals never share one. *@
        <KeyRow Justify="DeskJustify.Start"
                Reason="@(EntryValid(_entry, true) ? null : "Needs a selection, a stake above zero, a price and a book.")">
            <Secondary>
                <DeskButton OnClick="CloseForm">Cancel</DeskButton>
            </Secondary>
            <Primary Context="why">
                <DeskButton Emphasis="DeskEmphasis.Filled" OnClick="SaveEntryAsync" Disabled="@(!EntryValid(_entry, true))"
                            aria-describedby="@why">
                    Save changes
                </DeskButton>
            </Primary>
        </KeyRow>
    </Footer>
    </PanelForm>
}

@if (_mode == FormMode.EditParlay && _parlay is { } edited)
{
    @* The entry form's grouped rows, for the parlay's money: one bet, so one stake, one book and
       one price, and beneath them the legs it was built from. A leg's side is the bet itself and
       is not edited here — a different side is a different parlay, logged from the slip — but
       the price it was taken at is a number, and a mistyped one is corrected like any other. *@
    <PanelForm Title="Edit parlay" Class="pform--grouped">
    <Detail>@($"{edited.Parlay.Legs.Count} legs, placed {Starts(edited.Parlay.PlacedAt)}")</Detail>
    <ChildContent>

        @if (edited.Parlay.IsGraded)
        {
            <Note>
                This parlay is graded. Changing the stake, the book's price, a leg's price or the book
                sends it back to pending, and settlement grades it again from its legs.
            </Note>
        }

        @* Two section cards: the parlay's money, then its legs, each named in the bar at its top
           (the Desk's grouping contract). A group sitting loose in the column beside a section is
           a group with no name; a name floating above a group is a name attached to nothing.
           They flow, so a form wider than two tracks would set them side by side. *@
        <div class="wflow">
            <FormGroup Title="Parlay" GroupClass="jform">
                <ChildContent>
                    <FormRow Label="Book">
                        @BookPicker(edited.Book, SetParlayBookAsync)
                    </FormRow>
                    <FormRow Label="Stake">
                        <StakeRow Stake="edited.Stake" StakeChanged="@(s => Edit("stake", () => edited.Stake = s))"
                                  PriceAmerican="@CombinedPrice(edited)"
                                  Error="@(Touched("stake") ? StakeError(edited.Stake) : null)" />
                    </FormRow>
                    <FormRow>
                        <LabelContent>Book's price<span class="wbet__echo">@DecimalEcho(edited.PriceQuoted)</span></LabelContent>
                        <ChildContent>
                        @* The book's own price for the parlay, when it gave one: what a clean win pays.
                           Without it the legs' prices are multiplied, as the slip does. To the cent,
                           or decimal odds, read as the American price the label says back. *@
                        <DeskField TValue="decimal?" Mono="true" Class="wfield--short" type="number" step="any"
                                   aria-label="The book's price for the parlay" placeholder="Optional"
                                   Value="edited.PriceQuoted"
                                   ValueChanged="@((decimal? q) => Edit("quoted", () => edited.PriceQuoted = q))"
                                   Error="@(Touched("quoted") && edited.PriceQuoted is { } quoted ? PriceError(quoted) : null)" />
                        </ChildContent>
                    </FormRow>
                    <FormRow Label="Note">
                        <DeskField TValue="string" Class="wfield--fill" aria-label="Note"
                                   placeholder="Optional" Value="edited.Note"
                                   ValueChanged="@((string? n) => Edit("note", () => edited.Note = n))" />
                    </FormRow>
                </ChildContent>
            </FormGroup>

            @* No count on the bar: the form's detail line already says how many legs. *@
            <FormGroup Title="Legs" GroupClass="jform">
                <ChildContent>
                    @foreach (var (leg, n) in edited.Parlay.Legs.OrderBy(l => l.Id).Select((l, i) => (l, i + 1)))
                    {
                        var field = $"leg-{leg.Id}";
                        <FormRow Label="@($"Leg {n}")" @key="leg.Id">
                            <DeskRow Justify="DeskJustify.Between">
                                <div>
                                    <div>@Describe(leg)</div>
                                    @if (leg.Game is not null)
                                    {
                                        <div class="meta">@MatchupWithDate(leg.Game)</div>
                                    }
                                    <span class="wbet__echo">@DecimalEcho(edited.LegPrices.GetValueOrDefault(leg.Id))</span>
                                </div>
                                <DeskField TValue="decimal?" Mono="true" Class="wfield--short" type="number" step="any"
                                           aria-label="@($"Price taken on {Describe(leg)}")" placeholder="-110"
                                           Value="@edited.LegPrices.GetValueOrDefault(leg.Id)"
                                           ValueChanged="@((decimal? p) => Edit(field, () => edited.LegPrices[leg.Id] = p))"
                                           Error="@(Touched(field) ? LegPriceError(edited.LegPrices.GetValueOrDefault(leg.Id), leg.PriceTaken) : null)" />
                            </DeskRow>
                        </FormRow>
                    }
                </ChildContent>
                <Footer>
                    The price each leg was taken at. Without the book's price, settlement multiplies
                    them, and after a push it reprices the parlay on the legs that are left.
                </Footer>
            </FormGroup>
        </div>

    </ChildContent>
    <Footer>
        <KeyRow Justify="DeskJustify.Start" Reason="@ParlayWaiting(edited)">
            <Secondary>
                <DeskButton OnClick="CloseForm">Cancel</DeskButton>
            </Secondary>
            <Primary Context="why">
                <DeskButton Emphasis="DeskEmphasis.Filled" OnClick="SaveParlayChangesAsync" Disabled="@(ParlayWaiting(edited) is not null)"
                            aria-describedby="@why">
                    Save changes
                </DeskButton>
            </Primary>
        </KeyRow>
    </Footer>
    </PanelForm>
}

@if (Failed)
{
    <PanelLoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (!Loaded)
{
    @if (!Failed)
    {
        <DeskGrid T="JournalEntry" Items="_entries" Loading="true" LoadingLabel="Fetching the journal" />
    }
}
else if (_entries.Count == 0 && _parlays.Count == 0)
{
    <EmptyState Kind="@(Filtered ? EmptyStateKind.Filtered : EmptyStateKind.New)">
        @(Filtered
            ? "No entries match these filters."
            : "No entries logged yet. Place wager finds the game and records the bet; Build parlay adds legs to the slip, where the parlay is logged.")
    </EmptyState>
}

@* The two ledgers are section cards (the Desk's grouping contract): each table inside a card
   named in the bar at its top, so Straight bets and Parlays read as two things with an edge
   between them rather than two rules over one run of rows. A table is wide, so each card takes
   the flow's whole row; the table draws no second frame inside it (JournalPanel.razor.css). *@
@if (_entries.Count > 0 || _parlays.Count > 0)
{
<div class="wflow journal-lists">
@if (_entries.Count > 0)
{
    @* "Straight bets", the counterpart of Parlays below: under a tab called Entries, a first
       section called Entries named the tab a second time and told the reader nothing new. *@
    <FormGroup Title="Straight bets" Span="DeskCardSpan.Row" GroupClass="journal-list">
    <ChildContent>
    <DeskGrid T="JournalEntry" Items="_entries" EmptyText="No entries logged yet.">
        @* Ordered by when the bet closes — the game's start, when the line closes and CLV is read —
           newest first, as the service reads it: a bet placed days ahead on
           a later game sits above one placed tonight. The placement is the dim second line; the
           Placed within filter still cuts by it. *@
        <DeskTemplateColumn T="JournalEntry" Title="Closes" Sortable="true" SortBy="@(e => JournalService.GameStart(e))"
                        InitialDirection="SortDirection.Descending" HeaderClass="ops-col--fit" CellClass="ops-col--fit">
            <CellTemplate>
                @* An untracked bet has no game to start; its game start falls back to the placement,
                   which would print the same time twice. It says so instead, dim like the line under it. *@
                <div class="journal-when">
                    @if (context.Item.GameId is null)
                    {
                        <span class="dim">No game</span>
                    }
                    else
                    {
                        @Starts(JournalService.GameStart(context.Item))
                    }
                    <div class="dim">placed @Starts(context.Item.PlacedAt)</div>
                </div>
            </CellTemplate>
        </DeskTemplateColumn>

        @* The selection is the row's sentence and takes the width the figures leave; every other
           column is a value held on one line (xlines.css, "Columns in the operations and
           analytics windows"). *@
        <DeskColumn T="JournalEntry" TProperty="string" Property="e => e.Outcome" Title="Selection"
                        HeaderClass="ops-col--grow" CellClass="ops-col--grow">
            <CellTemplate>
                @Selection(context.Item)
                @if (context.Item.Note is { } note)
                {
                    <div class="meta">@note</div>
                }
            </CellTemplate>
        </DeskColumn>

        @* Market and Book fold away under 820px with CLV: at the Journal's usual width the figures
           and the selection fill the window, and the selection already says the side. *@
        <DeskColumn T="JournalEntry" TProperty="string" Property="e => e.Market" Title="Market" HeaderClass="col--wider ops-col--fit" CellClass="col--wider ops-col--fit">
            <CellTemplate><span class="dim">@SelectionText.MarketName(context.Item.Market)</span></CellTemplate>
        </DeskColumn>

        <DeskColumn T="JournalEntry" TProperty="string" Property="e => e.Book" Title="Book" HeaderClass="col--wider ops-col--fit" CellClass="col--wider ops-col--fit">
            <CellTemplate><span class="dim">@BookNames.Display(context.Item.Book)</span></CellTemplate>
        </DeskColumn>

        <DeskColumn T="JournalEntry" TProperty="decimal" Property="e => e.PriceTaken" Title="Price" Align="Align.Right">
            <CellTemplate>
                @* Said where the number is: a typed price is the operator's word, not an observation. *@
                @if (context.Item.ManualPrice)
                {
                    <DeskTooltip Text="Entered by hand, not fetched">
                        <span class="dim journal-manual" tabindex="0">manual</span>
                    </DeskTooltip>
                }
                @Price(context.Item.PriceTaken)
            </CellTemplate>
        </DeskColumn>

        <DeskColumn T="JournalEntry" TProperty="decimal" Property="e => e.Stake" Title="Stake" Align="Align.Right"
                        HeaderClass="ops-col--fit" CellClass="ops-col--fit">
            <CellTemplate>@OddsMath.Money(context.Item.Stake)</CellTemplate>
        </DeskColumn>

        <DeskColumn T="JournalEntry" TProperty="EntryResult" Property="e => e.Result" Title="Result"
                        HeaderClass="ops-col--fit" CellClass="ops-col--fit">
            <CellTemplate><Tag State="@ResultState(context.Item.Result)">@context.Item.Result</Tag></CellTemplate>
        </DeskColumn>

        <DeskColumn T="JournalEntry" TProperty="decimal" Property="e => e.NetReturn" Title="Net" Align="Align.Right"
                        HeaderClass="ops-col--fit" CellClass="ops-col--fit">
            <CellTemplate>
                <span class="@(context.Item.NetReturn > 0 ? "up" : context.Item.NetReturn < 0 ? "down" : null)">
                    @* Performance's signed money, so a loss reads "−$20" in both windows: "C0"
                       follows the machine's region, and on this one printed "($20)". *@
                    @(context.Item.IsSettled ? PerformancePanel.SignedToTheCent(context.Item.NetReturn) : "—")
                </span>
            </CellTemplate>
        </DeskColumn>

        @* Sorts on the reading itself, so "worst CLV" is a click; an unresolved entry sorts below
           every real one rather than as zero. A template column because the key is computed. *@
        <DeskTemplateColumn T="JournalEntry" Sortable="true" Title="CLV" HeaderClass="col--wider ops-col--fit" CellClass="col--wider ops-col--fit" Align="Align.Right"
                        SortBy="@(e => Clv(e)?.CentsPercent ?? double.MinValue)">
            <CellTemplate>@ClvCell(context.Item)</CellTemplate>
        </DeskTemplateColumn>

        <DeskTemplateColumn T="JournalEntry" Title="" Sortable="false" Align="Align.Right"
                        HeaderClass="ops-col--fit" CellClass="ops-col--fit">
            <CellTemplate>
                <DeskRow Justify="DeskJustify.End" Gap="DeskSpace.Space1">
                    @* Graded rows are done; a void stays open to a correction, because an automatic
                       void is the common rule and a given book may have ruled otherwise.
                       Settling commits a result, so it is a pull-down of commands, not a pop-up
                       of values that acted on change and snapped back to its placeholder. *@
                    @if (!context.Item.IsGraded)
                    {
                        <DeskPullDown Label="Settle" Emphasis="DeskEmphasis.Plain" Size="DeskKeySize.Small" Align="DeskPopoverAlign.End">
                            <DeskMenuItem Label="Win" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Win))" />
                            <DeskMenuItem Label="Loss" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Loss))" />
                            <DeskMenuItem Label="Push" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Push))" />
                            <DeskMenuItem Label="Void" OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Void))" />
                        </DeskPullDown>
                    }
                    @* Edit, Duplicate and Delete are one Actions menu (HIG 14): three icon keys a
                       row, named only by titles, read as a toolbar on every row. Delete is the
                       destructive item, and its alert still confirms. Duplicate is the same door
                       the wager window's own uses: a new wager window on this bet, ready to log
                       at today's price — or at the typed one, if it was. *@
                    <DeskPullDown Label="Actions" Icon="@DeskIcons.MoreHoriz" Emphasis="DeskEmphasis.Plain"
                                  Size="DeskKeySize.Small" Align="DeskPopoverAlign.End">
                        <DeskMenuItem Label="Edit" OnClick="() => EditEntry(context.Item)" />
                        @* A graded row has no Settle menu, so a result picked by mistake had no way
                           back (HIG, Undo). Pending clears it; settlement grades it again from the
                           game, or Settle is offered once more for a bet it cannot grade. *@
                        @if (context.Item.IsGraded)
                        {
                            <DeskMenuItem Label="Back to pending" Description="Clears the result to settle it again"
                                          OnClick="@(() => SetResultAsync(context.Item.Id, EntryResult.Pending))" />
                        }
                        <DeskMenuItem Label="Duplicate" Description="In a wager window, to log again"
                                      OnClick="() => Duplicate(context.Item)" />
                        <DeskMenuItem Label="Delete…" Destructive="true" OnClick="() => DeleteEntryAsync(context.Item)" />
                    </DeskPullDown>
                </DeskRow>
            </CellTemplate>
        </DeskTemplateColumn>
    </DeskGrid>
    </ChildContent>
    <Notice>
        @* Market, Book and CLV are .col--wider: under 820px of grid they fold away. *@
        <p class="wgroup__foot journal-folded">Market, book and CLV are hidden at this width. Widen the window to see them.</p>
    </Notice>
    </FormGroup>
}

@if (_parlays.Count > 0)
{
    @* The parlays ledger, its own component (JournalParlays): it draws the rows and hands each
       row's key back here, where the journal's state and writes are. *@
    <JournalParlays Parlays="_parlays" Selection="Selection" ClvCell="ClvCell"
                    OnSettle="@((JournalParlays.Settlement s) => SetParlayResultAsync(s.Parlay, s.Result))"
                    OnEdit="EditParlay" OnDuplicate="DuplicateParlayAsync" OnDelete="DeleteParlayAsync" />
}
</div>
}

@if (_entries.Count >= _take || _parlays.Count >= _take)
{
    <DeskRow>
        <DeskButton OnClick="ShowMoreAsync">Show @Step more</DeskButton>
    </DeskRow>
}

@* What the Journal is, said once at its foot in the footnote voice, as the Slip tab says it.
   It used to be a filled note under the toolbar, wider than the form beneath it, and every
   form opened between the two read as a stack of boxes of three widths. *@
<p class="wfoot journal-foot">
    XLines does not place wagers and has no connection to any sportsbook. Entries here are
    records of bets already placed elsewhere.
</p>
}
</DeskTabs>
</div>

@code {
    // The Razor templates the markup draws; the rest of the component is in JournalPanel.razor.cs
    // (state, loading), JournalPanel.Editing.cs (the edit forms) and JournalPanel.Actions.cs.

    /// <summary>The Bet card's footer while the price is the operator's; no footer otherwise, so no empty line.</summary>
    private static readonly RenderFragment ManualPriceNote =
        @<span class="journal-manual-note">You typed this price; the desk did not fetch it.</span>;

    private RenderFragment LegFields(Draft d) => @<text>
        <FormRow Label="Game">
            <GamePicker Value="d.GameId" Selected="d.Game"
                        SelectedChanged="@((Game? g) => Edit("game", () => d.Game = g))"
                        ValueChanged="@((int? id) => Edit("game", () => d.GameId = id))" />
        </FormRow>

        <FormRow Label="Market">
            <DeskSelect TValue="string" Value="d.Market" Class="wfield--short" aria-label="Market"
                        ValueChanged="@((string? m) => Edit("market", () => d.Market = m ?? Markets.Spread))">
                <option value="@Markets.Moneyline">Moneyline</option>
                <option value="@Markets.Spread">Spread</option>
                <option value="@Markets.Total">Total</option>
                <option value="@FreeText">Other (describe)</option>
            </DeskSelect>
        </FormRow>

        <FormRow Label="@(d.Market == FreeText ? "Bet" : "Selection")">
            @if (d.Market == FreeText)
            {
                <DeskField TValue="string" Class="wfield--fill" aria-label="The bet"
                           placeholder="e.g. Player X over 1.5 receiving TDs" Value="d.FreeTextMarket"
                           ValueChanged="@((string? t) => Edit("bet", () => d.FreeTextMarket = t))" />
            }
            else if (d.Market == Markets.Total)
            {
                @* A total is over or under; there is nothing else to type. *@
                <DeskSwitch TValue="string" Options="TotalSides" Label="Selection" Size="DeskKeySize.Small"
                            Value="d.Outcome" ValueChanged="@((string o) => Edit("selection", () => d.Outcome = o))" />
            }
            else if (d.GameId is not null && TeamSides(d.Game) is not null)
            {
                @* On a tracked game the side is one of two teams the desk already knows, away
                   then home as the scoreboard reads; the value is the team's name, which is what
                   settlement matches against. *@
                <DeskSwitch TValue="string" Options="@TeamSides(d.Game)" Label="Selection" Size="DeskKeySize.Small"
                            Value="d.Outcome" ValueChanged="@((string o) => Edit("selection", () => d.Outcome = o))" />
            }
            else
            {
                <DeskField TValue="string" Class="wfield--short" aria-label="Selection"
                           placeholder="Team"
                           Value="d.Outcome"
                           ValueChanged="@((string? o) => Edit("selection", () => d.Outcome = o ?? string.Empty))" />
            }
        </FormRow>

        @if (d.Market is Markets.Spread or Markets.Total)
        {
            <FormRow Label="Line">
                <DeskField TValue="decimal?" Mono="true" Class="wfield--short" type="number" step="0.5"
                           aria-label="Line" placeholder="-3" Value="d.LineTaken"
                           ValueChanged="@((decimal? l) => Edit("line", () => d.LineTaken = l))"
                           Error="@(Touched("line") ? LineError(d.Market, d.LineTaken) : null)" />
            </FormRow>
        }

        @* To the cent, or decimal odds, read as the American price the label says back, as the
           wager window and the slip read them. *@
        <FormRow>
            <LabelContent>Price<span class="wbet__echo">@DecimalEcho(d.PriceTaken)</span></LabelContent>
            <ChildContent>
            <DeskField TValue="decimal" Mono="true" Class="wfield--short" type="number" step="any"
                       aria-label="Price" placeholder="-110" Value="d.PriceTaken"
                       ValueChanged="@((decimal p) => Edit("price", () => d.PriceTaken = p))"
                       Error="@(Touched("price") ? PriceError(d.PriceTaken) : null)" />
            </ChildContent>
        </FormRow>
    </text>;

    private RenderFragment BookPicker(string current, Func<string, Task> set) => @<text>
        <DeskSelect TValue="string" Class="wfield--short" aria-label="Book" Value="current"
                    ValueChanged="@(async (string? b) => await set(b ?? string.Empty))">
            <option value="">Book…</option>
            <XLines.Web.Components.Snippets.BookOptions Books="_books" />
        </DeskSelect>
    </text>;

    private RenderFragment Selection(JournalEntry e) => @<text>
        @if (!string.IsNullOrWhiteSpace(e.FreeTextMarket))
        {
            @e.FreeTextMarket
        }
        else if (e.GameId is { } gameId)
        {
            @* An entry against a tracked game reaches its market. The club it backs leads with its
               crest, decorative beside the name that says who it is. *@
            <DeskLink Destination="game" OnClick="() => OpenGameAsync(gameId)">
                @if (SelectedClub(e) is { } club)
                {
                    <TeamMark Sport="@e.Game!.Sport?.Key" Abbrev="@club.Abbrev" Size="TeamMarkSize.Small" />
                }
                @e.Outcome
                @if (e.LineTaken is { } l)
                {
                    @* The space is part of the expression: Razor drops a whitespace-only text node,
                       and "Buffalo Bills-3.00" ran the team into its line. *@
                    <span class="dim num">@(" " + Line(l))</span>
                }
            </DeskLink>
        }
        else
        {
            @e.Outcome
            @if (e.LineTaken is { } l)
            {
                <span class="dim num">@(" " + Line(l))</span>
            }
        }
    </text>;

    private RenderFragment ClvCell(JournalEntry e) => @<text>
        @if (Clv(e) is { } clv)
        {
            @* When the line moved, the points are the reading; the two prices are for different
               numbers and their difference means nothing on its own. The close it was measured
               against is a tooltip on a focusable figure, not a title: a title never reaches the
               keyboard (HIG 12), and the figure keeps its own text as its name. *@
            <DeskTooltip Text="@ClvTitle(e)">
                <span class="journal-clv @(clv.BeatClose ? "up" : "down")" tabindex="0">
                    @OddsText.Clv(clv)
                </span>
            </DeskTooltip>
        }
        else
        {
            <span class="dim">—</span>
        }
    </text>;
}
