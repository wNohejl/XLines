@using XLines.Core.Analytics
@using XLines.Data
@using XLines.Data.CrossReference
@using XLines.Ingestion.Configuration
@using XLines.Ingestion.Services
@using XLines.Desk.Primitives
@using XLines.Web.Components.Snippets
@using XLines.Desk.Windowing
@using XLines.Web.Services
@using Microsoft.Extensions.Options
@inherits PanelBase

@*
    The board — the one games surface.

    It used to be two. A "Slate" listed the day and could pull data; the board showed the market
    and could not. That is the wrong split in both directions: a list of games with no way to
    fetch new ones is something to look at rather than work from, and the surface an operator
    would actually act on was the one that could not fix its own stale data. So the pull menu
    lives here, beside the rows it changes, and noticing a gap and closing it are one screen.

    Every game in the window, with the best number on each market and the book holding it. A
    game in play keeps its closing line rather than going blank, and a played one carries its
    score. Open a row and its actions appear on it — a glance at the odds, the head-to-head, the
    form, and the two destinations worth a window. Each adds a window to the desk while there is
    room and floats above it once there is not, so following one up never costs the board an
    operator is working from.
*@

@* Every scope picker can leave the row: a narrow Board keeps one line by folding them into
   More, each with the label it shows there, while the search and the keys stay put (HIG
   toolbars: say in advance what overflows). *@
<PanelToolbar>
    <Overflow>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Sport</span>
            <DeskSelect TValue="string" aria-label="Sport" Value="_sport" ValueChanged="OnSportChanged">
                @* Requested leagues, not merely the ones with games. A league the desk was told to poll
                   and has nothing for is a different fact from a league nobody asked about, and the
                   option says which — see ADR 0003 on the two kinds of zero. *@
                <option value="">All sports@(_rows.Count > 0 ? $" · {_rows.Count}" : "")</option>
                @foreach (var option in _sportOptions)
                {
                    <option value="@option.Key">@option.Label</option>
                }
            </DeskSelect>
        </div>

        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Horizon</span>
            <DeskSwitch Options="Horizons" Label="Slate horizon" Mono="true"
                        Value="_windowHours" ValueChanged="@((int hours) => SetWindowAsync(hours))" />
        </div>

        @* Only offered once there is something to narrow. A gate with every position pointing at
           the same rows is chrome pretending to be a control. *@
        @if (_phaseOptions.Count > 1)
        {
            <div class="ptoolbar__item">
                <span class="ptoolbar__label" aria-hidden="true">State</span>
                <DeskSwitch Options="_phaseOptions" Label="Game state"
                            Value="_phase" ValueChanged="@((BoardPhase p) => SetPhase(p))" />
            </div>
        }

        @* The games where some book is paying more than the fair price — a checkbox, and drawn
           only while there are any, for the same reason the state switch is. The row is drawn
           with it, so More never shows a label with nothing beside it. *@
        @if (_valueRows > 0)
        {
            <div class="ptoolbar__item">
                <span class="ptoolbar__label" aria-hidden="true">Value</span>
                <BoardValueFilter Count="_valueRows" Checked="_valueOnly" CheckedChanged="@((bool _) => ToggleValue())" />
            </div>
        }
    </Overflow>
    @* Narrows the slate to a team or a matchup — "mets", "reds braves" — by the same rule the
       command palette finds games with. The slate is already loaded, so this asks nothing. Last
       in the content group, nearest the keys (HIG: search trails), and the last thing to fold. *@
    <Search>
        <DeskSearch Placeholder="Search teams" Label="Search teams or matchups"
                    Value="@_team" ValueChanged="@((string t) => SetTeam(t))" />
    </Search>
    @* The keys are the toolbar's actions slot, not more content after a spacer: the slot keeps
       them together and flush right as the window narrows, where a spacer let Pull data wrap
       to a line of its own and leave Refresh behind. *@
    <Actions>
        @* No Refresh key here: every window's bar carries one (AppWindow), and it reloads the
           Board as this toolbar's own used to. *@

        @* One of the two keys here that spend (Date range is the other), and a menu, so Tinted with
           a chevron rather than Filled: the spend is the entry chosen from it. The rest of this
           toolbar reads. *@
        <DeskJobMenu @ref="_pull" Label="Pull data" Icon="@DeskIcons.CloudDownload" OnRan="LoadAsync" OnBusyChanged="OnPullBusy" />

        @* A range of days is its own task, so its own key: a popover anchored here asks the league
           and the days, and the pull runs on this key, busy with the day it has reached. Tinted,
           as Pull data is — the spend is the popover's Pull. Operators only; the key says so too. *@
        @if (Manager.Access.CanOperate)
        {
            <RangePullKey Leagues="Ranges.LeaguesAsync" Pull="Ranges.RunAsync"
                          InitialLeague="@(_sport.Length == 0 ? null : _sport)"
                          OnRan="LoadAsync" OnBusyChanged="OnPullBusy" />
        }
    </Actions>
</PanelToolbar>

@* Anatomy order (spec 2026-10-24): toolbar, note, metrics. The two notes share a line where
   the Board has room for both (.board__banners): stacked, the Line watch line and the gap's
   sentence were two full-width bands above the tiles, and a short Board showed two games. *@
@if (Watching || (Visible.Count > 0 && _unpriced > 0))
{
<div class="board__banners">
@if (Watching)
{
    @* Line watch changes what a press here does (ADR 0029), so the Board says so, in words on the
       page rather than a title a pointer has to find. One line, so the slate starts where it
       always does: the first clause is the disclosure's label, the rest a press (or Enter) away. *@
    <Note State="DeskState.Info">
        <DeskDisclosure Label="@LineWatch.BoardHint">
            @LineWatch.BoardHintMore
        </DeskDisclosure>
    </Note>
}
@if (Visible.Count > 0 && _unpriced > 0)
{
    <Note State="DeskState.Warning">
        @_unpriced of @_rows.Count fixtures have no price at all.
        @* One reason for the whole gap is stated here, since it is the same fact thirteen
           times over; only a mix sends the reader row by row. *@
        @if (SharedGap is { } why)
        {
            @why
        }
        else
        {
            @:Open a row to see why — a gap is usually a fixture the scan did not cover, not a broken feed.
        }
    </Note>
}
</div>
}

@*
    The strip the Slate brought with it, minus the figures that were only ever ops trivia.

    "Games in the database" and "price moves, all time" answer a question about the platform
    rather than about tonight; they belong on Ops beside the run log. What earns a place here is
    what changes a decision on this screen: how much of the board is priced, whether the market
    has moved at all today, and whether anything is currently saying the data may be lying.

    Drawn once the board has loaded: before that every tile reads zero, which is a claim about
    tonight the desk has not checked.
*@
@if (Loaded)
{
@* Compact (.board__metrics): the figure and its label on one line, the note under them, so the
   tiles are one short row a Board wraps by its own width rather than five 90px boxes. *@
<MetricRow Class="board__metrics">
    <Metric Label="Games" Value='@_rows.Count.ToString("N0")' Note="@HorizonNote"
            State="DeskState.Info" Numeric />

    <Metric Label="Priced" Note="@CoverageNote" State="@CoverageState" Numeric>
        @_priced.ToString("N0")<span class="dim"> / @_rows.Count</span>
    </Metric>

    @* Store-on-change (ADR 0001): a price that has not moved is not written, so this counts
       market activity rather than polls. Zero on a busy slate is a fact worth seeing. *@
    @* The direct count of the main sportsbooks over the games in view (ADR 0033, addendum
       2026-11-27): the five the owner bets at against the ones that priced something here, with the
       missing ones and why, where the desk knows, in the note. *@
    <Metric Label="Main sportsbooks" Value="@_main.Figure" Note="@MainNote" State="@MainState" Numeric />

    <Metric Label="Moves today" Value='@_movesToday.ToString("N0")' Note="@MovesNote" Numeric />

    @* The count is the way in. A tile that only says "2" leaves the reader to find the window
       that lists them, which the desk already knows — so the tile opens it. *@
    <Metric Label="Open alerts"
            Value="@_alerts.ToString()"
            Note="@AlertNote"
            State="@AlertState"
            Numeric
            OnClick="@(_alerts > 0 ? EventCallback.Factory.Create(this, Manager.OpenOps) : default)"
            ActionHint="Open the Ops window on source health and the open alerts" />
</MetricRow>
}

@if (Failed)
{
    <PanelLoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (!Loaded)
{
    @* Before the first load the board holds its rows' shape; "Nothing on the board" is a
       finding, and there is nothing to find it from yet. *@
    @if (!Failed)
    {
        <DeskGrid T="BoardRow" Items="_rows" Loading="true" LoadingLabel="Fetching the board" />
    }
}
else if (_rows.Count == 0)
{
    <BoardEmptyState Port="Port" OnPull="PullAsync" />
}
else if (Visible.Count == 0)
{
    <EmptyState Kind="EmptyStateKind.Filtered">
        <ChildContent>
            No @PhaseWord games on this board. The window holds @_rows.Count others.
        </ChildContent>
        <Action>
            <DeskButton Size="DeskKeySize.Small"
                        Icon="@DeskIcons.FilterAltOff"
                        OnClick="() => SetPhase(BoardPhase.Any)">
                Show every game
            </DeskButton>
        </Action>
    </EmptyState>
}
else
{
    <div class="board__table">
    <DeskGrid T="BoardRow" Items="Visible" Class="deskgrid--clickable deskgrid--board"
              RowClassFunc="@((r, _) => RowClass(r))"
              OnRowClick="@(e => Toggle(e.Item))"
              ChildRow="@(r => _open?.Game.Id == r.Game.Id ? OpenRow(r) : null)"
              ChildRowIndent="1"
              EmptyText="@(string.IsNullOrWhiteSpace(_team) ? "No games in this window." : $"No game in this window matches \"{_team}\".")">

        <DeskTemplateColumn T="BoardRow" Sortable="true" Title="Starts" SortBy="@(r => r.Game.StartsAt)">
            <CellTemplate>
                @* The time on the away line and the league under it on the home line, each on its
                   own terms: the time in the cell's ink, the league a caption in secondary. Joined
                   by a middot they were one run of grey that wrapped at the dot in a narrow Board,
                   leaving "· NBA" to start the second line. Which league is said only while the
                   board is showing more than one. *@
                @* The day and the clock are two spans of one reading, a space apart: one line in a
                   wide Board, the day over the clock in a narrow one (.board__date, xlines.css),
                   where "Nov 26 13:00 ET" on one line was the widest thing in the column. *@
                <span class="board__when">
                    <span class="board__time num"><span class="board__date">@DisplayTime.Day(context.Item.Game.StartsAt)</span> <span class="board__clock">@StartClock(context.Item.Game.StartsAt)</span></span>
                    @if (_sport.Length == 0 && context.Item.Game.Sport is { } sport)
                    {
                        <span class="board__league">@sport.Key.ToUpperInvariant()</span>
                    }
                </span>
            </CellTemplate>
        </DeskTemplateColumn>

        @*
            The matchup is where the open row's line starts.

            The row's actions belong on the row rather than in a menu or a detail pane — the
            operator has just decided *this game* is interesting and the next move should be one
            press away. They are not in this cell, though: they are the first line of the row the
            grid opens under the game (OpenRow), starting at this column's edge. Wedged under the
            team chips, in a column 140–200px wide, the glances, More bets and Place wager wrapped
            into three stacked lines of keys, tight on each other and on the row, and a press a few
            pixels off a key landed on the game row — whose click is the toggle — and closed it.
            In a row of their own they sit on one line at the toolbar's spacing, the answer a key
            opens draws beneath them, and the whole of that row is theirs. Closed rows still lose
            no width, and only the open row changes height.

            The matchup is two lines, away over home as the Game window's scoreboard reads, each
            the club's crest, its nickname and its starter in secondary ink: the probable pitcher
            MLB names, or the quarterback an NFL club started its last game with — unless the
            injury report has him out, when it is the passer who started without him, and the
            link's tooltip carries the injury ("Kyler Murray is out; Carson Wentz started the
            club's last game without him"), or a dash when nobody has thrown in his place. The
            clubs were capsule chips side by side, which made each club an object when all it had
            was a nickname; the crest now does that, and a fill behind every name was a second
            shape saying the same thing. Stacked, the two lines sit level with the score's two
            lines beside them, and the starters share one left edge. The full names stay on the
            link's tooltip, and a hidden "at" keeps the link reading "Brewers at Rays". When a
            game is final the loser drops to secondary ink, as its score does beside it.
        *@
        <DeskTemplateColumn T="BoardRow" Sortable="true" Title="Matchup" SortBy="@(r => r.Game.HomeTeam!.Name)">
            <CellTemplate>
                @{ var leader = BoardCells.FinalLeader(context.Item.Game); }
                <DeskLink Destination="game" Class="board__matchup-link" Tooltip="@MatchupTooltip(context.Item)"
                          OnClick="() => Manager.OpenGame(context.Item.Game)">
                    <span class="board__sides">
                        @if (context.Item.Bout is not null)
                        {
                            @* A fight is billed red corner first, as its moneyline reads (ADR 0021). *@
                            @Side(context.Item, home: true, loser: leader == ScoreLeader.Away)
                            <span class="sr-only">@(" vs ")</span>
                            @Side(context.Item, home: false, loser: leader == ScoreLeader.Home)
                        }
                        else
                        {
                            @Side(context.Item, home: false, loser: leader == ScoreLeader.Home)
                            <span class="sr-only">@(" at ")</span>
                            @Side(context.Item, home: true, loser: leader == ScoreLeader.Away)
                        }
                    </span>
                </DeskLink>
                @{
                    var doubleHeader = context.Item.Game.DoubleHeaderGame;
                    var billed = context.Item.Bout is { } b && (b.MatchNumber == 1 || b.TitleFight) ? context.Item.Bout : null;
                    var unpriced = context.Item.Unpriced;
                }
                @* What qualifies the game — which of a doubleheader, the bout a card is sold on, that
                   it has no price — is one quiet line under the two clubs, started at the nicknames'
                   edge rather than under the crests, so the cell reads as the matchup and its
                   footnote. Not drawn at all for a game with nothing to add. *@
                @if (doubleHeader is not null || billed is not null || unpriced is not null)
                {
                    <div class="board__notes@(FightSports.IsFight(context.Item.Game.Sport?.Key) ? "" : " board__notes--inset")">
                        @if (doubleHeader is { } number)
                        {
                            <Tag State="DeskState.Info">Game @number</Tag>
                        }
                        @if (billed is { } card)
                        {
                            @* The bouts a card is sold on say so; the rest of the card is its order. *@
                            <Tag State="DeskState.Info">@(card.TitleFight ? "Title" : "Main event") · @(FightSports.CardName(card))</Tag>
                        }

                        @* The row says only that it has no price, in secondary ink. The reason is the
                           banner's when every unpriced row shares it — thirteen orange copies of "No lines
                           pulled in 2 days" under thirteen matchups said one fact thirteen times. When the
                           reasons differ the banner says to open a row, so the open row gives its own.
                           No title: the reason is always in visible text, on the banner or the open row,
                           and a title on text that takes no focus reaches only a pointer (HIG 12). *@
                        @if (unpriced is { } reason)
                        {
                            <span class="board__gap">
                                No price@(PolledWhy(context.Item))@(SharedGap is null && _open?.Game.Id == context.Item.Game.Id ? $" · {reason}" : "")
                            </span>
                        }
                    </div>
                }

            </CellTemplate>
        </DeskTemplateColumn>

        @*
            Score and state, in one column.

            They are the same fact at two resolutions — a game is final *and* it is 3–5 — and
            two columns to say it would cost width the six market cells need more. The score
            itself takes no hue: on this desk hue reports the state of your own position
            (ADR 0008), so colouring a losing side negative would be a second vocabulary in the
            same table. The tag beside it carries the state, in a word.
        *@
        <DeskTemplateColumn T="BoardRow" Sortable="true" Title="Score" SortBy="@(r => (int)r.Game.Status)">
            <CellTemplate>
                <BoardScoreCell Row="context.Item" />
            </CellTemplate>
        </DeskTemplateColumn>

        @* The row's best bet against the fair price, and the column the board sorts by when the
           question is where the value is. Read across every book, so it can name a book that
           holds no cell's best price; a close has nothing left to take and reads as a dash. *@
        <DeskTemplateColumn T="BoardRow" Sortable="true" Title="Value" Align="Align.Right"
                        SortBy="@(r => r.BestEv ?? double.MinValue)">
            <CellTemplate>
                <BoardValueCell Row="context.Item" />
            </CellTemplate>
        </DeskTemplateColumn>

        @* Home/over first in every market, so a column reads down consistently. StartsAt goes
           with each price so a closing one can say how long before first pitch it was taken.

           Each market is two columns and one heading. Headed "Moneyline, Moneyline, Spread,
           Spread, Over, Under", the row of labels said every market twice and named the total by
           its sides. The first column of a pair (.board__pair) carries the market's name, drawn
           centred over both columns; the second shows nothing, since every cell already names
           its side (PHI, DAL; a total's line, o47.5 and u47.5, which names it). Each header still has a name of its own for a screen
           reader — "Moneyline, home", "Moneyline, away" — so no column is unlabelled. *@
        <DeskTemplateColumn T="BoardRow" Title="Moneyline, home" Align="Align.Right" Sortable="false"
                        HeaderClass="board__ml board__pair" CellClass="board__ml board__pair">
            <HeaderTemplate>@MarketHeader("Moneyline", "home")</HeaderTemplate>
            <CellTemplate>
                <PriceCell Offer="context.Item.Moneyline.First" Selection="@Side(context.Item, true)"
                           StartsAt="context.Item.Game.StartsAt" Polled="_polled"
                           Taking="@IsTaking(context.Item, context.Item.Moneyline, context.Item.Moneyline.First)" Banked="@IsBanked(context.Item, context.Item.Moneyline, context.Item.Moneyline.First)"
                           OnTake="() => Take(context.Item, context.Item.Moneyline, context.Item.Moneyline.First)"
                           OnBank="() => Bank(context.Item, context.Item.Moneyline, context.Item.Moneyline.First)" />
            </CellTemplate>
        </DeskTemplateColumn>

        <DeskTemplateColumn T="BoardRow" Title="Moneyline, away" Align="Align.Right" Sortable="false"
                        HeaderClass="board__ml board__pair-end" CellClass="board__ml board__pair-end">
            <HeaderTemplate>@SideHeader("Moneyline", "away")</HeaderTemplate>
            <CellTemplate>
                <PriceCell Offer="context.Item.Moneyline.Second" Selection="@Side(context.Item, false)"
                           StartsAt="context.Item.Game.StartsAt" Polled="_polled"
                           Taking="@IsTaking(context.Item, context.Item.Moneyline, context.Item.Moneyline.Second)" Banked="@IsBanked(context.Item, context.Item.Moneyline, context.Item.Moneyline.Second)"
                           OnTake="() => Take(context.Item, context.Item.Moneyline, context.Item.Moneyline.Second)"
                           OnBank="() => Bank(context.Item, context.Item.Moneyline, context.Item.Moneyline.Second)" />
            </CellTemplate>
        </DeskTemplateColumn>

        <DeskTemplateColumn T="BoardRow" Title="Spread, home" Align="Align.Right" Sortable="false"
                        HeaderClass="board__spread board__pair" CellClass="board__spread board__pair">
            <HeaderTemplate>@MarketHeader("Spread", "home")</HeaderTemplate>
            <CellTemplate>
                <PriceCell Offer="context.Item.Spread.First" Selection="@Side(context.Item, true)"
                           StartsAt="context.Item.Game.StartsAt" Polled="_polled"
                           Taking="@IsTaking(context.Item, context.Item.Spread, context.Item.Spread.First)" Banked="@IsBanked(context.Item, context.Item.Spread, context.Item.Spread.First)"
                           OnTake="() => Take(context.Item, context.Item.Spread, context.Item.Spread.First)"
                           OnBank="() => Bank(context.Item, context.Item.Spread, context.Item.Spread.First)" />
            </CellTemplate>
        </DeskTemplateColumn>

        <DeskTemplateColumn T="BoardRow" Title="Spread, away" Align="Align.Right" Sortable="false" HeaderClass="board__spread board__pair-end" CellClass="board__spread board__pair-end">
            <HeaderTemplate>@SideHeader("Spread", "away")</HeaderTemplate>
            <CellTemplate>
                <PriceCell Offer="context.Item.Spread.Second" Selection="@Side(context.Item, false)"
                           StartsAt="context.Item.Game.StartsAt" Polled="_polled"
                           Taking="@IsTaking(context.Item, context.Item.Spread, context.Item.Spread.Second)" Banked="@IsBanked(context.Item, context.Item.Spread, context.Item.Spread.Second)"
                           OnTake="() => Take(context.Item, context.Item.Spread, context.Item.Spread.Second)"
                           OnBank="() => Bank(context.Item, context.Item.Spread, context.Item.Spread.Second)" />
            </CellTemplate>
        </DeskTemplateColumn>

        <DeskTemplateColumn T="BoardRow" Title="Total, over" Align="Align.Right" Sortable="false"
                        HeaderClass="board__total board__pair" CellClass="board__total board__pair">
            <HeaderTemplate>@MarketHeader("Total", "over")</HeaderTemplate>
            <CellTemplate>
                <PriceCell Offer="context.Item.Total.First" Selection="@TotalSide(context.Item.Total.First, "O")"
                           StartsAt="context.Item.Game.StartsAt" Polled="_polled"
                           Taking="@IsTaking(context.Item, context.Item.Total, context.Item.Total.First)" Banked="@IsBanked(context.Item, context.Item.Total, context.Item.Total.First)"
                           OnTake="() => Take(context.Item, context.Item.Total, context.Item.Total.First)"
                           OnBank="() => Bank(context.Item, context.Item.Total, context.Item.Total.First)" />
            </CellTemplate>
        </DeskTemplateColumn>

        <DeskTemplateColumn T="BoardRow" Title="Total, under" Align="Align.Right" Sortable="false" HeaderClass="board__total board__pair-end" CellClass="board__total board__pair-end">
            <HeaderTemplate>@SideHeader("Total", "under")</HeaderTemplate>
            <CellTemplate>
                <PriceCell Offer="context.Item.Total.Second" Selection="@TotalSide(context.Item.Total.Second, "U")"
                           StartsAt="context.Item.Game.StartsAt" Polled="_polled"
                           Taking="@IsTaking(context.Item, context.Item.Total, context.Item.Total.Second)" Banked="@IsBanked(context.Item, context.Item.Total, context.Item.Total.Second)"
                           OnTake="() => Take(context.Item, context.Item.Total, context.Item.Total.Second)"
                           OnBank="() => Bank(context.Item, context.Item.Total, context.Item.Total.Second)" />
            </CellTemplate>
        </DeskTemplateColumn>

    </DeskGrid>

    @* No market folds away any more. Spread and totals used to hide under 820px of grid
       (the Desk's wider-column class) with a sentence under the table saying so, and between that and the width
       all six cells needed the grid scrolled, so the default Line watch Board (about 940px)
       hid its totals behind a scrollbar. The table now gives width back in steps by the
       Board's own width (xlines.css, "The board's column rhythm": the starters, then the
       start's one line, then the rails), stacks each market's two sides in one column where
       even that is too wide, and scrolls only at the narrowest, the matchup pinned. *@
    </div>

    @if (_closing > 0)
    {
        @* Said once, under the grid, rather than repeated in every muted cell. *@
        <Note>
            @_closing of @Visible.Count rows show <strong>closing</strong> prices — the last
            number on the board before the game started. Hover one for when it was captured.
        </Note>
    }
}

@* Follow-ups live above the desk and outlive the row that opened them, so several games can
   be compared at once. *@
<FollowUpLayer Launcher="_followUps" OnChanged="StateHasChanged" />

@code {
    /// <summary>
    /// The row the grid opens under the open game: the strip first, on a line of its own, then
    /// whatever answer is up — a glance the strip handed over, or a take. A press anywhere in it
    /// stops there (DeskGrid's child row), so only the game row's own click closes the row.
    /// </summary>
    private RenderFragment OpenRow(BoardRow row) => __builder =>
    {
        @* Keyed by the game so moving to another row is a fresh strip rather than one still
           showing the previous game's snippet — and by the take, so a price pressed while a
           glance was open leaves the strip with nothing chosen rather than a segment lit for a
           snippet no longer showing. *@
        <RowActions @key="(row.Game.Id, _takeSerial)" Actions="ActionsFor(row)"
                    SnippetHost="@((RenderFragment? snippet) => HostSnippet(row.Game.Id, snippet))" />
        @_snippet
    };

    /// <summary>
    /// One club in the matchup cell: a line of its crest, its nickname and its starter. The line
    /// dissolves into the cell's grid (.board__sides), so the away and home lines share their
    /// columns and the two starters start at one edge.
    /// </summary>
    private static RenderFragment Side(BoardRow row, bool home, bool loser) => __builder =>
    {
        var team = home ? row.Game.HomeTeam : row.Game.AwayTeam;
        var starter = Starter(row, home);

        <span class="board__side@(loser ? " board__team--loser" : "")">
            <TeamMark Sport="@row.Game.Sport?.Key" Abbrev="@team?.Abbrev" />
            <span class="board__team">@TeamNames.Short(team, Scoreline.Abbrev(team, home ? "Home" : "Away"))</span>
            @if (starter is { } s)
            {
                @* No title of its own: the starter sits inside the matchup link, which takes focus,
                   so the full name and what the role means ride on the link's tooltip
                   (MatchupTooltip) instead of a title only a pointer raises (HIG 12). *@
                <span class="board__starter">
                    @if (s.Role.Length > 0)
                    {
                        <span class="board__starter-role">@s.Role</span>@(" ")
                    }
                    @s.Name
                </span>
            }
        </span>
    };

    /// <summary>
    /// The first header of a market's pair: the market's name, which the stylesheet draws centred
    /// over both columns (.board__market), and the side the column holds, for a screen reader.
    /// </summary>
    private static RenderFragment MarketHeader(string market, string side) => __builder =>
    {
        <span class="board__market">@market</span><span class="sr-only">, @side</span>
    };

    /// <summary>The second header of a pair: nothing drawn under the shared name, a name of its own to hear.</summary>
    private static RenderFragment SideHeader(string market, string side) => __builder =>
    {
        <span class="sr-only">@market, @side</span>
    };

    /// <summary>
    /// The take, read from the open row at render time rather than captured, so a reload that
    /// re-prices the board re-prices the take with it.
    /// </summary>
    private RenderFragment TakeSnippet => __builder =>
    {
        if (_take is { } take && _open is { } row && row.Game.Id == take.GameId)
        {
            <div class="rowacts__snippet">
                @* Keyed by the serial alone: every take opened bumps it (OpenTake), and a side
                   chosen inside the take changes the request without opening another, so the
                   take keeps its stake while the row follows it. *@
                <QuickTake @key="_takeSerial" Row="row" Market="@take.Market" Outcome="@take.Outcome"
                           Book="@take.Book" Matchup="@Matchup(row.Game)"
                           OnClose="CloseTake"
                           OnChooseSide="@(((string Market, string Outcome) side) => ChooseSide(row, side.Market, side.Outcome))"
                           OnOpenForm="@(((string Book, decimal Stake) form) => OpenForm(row, take, form.Book, form.Stake))"
                           OnOpenTyped="@((TypedTake typed) => OpenForm(row, take, typed.Book, typed.Stake, typed))"
                           OnViewSlip="ViewSlip" />
            </div>
        }
    };

    // The row strip's glances (ActionsFor), each the snippet its key drops under the row.
    private RenderFragment OddsGlance(int id) => @<OddsSnippet GameId="id" />;

    private RenderFragment HeadToHeadGlance(int id) => @<HeadToHeadSnippet GameId="id" />;

    private RenderFragment FormGlance(int id) => @<FormSnippet GameId="id" />;

    private RenderFragment AllBetsGlance(int id) => @<BoardAllBets GameId="id" />;

    /// <summary>The open row's Place wager (ActionsFor), offered to an operator on a priced row.</summary>
    private RowAction PlaceWagerAction(BoardRow row) => new()
    {
        Key = "wager",
        // The row strip is the Desk's to draw, so the key is not a WagerKey; it
        // takes the wager key's own label and glyph, so it reads as one.
        Label = WagerKey.PlaceLabel,
        Icon = WagerKey.Glyph,
        // Tinted, not Filled: the strip repeats on every row the operator opens, and a
        // solid accent per row would put a dozen primaries on one slate. The Board is a
        // place to look, and the take this opens holds the commit.
        Emphasis = DeskEmphasis.Tinted,
        // Door 1 opens on the most value, in the row, as a pressed price does; a game
        // with no value read anywhere has no side to start from, so it is the form. In
        // Line watch a price pressed on this row is the side being watched, so the take
        // opens on it (ADR 0029), and the most value only when none was pressed. Read
        // at the press, not now: the strip is built before the price is pressed.
        OpenWindow = Command(() => PlaceWager(row))
    };
}
