@using System.Globalization
@using XLines.Data.CrossReference
@using XLines.Data.Gamecast
@using XLines.Ingestion.Services
@using XLines.Web.Components.Snippets
@using XLines.Web.Services
@using Microsoft.Extensions.Logging
@inherits PanelBase
@implements IAsyncDisposable
@inject IGamecastData Data
@inject IJSRuntime JS

@*
    One NFL game, play by play, while it is on and once it is over (spec 2026-10-24 §6.1, §6.4;
    the drive chart, the replayed field and the leaders are spec 2026-11-26 §3).

    The anatomy is ADR 0020's: the title is the matchup and the score with the period and the
    clock as tags and the situation as its one quiet line. Under it, a flow of cards (ADR 0032):
    the field, the drive chart, the score by quarter, the two teams compared and the game's
    leaders — as many across as the window's width allows, stacked in a narrow one — and beneath
    them, the whole row, the sections: the drive log, the win probability, the scoring and the
    box score. A card with nothing to hold is left out rather than drawn empty: a final with no
    drives has no field and no chart, a box score with no leader no leaders. No in-play market:
    that is a later step, and an empty section promising it would be a placeholder shaped like
    nothing.

    One drive is selected, and the log, the chart and the field all show it, so the three never
    disagree about which drive the operator is reading. Pressing a drive on the chart or in the
    log selects it: it opens in the log and the field replays it — its plays as arcs, its start,
    and its end with the result — with the drive named under the field in the log's own words.
    While the game is on the field follows the drive in progress until another is chosen; with a
    past drive on it the card says so and offers one key, "Live drive", back to the play, and
    choosing the drive in progress is simply following it. Closing the selected drive in the log
    sends a live field back to the drive in progress, and leaves a final's where it is, since a
    game that is over has nothing else for the field to follow. A final opens on its last
    scoring drive, the moment a game is usually remembered by, else on its last drive with a
    play held.

    While the field follows the drive in progress, a strip over it gives each side's timeouts left
    as pips beside its abbreviation and a "Red zone" tag while the ball is inside the twenty. A
    play appended to a live game is said once in a hidden polite status (its headline and the
    situation it left) and its log row is marked, washed briefly under reduced motion where the
    field's arc does not draw in. A scoring row leads with its headline and its drive's figures,
    and pressing it chooses that drive as the chart does.

    How the plays are arriving is one state (StateOf): live, read in turn, quiet, final or not
    started. Live says nothing extra — the period tag and the running clock already say it. Read
    in turn is one quiet line under the field; quiet is a warning note about the field card. The
    window tells the feed it is open (IGamecastData.Watch), so the game it shows is read first.

    The window appends rather than reloads. It opens on the game's shared snapshot (one read for
    every window on the game, IGamecastData.SnapshotAsync) and, on its own game's plays notice,
    asks for every play and drive written since the newest stamp it has read — the rows' own
    UpdatedAt, never this host's clock — in whichever drive: a new play, and a play ESPN rewrote
    after a review in a drive long closed, arrive the same way. Every row is keyed by the play's
    id, so the diff is an insert at the top of the open drive rather than a rewrite of the log; a
    correction replaces its row, a renumbered play moves, and no play is ever held twice. Each
    drive's play count and sequence range are derived from the plays held, not asked of the
    database. Loads and appends overlap — Try again during a refresh, a notice during a load —
    so each builds its lists aside and only the latest swaps them in. The probability
    line and the scoring summary are drawn from the plays the window already holds, so an append
    moves them with no query of their own.
*@

@if (Failed)
{
    <PanelLoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}

@if (_header is null || _game is null)
{
    @if (!Failed)
    {
        @if (Loaded)
        {
            <EmptyState>This game is not on the desk.</EmptyState>
        }
        else
        {
            <DeskSkeleton Shape="DeskSkeletonShape.Block" Width="45%" Height="56px" />
            <DeskSkeleton Lines="3" />
        }
    }
}
else
{
    var game = _game;
    var isLive = game.Status == GameStatus.Live;
    var situation = PlayState.Situation(game);
    var lastPlay = PlayState.LastPlay(game);
    var (period, clock) = ClockParts(game);

    <PanelTitle>
        <ChildContent>
            <Scoreboard Game="game"
                        OnTeam="@((int teamId) => Manager.OpenTeam(teamId, teamId == game.AwayTeamId ? game.AwayTeam?.Name : game.HomeTeam?.Name, WindowId))" />
        </ChildContent>
        <Tags>
            @if (isLive && period is not null)
            {
                <Tag State="DeskState.Warning" Live="true">@period</Tag>
            }
            @if (clock is not null)
            {
                @* The clock is counted down in the browser between the feed's readings
                   (gameclock.js); each new reading is handed to it once. The rail chip says
                   the server's reading; this tag may run ahead of it by at most ClockRunsFor. *@
                <Tag State="DeskState.Neutral"><span class="gc__clock" @ref="_clockEl">@clock</span></Tag>
            }
            @if (!isLive && game.Status != GameStatus.Scheduled)
            {
                <Tag State="@(game.Status == GameStatus.Final ? DeskState.Positive : DeskState.Info)">@Phase(game)</Tag>
            }
        </Tags>
        <Detail>
            @if (situation is not null)
            {
                <span class="gc__situation">@situation</span>
            }
            @if (lastPlay is not null)
            {
                @* The line is cut to fit; the whole play is a tooltip on a trigger that takes
                   focus, not a title only a pointer raises (HIG 12). *@
                <DeskTooltip Text="@game.LastPlay!.Trim()" Placement="DeskTooltipPlacement.Bottom">
                    <span class="gc__last" tabindex="0">Last: @lastPlay</span>
                </DeskTooltip>
            }
            @if (situation is null && lastPlay is null)
            {
                <span>@Starts(game.StartsAt)</span>
            }
        </Detail>
        <Keys>
            @* One key, straight in the title's key slot, which spaces keys itself. *@
            <DeskButton Icon="@Icons.Material.Filled.SportsScore" Emphasis="DeskEmphasis.Tinted"
                        Title="Open this game's lines, team data and players in the Game window"
                        OnClick="() => Manager.OpenGame(game)">
                Game
            </DeskButton>
        </Keys>
    </PanelTitle>

    @if (game.Sport?.Key != Nfl)
    {
        <EmptyState>The gamecast covers NFL games.</EmptyState>
    }
    else
    {
        var now = Now;
        var feed = Data.Feed(GameId);
        var state = StateOf(game.Status, feed, QuietFor(game, now), IsBreak(game));
        @* The field's drive, worked out once a render (Frame) rather than once per mention. *@
        var frame = Frame;
        var (drivePlays, driveStart) = (frame.FieldPlays, frame.FieldStart);
        var replay = frame.Replay;
        var fieldShown = isLive || replay is not null;
        var hasLinescore = _header.AwayLinescore is { Count: > 0 } || _header.HomeLinescore is { Count: > 0 };
        var compared = (game.Status is GameStatus.Live or GameStatus.Final) && _comparison.Count > 0;

        @* A play that has just landed, said to a screen reader without moving its focus: the
           headline and the situation it left, written only when an append adds a play (never on
           the first load, never for a correction), so the region speaks once a play. Always in the
           markup, since a live region added with its words already in it is not announced. *@
        <p class="sr-only gc__announce" role="status" aria-live="polite" aria-atomic="true">@_announcement</p>

        @* The cards flow (.wflow, ADR 0032): one track each, as many across as the window allows,
           a short card keeping its own height beside a tall one. The sections take the whole row
           beneath them (.wsection--span), as the Game window's box score does. *@
        <div class="wflow gc__flow">
            @if (fieldShown)
            {
                @* The field, and how its plays are arriving: a warning note about the card when
                   they are not (its Notice, never inside the card), one quiet footer line while
                   the game is read in turn, and nothing while they arrive at full pace. A drive
                   replayed is named under the field in the drive log's own words; while the game
                   is on, the card's one key brings the field back to the drive in progress. *@
                <FormGroup Title="Field" Class="gc__fieldcard"
                           Keys="@(isLive && replay is not null ? LiveDriveKey : null)"
                           Notice="@(state == FeedState.Quiet ? QuietNote(feed, now) : null)"
                           Footer="@(state == FeedState.Slow ? Words(SlowLine(feed)) : null)">
                    <div class="gc__cardbody">
                        @if (replay is not null)
                        {
                            <FieldGraphic HomeAbbrev="@_header.Home.Abbrev" AwayAbbrev="@_header.Away.Abbrev"
                                          Replay="true" HomeBall="@SideOf(replay)" Label="@ReplayLabel(replay)"
                                          Sport="@_header.SportKey"
                                          DrivePlays="@PlaysOf(replay.Sequence)"
                                          DriveStartYardLine="replay.StartYardLine" DriveEndYardLine="replay.EndYardLine"
                                          DriveResult="@replay.Result" />
                            <p class="gc__fielddrive">
                                @if (isLive)
                                {
                                    <span class="gc__fieldnote">Earlier drive</span>
                                }
                                @RenderDriveLead(replay)
                            </p>
                        }
                        else
                        {
                            @RenderFieldStatus(_header)
                            <FieldGraphic HomeAbbrev="@_header.Home.Abbrev" AwayAbbrev="@_header.Away.Abbrev"
                                          YardLine="@_header.YardLine" Distance="@_header.Distance"
                                          HomeBall="@HomeBall(_header)" Label="@FieldLabel(game, situation)"
                                          Sport="@_header.SportKey"
                                          DrivePlays="drivePlays" DriveStartYardLine="driveStart" />
                        }
                    </div>
                </FormGroup>
            }

            @if (_drives.Count > 0)
            {
                @* Every drive on one field, a row each; pressing one is choosing the drive the
                   field replays and the log opens, so the three always agree. *@
                <FormGroup Title="Drive chart" Class="gc__drivecard">
                    <div class="gc__cardbody">
                        <DriveChart Drives="_drives" HomeTeamId="@_header.Home.Id"
                                    HomeAbbrev="@_header.Home.Abbrev" AwayAbbrev="@_header.Away.Abbrev"
                                    Selected="@frame.FieldSequence" OnSelect="SelectDrive" Sport="@_header.SportKey" />
                    </div>
                </FormGroup>
            }

            @if (hasLinescore)
            {
                @* The Game window's own spelling: the line score inset into the card, its own box
                   undone (linescore--inset), so the card's edge is the one edge. *@
                <FormGroup Title="Score by quarter" Class="gc__scorecard">
                    <Linescore Sport="@_header.SportKey" Class="linescore--inset"
                               AwayAbbrev="@_header.Away.Abbrev" HomeAbbrev="@_header.Home.Abbrev"
                               Away="_header.AwayLinescore" Home="_header.HomeLinescore"
                               AwayTotal="_header.AwayScore" HomeTotal="_header.HomeScore" />
                </FormGroup>
            }

            @if (compared)
            {
                <FormGroup Title="Team comparison" Class="gc__comparecard">
                    <div class="gc__cardbody">
                        <TeamComparison Rows="_comparison" AwayAbbrev="@_header.Away.Abbrev" HomeAbbrev="@_header.Home.Abbrev"
                                        Sport="@_header.SportKey" />
                    </div>
                </FormGroup>
            }

            @if (_hasLeaders)
            {
                <FormGroup Title="Game leaders" Class="gc__leaderscard">
                    <div class="gc__cardbody">
                        <GameLeaders Box="_box" HomeAbbrev="@_header.Home.Abbrev" AwayAbbrev="@_header.Away.Abbrev"
                                     Sport="@_header.SportKey" OnPlayer="OpenPlayer" />
                    </div>
                </FormGroup>
            }

        <div class="wsection wsection--span gc__sections">
        @* One reading at a time, as the Game window's sections are and as a league's own game
           page is: the plays, the scoring, the probability, the box score. Twenty drives no
           longer stand between the title and the chart. The tab names what is showing, so no
           heading under it says it again; the block is read at a table's width, as the Game
           window's box score is (.gameroster__block), not stretched across a maximised window. *@
        <div class="gameroster__block gc__block">
        <DeskTabs TValue="View" Tabs="@Views()" Label="Gamecast sections" @bind-Value="_view">
            @if (context == View.Plays)
            {
                @if (_plays.Count == 0)
                {
                    <EmptyState>@(state == FeedState.Final ? NoPlaysHeld(_miss, now) : NoPlays(state))</EmptyState>
                }
                else
                {
                    @RenderDrives()
                }
            }
            else if (context == View.Scoring)
            {
                @RenderScoring()
            }
            else if (context == View.Probability)
            {
                @* The series switches are the card's bar; the chart its body. Height="auto": the plot
                   spans the card and keeps its own proportions, as the Performance window's does,
                   rather than shrinking into a fixed box. *@
                <FormGroup Class="gc__probcard">
                    <Keys>
                        <DeskRow Gap="DeskSpace.Space3">
                            <DeskToggle Label="Spread cover" Checked="_showCover" CheckedChanged="@((bool on) => ShowSeries(cover: on))"
                                        Title="Add the chance the home side covers the closing spread" />
                            <DeskToggle Label="Total over" Checked="_showOver" CheckedChanged="@((bool on) => ShowSeries(over: on))"
                                        Title="Add the chance the game goes over the closing total" />
                        </DeskRow>
                    </Keys>
                    <ChildContent>
                        <div class="gc__cardbody gc__chart">
                        <DeskChart Series="_series" Labels="_labels" Height="auto"
                                   Family="DeskChartFamily.Movement"
                                   Headline="@ChartHeadline()"
                                   Takeaway="@CloseCaption(_header)"
                                   ShowLegend="@(_series.Count > 1)"
                                   Description="@DeskChart.Describe("Win probability by play, in percent", _labels, _series)" />
                        </div>
                    </ChildContent>
                </FormGroup>
            }
            else
            {
                @if (_box is { IsEmpty: false } box)
                {
                    @* Each side a card, as the Game window draws them (.gameroster__cols): away left
                       and home right once the flow is wide enough, stacked below that. *@
                    <div class="gameroster__cols">
                        <BoxScoreSide Side="box.Away" Team="@(game.AwayTeam?.Name ?? "Away")" OnPlayer="OpenPlayer"
                                      Sport="@game.Sport?.Key" Abbrev="@game.AwayTeam?.Abbrev" />
                        <BoxScoreSide Side="box.Home" Team="@(game.HomeTeam?.Name ?? "Home")" OnPlayer="OpenPlayer"
                                      Sport="@game.Sport?.Key" Abbrev="@game.HomeTeam?.Abbrev" />
                    </div>
                }
                else
                {
                    @* A final's box is not coming: say that it is not held, not that it will appear. *@
                    <EmptyState>@(game.Status == GameStatus.Final ? "No box score is held for this game." : "The box score appears once the first stats are in.")</EmptyState>
                }
            }
        </DeskTabs>
        </div>
        </div>
        </div>
    }
}

@code {
    private const string Nfl = "nfl";

    /// <summary>Past this many rows an open drive's plays are virtualised (spec §6.4).</summary>
    public const int VirtualizeAt = 150;

    /// <summary>
    /// No play newer than this while the game is live: the feed is not following it. The feed
    /// reads every fifteen seconds, and a play lands at least every minute or so outside the
    /// breaks the clock already says.
    /// </summary>
    public static readonly TimeSpan QuietAfter = TimeSpan.FromMinutes(2);

    /// <summary>
    /// How far past a reading the browser may count the clock: one feed poll (fifteen seconds)
    /// and a little slack. A stoppage the feed has not read yet costs at most this much, and the
    /// next reading corrects it, rather than the clock running half a minute ahead.
    /// </summary>
    public static readonly TimeSpan ClockRunsFor = TimeSpan.FromSeconds(18);

    /// <summary>
    /// How far the clock's drop between two readings may differ from the wall-clock time between
    /// them and still count as a clock that ran: the feed's own timing jitters by a second or two.
    /// </summary>
    public static readonly TimeSpan ClockTolerance = TimeSpan.FromSeconds(5);

    /// <summary>The flat 50% line the cover and over series are read against.</summary>
    public const string EvenSeries = "Cover and over at even";

    /// <summary>A live game's box score is read at most this often; the feed writes it about once a minute.</summary>
    public static readonly TimeSpan BoxEvery = TimeSpan.FromSeconds(30);

    /// <summary>The time the window reads by. Virtual so a test bench can step past the box score's throttle.</summary>
    protected virtual DateTimeOffset Now => DateTimeOffset.UtcNow;

    /// <summary>
    /// Whether a game has a gamecast to open: an NFL game once it has kicked off. A final keeps it,
    /// because its plays stay stored. Asked by the Game window's keys and the Board's row actions,
    /// which only have the game, so it costs no query: an NFL final the feed never followed opens
    /// onto the window's own empty state.
    /// </summary>
    public static bool Offered(Game game)
        => game.Sport?.Key == Nfl && game.Status is GameStatus.Live or GameStatus.Final;

    [Parameter, EditorRequired] public int GameId { get; set; }

    protected override string LoadSubject => "The gamecast";

    protected override IReadOnlySet<string> Watches { get; } = new HashSet<string> { DataTopics.Games, DataTopics.Plays };

    /// <summary>
    /// <c>games</c> and <c>plays</c> for this game only: thirteen NFL games on a Sunday afternoon
    /// each write a play every half minute, and none but this one is this window's business.
    /// Built when the game is set, since the Desk reads it on the publisher's thread.
    /// </summary>
    protected override IReadOnlyDictionary<string, IReadOnlySet<string>> WatchesIds => _ids;

    private IReadOnlyDictionary<string, IReadOnlySet<string>> _ids = new Dictionary<string, IReadOnlySet<string>>();
    private string _gameKey = string.Empty;

    private GamecastHeader? _header;

    /// <summary>The header as a <see cref="Game"/>, so the title reads through PlayState and Scoreboard as the Game window's does.</summary>
    private Game? _game;

    /// <summary>
    /// The plays drawn, in sequence order (ties by id), each id once. Never changed in place: a
    /// load or an append builds the next list aside and swaps it in (see <see cref="Merge"/>).
    /// </summary>
    private List<GamecastPlay> _plays = [];

    private IReadOnlyList<GamecastDrive> _drives = [];
    private GameBoxScore? _box;

    /// <summary>When the box score was last read; a live game's is read again once <see cref="BoxEvery"/> has passed.</summary>
    private DateTimeOffset? _boxReadAt;

    // Generations. Every full load, append and header read takes the next number of its kind when
    // it starts, and applies what it read only if no later one of its kind (and, for an append, no
    // load) has started since. The renderer runs one continuation at a time, so these need no lock;
    // what they guard against is two reads interleaving at their awaits.
    private int _loads;
    private int _appends;
    private int _headerReads;

    /// <summary>A full load is in flight. An append asked for meanwhile waits for it, then runs.</summary>
    private bool _loading;
    private bool _appendWaiting;

    protected override async Task OnParametersSetAsync()
    {
        var key = GameId.ToString(CultureInfo.InvariantCulture);
        if (key != _gameKey)
        {
            var mine = new HashSet<string> { key };
            _ids = new Dictionary<string, IReadOnlySet<string>> { [DataTopics.Games] = mine, [DataTopics.Plays] = mine };
            _gameKey = key;
            await LoadAsync();
        }
    }

    /// <summary>
    /// Everything, once: when the window opens, on Try again, and on a refresh that does not say
    /// what changed.
    ///
    /// <para>
    /// The reads land in locals and are swapped in at the end, and only by the latest load to
    /// start: Try again pressed during a refresh's load starts a second one, and the two
    /// interleave at their awaits. An append asked for while a load is in flight waits for it
    /// (<see cref="_appendWaiting"/>) and then runs against what the load drew.
    /// </para>
    /// </summary>
    private async Task LoadAsync()
    {
        await WithActivityAsync(async () =>
        {
            var generation = ++_loads;
            _loading = true;

            try
            {
                var headerRead = ++_headerReads;
                var header = await Data.HeaderAsync(GameId);

                // The title first, so the window has its shape while the plays are read.
                if (generation == _loads && headerRead == _headerReads)
                {
                    SetHeader(header);
                    Follow(renew: false);
                }

                List<GamecastPlay> plays = [];
                IReadOnlyList<GamecastDrive> drives = [];
                DateTimeOffset? watermark = null;
                GameBoxScore? box = null;
                DateTimeOffset? boxAt = null;
                GamecastMiss? miss = null;

                if (header is not null && header.SportKey == Nfl)
                {
                    // The game's shared snapshot: a final's is held for hours, so a second window
                    // on it reads no play or drive at all.
                    var rows = await Data.SnapshotAsync(GameId, settled: header.Status == GameStatus.Final);
                    plays = Merge([], rows.Plays);
                    drives = GamecastDrives.WithSpans(rows.Drives, plays);
                    watermark = rows.Watermark;
                    boxAt = Now;
                    box = await Data.BoxScoreAsync(GameId);

                    // A final with no plays says why, when the backport knows; nothing else asks.
                    if (header.Status == GameStatus.Final && plays.Count == 0)
                        miss = await Data.BackportMissAsync(GameId);
                }

                // A later load started while this one read: it draws, and this one is dropped.
                if (generation != _loads)
                    return;

                _miss = miss;
                _freshPlay = null;
                _plays = plays;
                _drives = drives;
                _watermark = watermark;
                Reindex();
                _box = box;
                _boxReadAt = boxAt;
                RebuildChart();
                RebuildComparison();
            }
            finally
            {
                if (generation == _loads)
                    _loading = false;
            }

            if (_appendWaiting && _header?.SportKey == Nfl)
            {
                _appendWaiting = false;
                try
                {
                    await AppendAsync();
                }
                catch (Exception ex)
                {
                    // The load itself landed; the plays notice it held back did not. The next
                    // notice asks again.
                    Log.LogWarning(ex, "The gamecast's append after a load failed");
                }
            }
        },
        settle: () => _game is null ? PulseState.Idle : PulseState.Healthy,
        status: () => _game is null ? "not found" : Pulse(_game));
    }

    /// <summary>
    /// What a notice touched, and only that (spec §6.4).
    ///
    /// <para>
    /// <c>games:{id}</c> — or a bare <c>games</c> from the fallback poll — reads the header, and
    /// the box score while the game is live (at most once per <see cref="BoxEvery"/>) or final:
    /// the feed writes the box from the summary about once a minute while the game is on.
    /// <c>plays:{id}</c>, or a bare <c>plays</c>, appends. A refresh that says nothing (Try again,
    /// a reconnect) reloads.
    /// </para>
    ///
    /// <para>
    /// The two are independent: a header read that throws does not cost the append, nor the
    /// append the header. A read that fails leaves what is drawn where it is, is logged, and the
    /// pulse says which part did not refresh.
    /// </para>
    /// </summary>
    protected override async Task RefreshAsync(IReadOnlySet<string> heard)
    {
        try
        {
            await RefreshPartsAsync(heard);
        }
        finally
        {
            // Every notice renews the window's interest while the game is one to hold, and the
            // one that brings the final whistle gives it back.
            Follow(renew: true);
        }
    }

    private async Task RefreshPartsAsync(IReadOnlySet<string> heard)
    {
        if (_header is null || Failed || heard.Count == 0)
        {
            await LoadAsync();
            return;
        }

        var failed = new List<string>(2);
        var moved = false;

        if (heard.Contains(DataTopics.Games) || heard.Contains(DataTopics.Address(DataTopics.Games, _gameKey)))
        {
            try
            {
                var headerRead = ++_headerReads;
                var header = await Data.HeaderAsync(GameId);
                if (header is null)
                {
                    await LoadAsync();
                    return;
                }

                if (headerRead == _headerReads)
                {
                    SetHeader(header);
                    await ReadBoxIfDueAsync(header);
                }
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "The gamecast's header did not refresh");
                failed.Add("score");
            }
        }

        if (_header?.SportKey == Nfl
            && (heard.Contains(DataTopics.Plays) || heard.Contains(DataTopics.Address(DataTopics.Plays, _gameKey))))
        {
            try
            {
                moved = await AppendAsync();
            }
            catch (Exception ex)
            {
                Log.LogWarning(ex, "The gamecast's plays did not refresh");
                failed.Add("plays");
            }
        }

        if (failed.Count > 0)
            Report(PulseState.Warn, failed.Count == 2 ? "refresh failed" : $"{failed[0]} did not refresh");
        else if (_game is not null)
            Report(moved ? PulseState.Active : PulseState.Healthy, Pulse(_game));
    }

    /// <summary>
    /// The box score again, when it can have moved: every notice of a final, and a live game's
    /// once <see cref="BoxEvery"/> has passed since the last read.
    /// </summary>
    private async Task ReadBoxIfDueAsync(GamecastHeader header)
    {
        if (header.SportKey != Nfl)
            return;

        var now = Now;
        var due = header.Status switch
        {
            GameStatus.Final => true,
            GameStatus.Live => _boxReadAt is not { } at || now - at >= BoxEvery,
            _ => false
        };

        if (!due)
            return;

        _boxReadAt = now;
        _box = await Data.BoxScoreAsync(GameId);
        RebuildComparison();
    }

    /// <summary>
    /// Every play and drive written since the newest stamp held (<see cref="_watermark"/>), in one
    /// read: a new play, and a play ESPN rewrote — a review, a spot corrected, a probability that
    /// landed after its play, a play renumbered — in any drive, however long closed. True when a
    /// play was added.
    ///
    /// <para>
    /// Everything read is merged by id (<see cref="Merge"/>, <see cref="MergeDrives"/>), never by
    /// sequence: GamecastWriter updates a stored play's sequence, and a play inserted late at or
    /// below the last sequence held is added, not skipped. The read overlaps the last one a little
    /// (GamecastService.ChangeOverlap), so a row stamped at the watermark is never missed and the
    /// few read twice are drawn once. The drives' play counts and ranges are then derived from the
    /// plays held (GamecastDrives.WithSpans), not grouped in the database.
    /// </para>
    ///
    /// <para>
    /// The merge is built aside and swapped in only if no later append, and no load, started
    /// while this one read; one asked for during a load waits for it.
    /// </para>
    /// </summary>
    private async Task<bool> AppendAsync()
    {
        if (_loading)
        {
            _appendWaiting = true;
            return false;
        }

        var generation = ++_appends;
        var loads = _loads;
        var held = _plays;
        var heldDrives = _drives;
        var wasCurrent = CurrentDrive;

        var changes = await Data.ChangesSinceAsync(GameId, _watermark);

        if (generation != _appends || loads != _loads)
            return false;

        _plays = Merge(held, changes.Plays);
        var drives = GamecastDrives.WithSpans(MergeDrives(heldDrives, changes.Drives), _plays);
        var current = CurrentOf(drives);
        _drives = drives;
        _watermark = Later(_watermark, changes.Watermark);
        Reindex();

        // The operator left the drive in progress open; when the next one starts, follow it.
        if (_driveChosen && _openDrive == wasCurrent?.Sequence && current?.Sequence != wasCurrent?.Sequence)
            _driveChosen = false;

        RebuildChart();
        RebuildComparison();

        var added = _plays.Count > held.Count;
        if (added)
            Announce(held);

        return added;
    }

    // ---- A new play, announced -----------------------------------------------------------

    /// <summary>The polite live region's words: the newest play appended, said once. Empty until one lands.</summary>
    private string _announcement = string.Empty;

    /// <summary>The id of the play that has just landed, for the log's reduced-motion wash; null after a load.</summary>
    private long? _freshPlay;

    /// <summary>
    /// After an append that added a play to a live game: the newest of the plays not held before is
    /// announced and marked. A final whose plays arrive later (the backport) is a whole game, not a
    /// play that just happened, so it says nothing.
    /// </summary>
    private void Announce(IReadOnlyList<GamecastPlay> held)
    {
        if (_game?.Status != GameStatus.Live)
            return;

        var before = held.Select(p => p.Id).ToHashSet();
        var newest = _plays.LastOrDefault(p => !before.Contains(p.Id));
        if (newest is null)
            return;

        _freshPlay = newest.Id;
        _announcement = Announcement(newest, _game);
    }

    /// <summary>
    /// A play in one sentence for the live region: its headline (else its sentence), then the down
    /// and the spot it left — the play's own, else the game's situation as the title words it.
    /// </summary>
    public static string Announcement(GamecastPlay play, Game game)
    {
        var what = (PlayHeadline.For(play) ?? play.Text ?? play.Type ?? "Play").Trim().TrimEnd('.');
        var then = play.End?.DownDistanceText is { Length: > 0 } dd ? dd.Trim() : PlayState.Situation(game);

        return string.IsNullOrWhiteSpace(then) ? $"{what}." : $"{what}. {then}";
    }

    /// <summary>
    /// The plays held with those read merged in by id: a play already held is replaced (its row
    /// keeps its key, so only its text changes, or it moves if its sequence did); one not held is
    /// added. The result is in sequence order, ties by id, and holds each id once.
    /// </summary>
    public static List<GamecastPlay> Merge(IReadOnlyList<GamecastPlay> held, IEnumerable<GamecastPlay> read)
    {
        var byId = new Dictionary<long, GamecastPlay>(held.Count + 8);

        foreach (var play in held)
            byId[play.Id] = play;
        foreach (var play in read)
            byId[play.Id] = play;

        return byId.Values.OrderBy(p => p.Sequence).ThenBy(p => p.Id).ToList();
    }

    /// <summary>
    /// The drives held with those read merged in by their row's id (a drive built without one, by
    /// its sequence): a drive the provider changed — its result, its flag, its number — replaces
    /// its old self, and a new one is added. In sequence order, ties by id. The spans are left as
    /// they come; <see cref="GamecastDrives.WithSpans(IReadOnlyList{GamecastDrive}, IEnumerable{GamecastPlay})"/> sets them.
    /// </summary>
    public static List<GamecastDrive> MergeDrives(IReadOnlyList<GamecastDrive> held, IEnumerable<GamecastDrive> read)
    {
        var byId = new Dictionary<long, GamecastDrive>(held.Count + 2);

        foreach (var drive in held)
            byId[DriveKey(drive)] = drive;
        foreach (var drive in read)
            byId[DriveKey(drive)] = drive;

        return byId.Values.OrderBy(d => d.Sequence).ThenBy(d => d.Id).ToList();

        static long DriveKey(GamecastDrive d) => d.Id != 0 ? d.Id : -1L - d.Sequence;
    }

    /// <summary>
    /// The newest stamp read: the watermark the next change read starts from. The database's own
    /// <c>UpdatedAt</c>, never this host's clock, so a host whose clock runs fast or slow neither
    /// skips a correction nor reads the game again.
    /// </summary>
    private DateTimeOffset? _watermark;
    private void SetHeader(GamecastHeader? header)
    {
        _header = header;
        _game = header is null ? null : AsGame(header);

        // The clock's last two readings: a new reading shifts the last one back; the same
        // reading read again (another notice, the same feed write) leaves both where they are.
        var reading = _game is null ? null : ClockReading.Of(_game);
        if (reading is null)
        {
            (_previousReading, _reading) = (null, null);
        }
        else if (reading.At != _reading?.At)
        {
            (_previousReading, _reading) = (_reading, reading);
        }
    }

    /// <summary>
    /// The header as the entity PlayState and Scoreboard read. Built rather than read a second
    /// time, so the clock, the situation and the last play are worded exactly as the Game window's
    /// title words them, from one query.
    /// </summary>
    public static Game AsGame(GamecastHeader h) => new()
    {
        Id = h.GameId,
        Sport = new Sport { Key = h.SportKey, Name = h.SportName },
        HomeTeamId = h.Home.Id,
        HomeTeam = new Team { Id = h.Home.Id, Name = h.Home.Name, Abbrev = h.Home.Abbrev },
        AwayTeamId = h.Away.Id,
        AwayTeam = new Team { Id = h.Away.Id, Name = h.Away.Name, Abbrev = h.Away.Abbrev },
        StartsAt = h.StartsAt,
        Status = h.Status,
        HomeScore = h.HomeScore,
        AwayScore = h.AwayScore,
        Period = h.Period,
        DisplayClock = h.DisplayClock,
        ClockSeconds = h.ClockSeconds,
        StatusDetail = h.StatusDetail,
        PossessionTeamId = h.PossessionTeamId,
        Down = h.Down,
        Distance = h.Distance,
        YardLine = h.YardLine,
        DownDistanceText = h.DownDistanceText,
        PossessionText = h.PossessionText,
        IsRedZone = h.IsRedZone,
        HomeTimeouts = h.HomeTimeouts,
        AwayTimeouts = h.AwayTimeouts,
        LastPlay = h.LastPlay,
        LiveUpdatedAt = h.LiveUpdatedAt
    };

    /// <summary>The rail chip as a mini-scoreboard: "Q3 4:12 · CHI ball", else where the game stands.</summary>
    private static string Pulse(Game game)
    {
        var side = PlayState.Situation(game) is { } s ? s.Split(',')[0] : null;
        return PlayState.Clock(game) is { } clock
            ? side is null ? clock : $"{clock} · {side}"
            : StateStatus(game);
    }

    /// <summary>
    /// The period and the clock as two tags — "Q3", "4:12" — when PlayState's reading ends in
    /// the clock; one tag otherwise ("Halftime", "End of 3rd"), as the period, with no clock to run.
    /// </summary>
    private static (string? Period, string? Clock) ClockParts(Game game)
    {
        if (PlayState.Clock(game) is not { } reading)
            return (null, null);

        var clock = game.DisplayClock?.Trim();
        if (!string.IsNullOrEmpty(clock) && reading.EndsWith(" " + clock, StringComparison.Ordinal))
            return (reading[..^(clock.Length + 1)], clock);

        return (reading, null);
    }

    private static bool? HomeBall(GamecastHeader h)
        => h.PossessionTeamId is not { } id ? null
            : id == h.Home.Id ? true
            : id == h.Away.Id ? false
            : null;

    /// <summary>The field in words: "PHI ball, 2nd and 6 at WSH 34", or what the field shows when nobody has the ball.</summary>
    private static string FieldLabel(Game game, string? situation)
        => situation is not null
            ? $"Field: {situation.Replace("&", "and", StringComparison.Ordinal)}"
            : $"Field: {game.AwayTeam?.Abbrev} on the left, {game.HomeTeam?.Abbrev} on the right; no ball spotted";

    // ---- How the plays are arriving ------------------------------------------------------

    /// <summary>How the plays are arriving, in one word (<see cref="StateOf"/>).</summary>
    public enum FeedState
    {
        /// <summary>Plays arrive at full pace. Nothing is said: the period tag and the running clock say it.</summary>
        Live,

        /// <summary>The feed here reads the game in turn with others, so plays land in steps.</summary>
        Slow,

        /// <summary>Plays should be arriving and are not, or the feed here is not reading the game.</summary>
        Quiet,

        Final,

        /// <summary>Scheduled, or postponed: no play is due.</summary>
        NotStarted
    }

    /// <summary>
    /// The state, from the game's status, the feed's reading, how long since the newest play (the
    /// kickoff, while there is none) and whether the clock names a break.
    ///
    /// <para>
    /// A live game is <see cref="FeedState.Live"/> while the feed here has it in the fast lane, or,
    /// with the feed elsewhere, while a play is younger than <see cref="QuietAfter"/>.
    /// <see cref="FeedState.Slow"/> while the feed here reads it in turn — and quiet only once
    /// nothing has landed for well past its turn (<see cref="SlowQuietAfter"/>).
    /// <see cref="FeedState.Quiet"/> when nothing is newer than <see cref="QuietAfter"/> outside a
    /// break and nothing explains it, when the feed here is backing off the game, or when it is
    /// here and reads the game in no lane at all.
    /// </para>
    /// </summary>
    public static FeedState StateOf(GameStatus status, GamecastFeedReading feed, TimeSpan sinceNewest, bool isBreak)
    {
        if (status == GameStatus.Final)
            return FeedState.Final;
        if (status != GameStatus.Live)
            return FeedState.NotStarted;

        var stale = !isBreak && sinceNewest >= QuietAfter;

        if (!feed.Here)
            return stale ? FeedState.Quiet : FeedState.Live;

        return feed.Lane switch
        {
            GamecastLane.Fast => stale ? FeedState.Quiet : FeedState.Live,
            GamecastLane.Slow => !isBreak && sinceNewest >= SlowQuietAfter(feed) ? FeedState.Quiet : FeedState.Slow,
            _ => FeedState.Quiet
        };
    }

    /// <summary>
    /// How long a game read in turn may go without a play before it is quiet: <see cref="QuietAfter"/>
    /// and two of its turns, so a game read every forty-five seconds is quiet only after three and a
    /// half minutes, and one read every two minutes after six.
    /// </summary>
    public static TimeSpan SlowQuietAfter(GamecastFeedReading feed)
        => QuietAfter + (feed.SlowEvery ?? TimeSpan.Zero) * 2;

    /// <summary>How long since the newest play, or since the kickoff while there is none.</summary>
    private TimeSpan QuietFor(Game game, DateTimeOffset now)
    {
        var newest = _plays.Count == 0 ? (DateTimeOffset?)null
            : _plays.Max(p => Later(p.Wallclock, p.Modified));

        return now - (newest ?? game.StartsAt);
    }

    /// <summary>
    /// The warning about a quiet game: what is wrong, and how old the newest play is. Where the
    /// feed is not in this process the settings that run it are on the note, in a line of their own
    /// rather than in a title a note — which never takes focus — gave only a pointer (HIG 12); the
    /// sentence itself names none. Where the feed is here the keys are not the problem and are not shown.
    /// </summary>
    private RenderFragment QuietNote(GamecastFeedReading feed, DateTimeOffset now) => @<text>
        <Note State="DeskState.Warning" Class="gc__quiet">
            @QuietLine(feed, now)
            @if (!feed.Here)
            {
                <span class="gc__quiet-keys">@QuietKeys</span>
            }
        </Note>
    </text>;

    /// <summary>The quiet note's sentences.</summary>
    private string QuietLine(GamecastFeedReading feed, DateTimeOffset now)
    {
        var since = _game is null ? TimeSpan.Zero : QuietFor(_game, now);
        var age = AgeWords(since);

        var what = _plays.Count == 0
            ? $"Plays are not arriving. The game kicked off {age} ago and none has landed."
            : $"Plays are not arriving. The newest is {age} old.";

        var why = !feed.Here ? "The feed runs on the machine that runs the schedule."
            : feed.Lane == GamecastLane.BackedOff ? "The last reads of this game did not succeed; it is tried again shortly."
            : feed.Lane is null && feed.SlowLanePerPoll <= 0 && feed.InPlay > feed.FastLaneSize
                ? $"{feed.InPlay} games are on and {feed.FastLaneSize} are read at a time; this one is not among them."
            : feed.Lane is null ? "This game is not being read."
            : "The game is being read, and no new play has come in.";

        return $"{what} {why}";
    }

    /// <summary>
    /// The one line under the field while the game is read in turn: how many games are on, how often
    /// this one is read, and — only when it is so — that with this window open it moves to every
    /// poll. Every number is the reading's.
    /// </summary>
    public static string SlowLine(GamecastFeedReading feed)
    {
        var on = feed.InPlay == 1 ? "1 game is on." : $"{feed.InPlay} games are on.";
        var every = feed.SlowEvery is { } turn ? $"This one is read about every {Span(turn)}" : "This one is read in turn with the others";

        return feed.Promoted
            ? $"{on} {every}; with this window open it moves to every {Span(feed.Poll)}."
            : $"{on} {every}.";
    }

    /// <summary>"45 seconds", "2 minutes".</summary>
    private static string Span(TimeSpan span)
    {
        if (span < TimeSpan.FromSeconds(90))
        {
            var seconds = (int)Math.Round(span.TotalSeconds);
            return seconds == 1 ? "second" : $"{seconds} seconds";
        }

        return $"{(int)Math.Round(span.TotalMinutes)} minutes";
    }

    /// <summary>An age in words for a sentence: "under a minute", "9m", "1.5h".</summary>
    private static string AgeWords(TimeSpan since)
        => since < TimeSpan.FromMinutes(1) ? "under a minute" : Age(since.TotalMinutes);

    /// <summary>The plays tab with nothing in it, said for the state the game is in.</summary>
    public static string NoPlays(FeedState state) => state switch
    {
        FeedState.NotStarted => "Plays appear once the game kicks off.",
        FeedState.Final => "No play-by-play is held for this game.",
        _ => "No plays have landed yet."
    };

    /// <summary>Why a final holds no plays, when the backport knows; read only for a final with none.</summary>
    private GamecastMiss? _miss;

    /// <summary>
    /// A final's empty plays tab: none is held, and — when the backport has a miss on file — how
    /// often ESPN was asked, whether the last ask failed, and when it is asked again: "No
    /// play-by-play is held for this game. Asked ESPN 3 times; next try 2 Dec." A retry in another
    /// year names the year; one already due says so rather than naming a day gone by.
    /// </summary>
    public static string NoPlaysHeld(GamecastMiss? miss, DateTimeOffset now)
    {
        var none = NoPlays(FeedState.Final);
        if (miss is null || miss.Attempts <= 0)
            return none;

        var asked = miss.Attempts == 1 ? "Asked ESPN once" : $"Asked ESPN {miss.Attempts} times";
        var failed = miss.Reason is { Length: > 0 } reason
                     && !reason.StartsWith("No plays", StringComparison.OrdinalIgnoreCase)
                     && !reason.StartsWith("The source cannot", StringComparison.OrdinalIgnoreCase);

        // The desk's own day ("Dec 2"), in the league's zone as every date on the desk is.
        var retry = miss.RetryAt;
        var next = retry <= now
            ? "it is due another try"
            : DisplayTime.Format(retry, "yyyy") == DisplayTime.Format(now, "yyyy")
                ? $"next try {DisplayTime.Day(retry)}"
                : $"next try {DisplayTime.Format(retry, "MMM d, yyyy")}";

        return $"{none} {asked}{(failed ? ", the last failed" : null)}; {next}.";
    }

    private static RenderFragment Words(string text) => b => b.AddContent(0, text);

    /// <summary>The settings behind the note where the feed is not in this process; the sentence itself names none.</summary>
    private const string QuietKeys = "Ingestion:HostScheduler runs the feed; Ingestion:Gamecast:Enabled turns it on.";

    // ---- Telling the feed the window is open ----------------------------------------------

    /// <summary>A scheduled game is watched from this long before its start, so its first plays are read at full pace.</summary>
    public static readonly TimeSpan WatchBefore = TimeSpan.FromHours(1);

    /// <summary>
    /// Whether the window should hold the feed's interest in the game: an NFL game that is live, or
    /// scheduled to start within <see cref="WatchBefore"/>.
    /// </summary>
    public static bool Interested(GamecastHeader? header, DateTimeOffset now)
        => header is { SportKey: Nfl }
           && (header.Status == GameStatus.Live
               || (header.Status == GameStatus.Scheduled && header.StartsAt - now <= WatchBefore));

    /// <summary>The game whose interest this window holds; null while it holds none.</summary>
    private int? _watched;

    /// <summary>
    /// Renews the lease between notices, a third of a lease apart: a game in a long stoppage sends
    /// none, and its lease would otherwise run out with the window still open on it.
    /// </summary>
    private System.Threading.Timer? _renewer;

    private bool _released;

    /// <summary>
    /// Watch once when the game becomes one to hold, renew on every refresh while it stays one, and
    /// let go once when it stops being one (the final whistle) or the window closes. Watch and
    /// Unwatch pair exactly once per game: the count in GamecastLanes is per window.
    /// </summary>
    private void Follow(bool renew)
    {
        if (_released)
            return;

        var wants = Interested(_header, Now) && _header!.GameId == GameId;

        if (wants && _watched == GameId)
        {
            if (renew)
                Data.Renew(GameId);
            return;
        }

        Release();

        if (!wants)
            return;

        var id = GameId;
        _watched = id;
        Data.Watch(id);

        var every = GamecastLanes.Lease / 3;
        _renewer = new System.Threading.Timer(_ =>
        {
            if (_watched == id)
                Data.Renew(id);
        }, null, every, every);
    }

    private void Release()
    {
        _renewer?.Dispose();
        _renewer = null;

        if (_watched is { } id)
        {
            _watched = null;
            Data.Unwatch(id);
        }
    }

    protected override void OnDispose()
    {
        _released = true;
        Release();
    }

    // ---- The field and the comparison ----------------------------------------------------

    /// <summary>
    /// The drive on the field's plays, in sequence order, and where it started: only that drive's,
    /// since the field lays out one drive. None while no drive is current, and none while the
    /// side with the ball is not the drive's own: after an interception returned for a score ESPN
    /// still calls the beaten drive current until the kickoff, and its plays drawn under the other
    /// side's ball would read as that side's drive, run backwards.
    /// </summary>
    private (IReadOnlyList<GamecastPlay> Plays, int? Start) FieldDrive()
    {
        if (CurrentDrive is not { } drive)
            return ([], null);

        if (drive.TeamId is { } owner && _header?.PossessionTeamId is { } holder && owner != holder)
            return ([], null);

        return (PlaysOf(drive.Sequence), drive.StartYardLine);
    }

    // ---- The indexes, built once a load or an append -------------------------------------

    /// <summary>The drive each play held is drawn under (<see cref="DriveOf"/>), by play id.</summary>
    private Dictionary<long, int> _driveOf = [];

    /// <summary>Each drive's plays held, in sequence order, keyed as <see cref="_driveOf"/> answers (<see cref="OtherPlays"/> included).</summary>
    private Dictionary<int, List<GamecastPlay>> _byDrive = [];

    /// <summary>The drives held, by sequence; the first listed wins a number listed twice.</summary>
    private Dictionary<int, GamecastDrive> _driveBySequence = [];

    /// <summary>
    /// Rebuilds the play→drive and drive→plays indexes from <see cref="_plays"/> and
    /// <see cref="_drives"/>: once whenever either is swapped (a load, an append), so a render
    /// looks a play's drive up rather than scanning the drives for it once per play.
    /// </summary>
    private void Reindex()
    {
        var bySequence = new Dictionary<int, GamecastDrive>(_drives.Count);
        foreach (var drive in _drives)
            bySequence.TryAdd(drive.Sequence, drive);

        var driveOf = new Dictionary<long, int>(_plays.Count);
        var byDrive = new Dictionary<int, List<GamecastPlay>>();

        foreach (var play in _plays)
        {
            var drive = play.DriveSeq is { } seq && bySequence.ContainsKey(seq) ? seq : DriveOf(play, _drives);
            driveOf[play.Id] = drive;

            if (!byDrive.TryGetValue(drive, out var list))
                byDrive[drive] = list = [];
            list.Add(play);
        }

        (_driveBySequence, _driveOf, _byDrive) = (bySequence, driveOf, byDrive);
    }

    /// <summary>The drive a play held is drawn under, from the index.</summary>
    private int DriveKeyOf(GamecastPlay play) => _driveOf.TryGetValue(play.Id, out var drive) ? drive : DriveOf(play, _drives);

    /// <summary>
    /// What the field shows, worked out once per change of what it depends on rather than once per
    /// mention in a render: the drive replayed, the drive in progress's plays and start, and the
    /// drive the chart marks. Every input is a reference swapped whole or a value, so comparing
    /// them is the whole of the invalidation.
    /// </summary>
    private sealed record FieldFrame(
        object Drives, object Index, Game? Game, GamecastHeader? Header, bool Chosen, int? Drive,
        GamecastDrive? Replay, IReadOnlyList<GamecastPlay> FieldPlays, int? FieldStart, int? FieldSequence);

    private FieldFrame? _frame;

    private FieldFrame Frame
    {
        get
        {
            if (_frame is { } f
                && ReferenceEquals(f.Drives, _drives) && ReferenceEquals(f.Index, _byDrive)
                && ReferenceEquals(f.Game, _game) && ReferenceEquals(f.Header, _header)
                && f.Chosen == _fieldChosen && f.Drive == _fieldDrive)
                return f;

            var replay = ComputeReplayDrive();
            var (plays, start) = FieldDrive();
            var sequence = replay?.Sequence ?? (_game?.Status == GameStatus.Live ? CurrentDrive?.Sequence : null);

            return _frame = new FieldFrame(_drives, _byDrive, _game, _header, _fieldChosen, _fieldDrive,
                replay, plays, start, sequence);
        }
    }

    /// <summary>The comparison's rows, rebuilt only when the plays, the drives or the box score move.</summary>
    private IReadOnlyList<ComparisonRow> _comparison = [];

    /// <summary>Whether the box score names a leader in any category; rebuilt with the comparison, when the box can have moved.</summary>
    private bool _hasLeaders;

    private void RebuildComparison()
    {
        _comparison = _header is null ? [] : GamecastTelemetry.Compare(_header, _drives, _plays, _box);
        _hasLeaders = GameLeadersModel.For(_box, _header?.SportKey).Count > 0;
    }

    // ---- The drive on the field ----------------------------------------------------------

    /// <summary>
    /// The drive the operator put on the field, from the log or the chart. Null with
    /// <see cref="_fieldChosen"/> false is the window's own choice: the drive in progress while
    /// the game is on, <see cref="FinalDrive"/> once it is over.
    /// </summary>
    private int? _fieldDrive;
    private bool _fieldChosen;

    /// <summary>The drive chosen for the field, while it is still among the drives read.</summary>
    private GamecastDrive? ChosenDrive
        => _fieldChosen && _fieldDrive is { } sequence ? _driveBySequence.GetValueOrDefault(sequence) : null;

    /// <summary>
    /// The drive the field replays, null while it follows the drive in progress: a live game's
    /// past drive the operator chose (choosing the drive in progress is following it), and for a
    /// final the chosen drive or else <see cref="FinalDrive"/>. A game not started replays nothing.
    /// Read through <see cref="Frame"/>, which works it out once per change.
    /// </summary>
    private GamecastDrive? ComputeReplayDrive() => _game?.Status switch
    {
        GameStatus.Live => ChosenDrive is { } chosen && chosen.Sequence != CurrentDrive?.Sequence ? chosen : null,
        GameStatus.Final => ChosenDrive ?? FinalDrive(),
        _ => null
    };

    /// <summary>
    /// What a final opens the field on: the last drive that scored, the moment a game is usually
    /// remembered by, else the last drive with a play held. None for a game with no drives.
    /// </summary>
    private GamecastDrive? FinalDrive()
        => _drives.LastOrDefault(d => d.IsScore) ?? _drives.LastOrDefault(d => _byDrive.ContainsKey(d.Sequence));

    /// <summary>The drive on the field, for the chart's selection: the replayed one, else the one in progress.</summary>
    private int? FieldSequence => Frame.FieldSequence;

    /// <summary>
    /// One drive chosen, from the chart or the log: it opens in the log and goes on the field.
    /// The drive in progress, chosen while the game is on, is the field following it, so the
    /// "Live drive" key does not offer to return to where the field already is.
    /// </summary>
    private void SelectDrive(int sequence)
    {
        _driveChosen = true;
        _openDrive = sequence;

        var following = _game?.Status == GameStatus.Live && sequence == CurrentDrive?.Sequence;
        _fieldChosen = !following;
        _fieldDrive = following ? null : sequence;
    }

    /// <summary>Back to the drive in progress: the field follows it again, and the log opens it again.</summary>
    private void FollowLiveDrive()
    {
        _fieldChosen = false;
        _fieldDrive = null;
        _driveChosen = false;
        _openDrive = null;
    }

    /// <summary>
    /// Over the live field: each side's timeouts left as three pips beside its abbreviation, away
    /// on the left and home on the right as the field has them, and between them a "Red zone" tag
    /// while the ball is inside the defence's twenty. A side with no reading draws nothing; with
    /// neither side read and the ball outside the red zone the strip is left out. Only while the
    /// field follows the drive in progress: over an earlier drive, these would describe a moment
    /// the picture is not of.
    /// </summary>
    private RenderFragment RenderFieldStatus(GamecastHeader header) => @<text>
        @if (header.AwayTimeouts is not null || header.HomeTimeouts is not null || header.IsRedZone == true)
        {
            <div class="gc__fieldstatus">
                @RenderTimeouts("away", header.Away.Abbrev, header.AwayTimeouts)
                @if (header.IsRedZone == true)
                {
                    <Tag State="DeskState.Warning" Class="gc__redzone">Red zone</Tag>
                }
                @RenderTimeouts("home", header.Home.Abbrev, header.HomeTimeouts)
            </div>
        }
    </text>;

    /// <summary>A timeout a side may call in a half.</summary>
    private const int TimeoutsPerHalf = 3;

    /// <summary>One side's timeouts: its abbreviation and three pips, filled for each left, named in words.</summary>
    private static RenderFragment RenderTimeouts(string side, string abbrev, int? left) => @<text>
        @if (left is { } n)
        {
            var kept = Math.Clamp(n, 0, TimeoutsPerHalf);
            <span class="gc__timeouts gc__timeouts--@side" data-side="@side" role="img" aria-label="@TimeoutsLabel(abbrev, kept)">
                <span class="gc__timeouts-side" aria-hidden="true">@abbrev</span>
                <span class="gc__pips" aria-hidden="true">
                    @for (var i = 0; i < TimeoutsPerHalf; i++)
                    {
                        <span class="gc__pip @(i < kept ? "gc__pip--left" : null)"></span>
                    }
                </span>
            </span>
        }
    </text>;

    /// <summary>"WSH, 2 timeouts left", "WSH, 1 timeout left", "WSH, no timeouts left".</summary>
    private static string TimeoutsLabel(string abbrev, int left) => left switch
    {
        0 => $"{abbrev}, no timeouts left",
        1 => $"{abbrev}, 1 timeout left",
        _ => $"{abbrev}, {left} timeouts left"
    };

    /// <summary>The field card's one key while a live game's past drive is on it.</summary>
    private RenderFragment LiveDriveKey => @<DeskButton Icon="@Icons.Material.Filled.Replay" Size="DeskKeySize.Small"
                                                        Title="Put the drive in progress back on the field"
                                                        OnClick="FollowLiveDrive">Live drive</DeskButton>;

    /// <summary>True when the drive was the home side's, false for the away side's, null for neither.</summary>
    private bool? SideOf(GamecastDrive drive)
        => drive.TeamId is not { } id || _header is null ? null
            : id == _header.Home.Id ? true
            : id == _header.Away.Id ? false
            : null;

    /// <summary>A drive's plays held, in sequence order, from the index; never changed in place.</summary>
    private IReadOnlyList<GamecastPlay> PlaysOf(int drive)
        => _byDrive.TryGetValue(drive, out var plays) ? plays : [];

    /// <summary>A replayed drive in words, as its log row says it: "Field: PHI drive, 7 plays, 62 yds, 3:48, TD".</summary>
    private string ReplayLabel(GamecastDrive drive)
    {
        var side = SideOf(drive) switch
        {
            true => _header!.Home.Abbrev,
            false => _header!.Away.Abbrev,
            null => drive.TeamAbbrev
        };

        var line = DriveLine(drive).Replace(" · ", ", ", StringComparison.Ordinal);
        return string.IsNullOrWhiteSpace(side) ? $"Field: drive, {line}" : $"Field: {side} drive, {line}";
    }

    private static DateTimeOffset? Later(DateTimeOffset? a, DateTimeOffset? b)
        => a is null ? b : b is null ? a : a > b ? a : b;

    /// <summary>A stoppage the detail line names — halftime, the end of a quarter — when nothing is meant to be happening.</summary>
    private static bool IsBreak(Game game)
        => game.StatusDetail is { } d
           && (d.Contains("Halftime", StringComparison.OrdinalIgnoreCase)
               || d.StartsWith("End", StringComparison.OrdinalIgnoreCase)
               || d.Contains("Delayed", StringComparison.OrdinalIgnoreCase));

    private Task OpenPlayer((int PlayerId, string Name) player)
    {
        Manager.OpenPlayer(player.PlayerId, player.Name, WindowId);
        return Task.CompletedTask;
    }

    // ---- The drive log -------------------------------------------------------------------

    /// <summary>The drive in progress: the one ESPN marks current, else the last one there is.</summary>
    private GamecastDrive? CurrentDrive => CurrentOf(_drives);

    private GamecastDrive? CurrentOf(IReadOnlyList<GamecastDrive> drives)
        => drives.LastOrDefault(d => d.IsCurrent) ?? (_game?.Status == GameStatus.Live ? drives.LastOrDefault() : null);

    /// <summary>The disclosure key of the plays no drive holds; no drive is numbered this.</summary>
    private const int OtherPlays = int.MinValue;

    /// <summary>
    /// The drive a play is drawn under: the one ESPN filed it with, else the drive whose sequence
    /// range holds it (a timeout or a two-minute warning between two of the drive's snaps), else
    /// <see cref="OtherPlays"/>. A play is never left undrawn for want of a drive — nor for a
    /// drive number the drives read does not hold yet.
    /// </summary>
    private static int DriveOf(GamecastPlay play, IReadOnlyList<GamecastDrive> drives)
    {
        if (play.DriveSeq is { } drive && drives.Any(d => d.Sequence == drive))
            return drive;

        foreach (var d in drives)
        {
            if (d.FirstSequence is { } first && d.LastSequence is { } last && first <= play.Sequence && play.Sequence <= last)
                return d.Sequence;
        }

        return OtherPlays;
    }

    /// <summary>The drive the operator opened; until they open one, the drive in progress.</summary>
    private int? _openDrive;
    private bool _driveChosen;

    private int? OpenDrive => _driveChosen ? _openDrive : CurrentDrive?.Sequence;

    /// <summary>
    /// One drive open at a time, as one row is everywhere on the desk; opening one is choosing it
    /// for the field as well (<see cref="SelectDrive"/>). Pressing the open one closes it: while
    /// the game is on the field goes back to the drive in progress, and once it is over the field
    /// keeps the drive, since there is nothing else for it to follow. "Other plays" is no drive,
    /// so it only opens and closes.
    /// </summary>
    private void ToggleDrive(int sequence)
    {
        var open = OpenDrive;

        if (sequence == OtherPlays || open == sequence)
        {
            _driveChosen = true;
            _openDrive = open == sequence ? null : sequence;

            if (sequence != OtherPlays && _game?.Status == GameStatus.Live)
            {
                _fieldChosen = false;
                _fieldDrive = null;
            }

            return;
        }

        SelectDrive(sequence);
    }

    /// <summary>
    /// Every drive open at once, so the whole game reads top to bottom without a press per drive.
    /// While it is on a drive's line is a heading rather than a disclosure: there is nothing to fold.
    /// </summary>
    private bool _everyPlay;

    /// <summary>
    /// A game that is on reads newest first, the way it is followed; one that is over reads from
    /// the kickoff down, the way a league's own play-by-play page prints it.
    /// </summary>
    private bool NewestFirst => _game?.Status == GameStatus.Live;

    // ---- The sections --------------------------------------------------------------------

    /// <summary>Which reading is on screen: one at a time, as the Game window's sections are.</summary>
    private enum View { Plays, Scoring, Probability, Box }

    private View _view = View.Plays;

    /// <summary>The sections this game has. Scoring and the probability wait for a play to draw from.</summary>
    private IReadOnlyList<DeskTab<View>> Views() =>
    [
        new(View.Plays, "Plays"),
        new(View.Scoring, "Scoring", _plays.Count > 0),
        new(View.Probability, "Win probability", _series.Count > 0),
        new(View.Box, "Box score")
    ];

    // ---- The drives, drawn ---------------------------------------------------------------

    /// <summary>
    /// The drives under a heading per period, each a disclosure: closed, its result line, where
    /// on the field it ran and the score it left; open, its plays. Newest first while the game is
    /// on, from the kickoff down once it is over (<see cref="NewestFirst"/>). A game the feed wrote
    /// no drives for is one flat list of its plays. A play no drive holds (<see cref="DriveOf"/>)
    /// closes the log as "Other plays", so every play held is in the log, as it is in the scoring
    /// and the chart.
    /// </summary>
    private RenderFragment RenderDrives() => @<text>
        @{
            var newestFirst = NewestFirst;
        }
        @if (_drives.Count == 0)
        {
            @* The play log draws no inset of its own, so the card gives it the rows' inset. *@
            <div class="wgroup">
                <div class="gc__flat">
                    @RenderPlays(newestFirst ? _plays.AsEnumerable().Reverse().ToList() : _plays)
                </div>
            </div>
        }
        else
        {
            var open = OpenDrive;
            var byDrive = _byDrive;
            var others = byDrive.GetValueOrDefault(OtherPlays);
            var headed = new HashSet<int>();
            <div class="wgroup gc__drives">
                @* The card's name and its one switch, in its bar (the Desk's section card). *@
                <div class="wgroup__bar">
                    <h3 class="wgroup__title">Drives</h3>
                    <div class="wgroup__keys">
                        <DeskToggle Label="Every play" Checked="_everyPlay" CheckedChanged="@((bool on) => _everyPlay = on)"
                                    Title="Open every drive, so the whole game reads top to bottom" />
                    </div>
                </div>
                @foreach (var drive in newestFirst ? _drives.Reverse() : _drives)
                {
                    var held = byDrive.GetValueOrDefault(drive.Sequence) ?? [];
                    var isOpen = _everyPlay || open == drive.Sequence;
                    var region = $"gcdrive-{WindowId}-{drive.Sequence}";
                    var sequence = drive.Sequence;
                    var span = DriveSpan(drive, _header?.YardLine);
                    var tally = DriveTally(held);

                    @if (drive.StartPeriod is { } period && headed.Add(period))
                    {
                        <div class="wgroup__row gc__period" role="heading" aria-level="3" @key="@($"period-{period}")">@Periods.Name(_game?.Sport?.Key, period)</div>
                    }

                    <div class="wgroup__row gc__drive @(isOpen ? "gc__drive--open" : null)" @key="drive.Sequence" data-drive="@drive.Sequence">
                        @if (_everyPlay)
                        {
                            <span class="gc__toggle gc__toggle--still">@RenderDriveLead(drive)</span>
                        }
                        else
                        {
                            <button type="button" class="gc__toggle disclosure__summary"
                                    aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@region"
                                    @onclick="() => ToggleDrive(sequence)">
                                <span class="disclosure__triangle" aria-hidden="true"><Glyph Icon="@Icons.Material.Filled.ArrowRight" /></span>
                                @RenderDriveLead(drive)
                            </button>
                        }
                        <span class="gc__drive-trail">
                            @if (span is { } ran)
                            {
                                @* Where on the field the drive ran, away's goal on the left as the
                                   field card has it. The line beside it already says the yards. *@
                                <FieldSpan From="ran.From" Length="ran.Length" Scored="drive.IsScore" />
                            }
                            @if (drive.IsScore)
                            {
                                <Tag State="DeskState.Positive">@(drive.Result ?? "Score")</Tag>
                            }
                            else if (drive.IsCurrent)
                            {
                                <Tag State="DeskState.Warning" Live="true">On the field</Tag>
                            }
                            @if (tally is not null)
                            {
                                <span class="gc__tally @(drive.IsScore ? null : "gc__tally--quiet")">@tally</span>
                            }
                        </span>
                    </div>
                    @if (isOpen)
                    {
                        <div class="wgroup__row gc__plays" id="@region" @key="(drive.Sequence, true)">
                            @if (held.Count == 0)
                            {
                                <span class="dim">No plays held for this drive yet.</span>
                            }
                            else
                            {
                                @RenderPlays(newestFirst ? held.AsEnumerable().Reverse().ToList() : held)
                            }
                        </div>
                    }
                }
                @if (others is { Count: > 0 })
                {
                    var isOpen = _everyPlay || open == OtherPlays;
                    var region = $"gcdrive-{WindowId}-other";
                    var count = others.Count == 1 ? "1 play" : $"{others.Count} plays";
                    <div class="wgroup__row gc__drive @(isOpen ? "gc__drive--open" : null)" @key="OtherPlays" data-drive="other">
                        @if (_everyPlay)
                        {
                            <span class="gc__toggle gc__toggle--still">
                                <span class="gc__result">Other plays · @count filed under no drive</span>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="gc__toggle disclosure__summary"
                                    aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@region"
                                    @onclick="() => ToggleDrive(OtherPlays)">
                                <span class="disclosure__triangle" aria-hidden="true"><Glyph Icon="@Icons.Material.Filled.ArrowRight" /></span>
                                <span class="gc__result">Other plays · @count filed under no drive</span>
                            </button>
                        }
                    </div>
                    @if (isOpen)
                    {
                        <div class="wgroup__row gc__plays" id="@region" @key="(OtherPlays, true)">
                            @RenderPlays(newestFirst ? others.AsEnumerable().Reverse().ToList() : others)
                        </div>
                    }
                }
            </div>
        }
    </text>;

    /// <summary>A drive's side and its result line: the words of its row, in a disclosure or on their own.</summary>
    private RenderFragment RenderDriveLead(GamecastDrive drive) => @<text>
        <span class="gc__team"><TeamMark Sport="@_game?.Sport?.Key" Abbrev="@drive.TeamAbbrev" />@(drive.TeamAbbrev ?? "—")</span>
        <span class="gc__result">@DriveLine(drive)</span>
    </text>;

    /// <summary>
    /// Where a drive ran, as a start and a length in hundredths of the field measured from the
    /// away side's goal line — the field's frame (FieldGeometry), with yard lines counted from the home goal
    /// (<see cref="Game.YardLine"/>). The drive in progress ends where the ball is. Null when
    /// either end is unknown; a drive that went nowhere still draws a mark two yards wide.
    /// </summary>
    public static (double From, double Length)? DriveSpan(GamecastDrive drive, int? ballOn)
    {
        var end = drive.EndYardLine ?? (drive.IsCurrent ? ballOn : null);
        return FieldGeometry.Span(drive.StartYardLine, end);
    }

    /// <summary>The score a drive left, away first as the title has it: "PHI 7–3 WSH". Null until a play of it carries one.</summary>
    private string? DriveTally(List<GamecastPlay> held)
    {
        if (_header is null)
            return null;

        for (var i = held.Count - 1; i >= 0; i--)
        {
            if (held[i] is { AwayScore: { } away, HomeScore: { } home })
                return $"{_header.Away.Abbrev} {away}–{home} {_header.Home.Abbrev}";
        }

        return null;
    }

    /// <summary>Plays in the order given: the shared play log, virtualised past <see cref="VirtualizeAt"/>.</summary>
    private RenderFragment RenderPlays(List<GamecastPlay> plays)
        => @<PlayLog Plays="plays" Sport="@_game?.Sport?.Key" VirtualizeAt="VirtualizeAt" Fresh="_freshPlay" HomeAbbrev="@_header?.Home.Abbrev" AwayAbbrev="@_header?.Away.Abbrev" Game="_plays" />;

    /// <summary>
    /// A drive closed to one line: "7 plays, 62 yds, 3:48 · Touchdown". Plays are the provider's
    /// offensive count (it leaves out penalties and kicks); a figure ESPN did not send is left out.
    /// </summary>
    public static string DriveLine(GamecastDrive drive)
    {
        var line = DriveFigures(drive) ?? "No plays yet";
        var result = drive.IsCurrent && string.IsNullOrWhiteSpace(drive.Result) ? "In progress" : drive.Result;

        return string.IsNullOrWhiteSpace(result) ? line : $"{line} · {result}";
    }

    /// <summary>
    /// A drive's figures without its result: "7 plays, 75 yds, 4:02" — the front of
    /// <see cref="DriveLine"/>, and a scoring row's second line, where the headline already says
    /// what the drive came to. Null when ESPN sent none of the three.
    /// </summary>
    public static string? DriveFigures(GamecastDrive drive)
    {
        var parts = new List<string>(3);

        if (drive.OffensivePlays is { } n)
            parts.Add(n == 1 ? "1 play" : $"{n} plays");
        if (drive.Yards is { } y)
            parts.Add($"{y} yds");
        if (!string.IsNullOrWhiteSpace(drive.TimeElapsed))
            parts.Add(drive.TimeElapsed!);

        return parts.Count == 0 ? null : string.Join(", ", parts);
    }

    // ---- Scoring -------------------------------------------------------------------------

    private RenderFragment RenderScoring() => @<text>
        @{
            var scoring = _plays.Where(p => p.IsScoring).ToList();
        }
        @if (scoring.Count == 0)
        {
            <EmptyState>No score yet.</EmptyState>
        }
        else
        {
            var onField = FieldSequence;
            <div class="wgroup">
                @foreach (var play in scoring)
                {
                    var driveSeq = DriveKeyOf(play);
                    var drive = driveSeq == OtherPlays ? null : _driveBySequence.GetValueOrDefault(driveSeq);
                    @if (drive is not null)
                    {
                        @* Pressing a score is choosing its drive, as the chart and the log choose
                           one: the field replays it and the log opens it. A real button, so Tab
                           reaches it and Enter or Space presses it; pressed while its drive is on
                           the field. *@
                        var sequence = drive.Sequence;
                        <button type="button" class="wgroup__row gc__score gc__score--press" @key="play.Id"
                                aria-pressed="@(onField == sequence ? "true" : "false")"
                                @onclick="() => SelectDrive(sequence)">
                            @RenderScoreRow(play, drive)
                        </button>
                    }
                    else
                    {
                        <div class="wgroup__row gc__score" @key="play.Id">
                            @RenderScoreRow(play, null)
                        </div>
                    }
                }
            </div>
        }
    </text>;

    /// <summary>
    /// One score: when, the side, then its headline over ESPN's sentence and the drive's figures,
    /// and the score it left — the play log's order, so the two tabs read alike.
    /// </summary>
    private RenderFragment RenderScoreRow(GamecastPlay play, GamecastDrive? drive) => @<text>
        <span class="gc__when">@PlayLog.When(_game?.Sport?.Key, play)</span>
        <span class="gc__team"><TeamMark Sport="@_game?.Sport?.Key" Abbrev="@TeamAbbrev(play.TeamId)" />@TeamAbbrev(play.TeamId)</span>
        <span class="gc__scorebody">
            @if (PlayHeadline.For(play) is { } headline)
            {
                <span class="gc__headline">@headline</span>
            }
            <span class="gc__text">@(play.Text ?? play.Type)</span>
            @if (drive is not null && DriveFigures(drive) is { } figures)
            {
                <span class="gc__scoredrive">@figures</span>
            }
        </span>
        @if (play.AwayScore is { } a && play.HomeScore is { } h)
        {
            <span class="gc__tally">@_header!.Away.Abbrev @a–@h @_header.Home.Abbrev</span>
        }
    </text>;

    private string TeamAbbrev(int? teamId)
        => teamId == _header?.Home.Id ? _header!.Home.Abbrev
            : teamId == _header?.Away.Id ? _header!.Away.Abbrev
            : string.Empty;

    // ---- Win probability -----------------------------------------------------------------

    private bool _showCover;
    private bool _showOver;

    // Rebuilt only when the plays or the toggles change: DeskChart redraws on a new reference.
    private List<ChartSeries<double>> _series = [];
    private string[] _labels = [];

    private void ShowSeries(bool? cover = null, bool? over = null)
    {
        _showCover = cover ?? _showCover;
        _showOver = over ?? _showOver;
        RebuildChart();
    }

    /// <summary>
    /// The probability line over play sequence, in percent, with its references.
    ///
    /// <para>
    /// A play the provider gave no probability for carries the last real reading forward; a
    /// series with no reading at all is not drawn. Nothing is drawn before a series' first
    /// reading: DeskChart draws no gaps and every series shares the x axis from its first point,
    /// so the chart starts at the first play where every series shown has read. With the cover
    /// and over off, that is the first win reading.
    /// </para>
    ///
    /// <para>
    /// Two flat references, because DeskChart has no reference-line API and is app-neutral: the
    /// home side's pre-game win probability (the first reading the provider gave, at kickoff),
    /// drawn beside the win line; and, while the cover or the over is shown, the even line at 50%
    /// they are read against. The close itself stays named in the caption.
    /// </para>
    /// </summary>
    private void RebuildChart()
    {
        var points = _plays
            .Where(p => p.HomeWinPct is not null || p.SpreadCoverPctHome is not null || p.TotalOverPct is not null)
            .ToList();

        var home = _header?.Home.Abbrev ?? "Home";

        var win = $"{home} win";
        var lines = new List<(string Name, Func<GamecastPlay, double?> Read)> { (win, p => p.HomeWinPct) };
        if (_showCover)
            lines.Add(($"{home} cover", p => p.SpreadCoverPctHome));
        if (_showOver)
            lines.Add(("Over", p => p.TotalOverPct));

        lines.RemoveAll(l => points.All(p => l.Read(p) is null));

        var start = lines.Count == 0 ? 0 : lines.Max(l => points.FindIndex(p => l.Read(p) is not null));
        var shown = points.Skip(start).ToList();

        var series = new List<ChartSeries<double>>();

        foreach (var (name, read) in lines)
        {
            // Carried from the start of the game, so a series whose first reading came before the
            // chart's first point starts from that reading, not from nothing.
            double? carried = null;
            var values = points
                .Select(p => carried = read(p) ?? carried)
                .Skip(start)
                .Select(v => Math.Round(v!.Value * 100, 1))
                .ToArray();

            series.Add(new ChartSeries<double> { Name = name, Data = values });

            if (name == win && PreGameWin() is { } pregame)
                series.Add(Flat($"{home} pre-game", pregame));
        }

        if (lines.Any(l => l.Name != win))
            series.Add(Flat(EvenSeries, 0.5));

        _series = series;
        _labels = shown
            .Select((p, i) => i == 0 || p.Period != shown[i - 1].Period ? (p.Period is { } n ? Periods.Mark(_header?.SportKey, n) : null) ?? string.Empty : string.Empty)
            .ToArray();

        ChartSeries<double> Flat(string name, double value)
            => new() { Name = name, Data = Enumerable.Repeat(Math.Round(value * 100, 1), shown.Count).ToArray() };
    }

    /// <summary>
    /// The home side's chance before a play had moved it: the provider's first reading. The header
    /// carries no pre-game probability of ESPN's own, so this is the honest stand-in; with no
    /// reading there is no line.
    /// </summary>
    private double? PreGameWin() => _plays.FirstOrDefault(p => p.HomeWinPct is not null)?.HomeWinPct;

    /// <summary>"WSH 64% to win", from the last reading.</summary>
    private string? ChartHeadline()
    {
        var last = _plays.LastOrDefault(p => p.HomeWinPct is not null)?.HomeWinPct;
        if (last is not { } win || _header is null)
            return null;

        return win >= 0.5
            ? $"{_header.Home.Abbrev} {win * 100:0}% to win"
            : $"{_header.Away.Abbrev} {(1 - win) * 100:0}% to win";
    }

    /// <summary>
    /// The pre-game market, named under the chart: "Closed PHI -3, total 44.5". The chart draws
    /// the pre-game win probability and the even line as its references (see RebuildChart); the
    /// close is a spread and a total, not a probability, so it is said rather than drawn. The
    /// spread is named for the favourite, as a book prints it. "Priced" before the start, when the number is still the scan.
    /// </summary>
    public static string? CloseCaption(GamecastHeader header)
    {
        if (header.Close is not { } close)
            return null;

        var parts = new List<string>(2);

        if (close.HomeSpread is { } spread)
        {
            parts.Add(spread switch
            {
                < 0 => $"{header.Home.Abbrev} {spread.ToString("0.#", CultureInfo.InvariantCulture)}",
                > 0 => $"{header.Away.Abbrev} -{spread.ToString("0.#", CultureInfo.InvariantCulture)}",
                _ => "pick'em"
            });
        }

        if (close.Total is { } total)
            parts.Add($"total {total.ToString("0.#", CultureInfo.InvariantCulture)}");

        return parts.Count == 0 ? null : $"{(close.IsClosing ? "Closed" : "Priced")} {string.Join(", ", parts)}";
    }

    // ---- The clock -----------------------------------------------------------------------

    /// <summary>One clock reading: the period, the seconds left in it, and when the feed read them.</summary>
    public sealed record ClockReading(int? Period, int Seconds, DateTimeOffset At)
    {
        public static ClockReading? Of(Game game)
            => game.ClockSeconds is { } seconds && game.LiveUpdatedAt is { } at ? new(game.Period, seconds, at) : null;
    }

    // The last two readings, for whether the clock is running (see ClockRun).
    private ClockReading? _reading;
    private ClockReading? _previousReading;

    private ElementReference _clockEl;
    private bool _clockStarted;
    private Task<IJSObjectReference>? _import;
    private bool _disposing;

    /// <summary>Whether the title is drawing the clock tag this render, so there is an element to hand the browser.</summary>
    private bool ClockShown => _game is not null && ClockParts(_game).Clock is not null;

    /// <summary>
    /// Hands the browser the clock after a render that drew a new reading (gameclock.js, once per
    /// <see cref="ClockKey"/>), and never in prerender —
    /// there is no browser to hand it to. Whether it runs, from where and for how long is
    /// <see cref="ClockRun"/>'s.
    ///
    /// <para>
    /// The import is held as a task: a window closed while it is in flight disposes the module
    /// when it arrives (<see cref="DisposeAsync"/>) rather than leaking it.
    /// </para>
    ///
    /// <para>
    /// Nothing the browser says here escapes: an exception out of this method ends the whole
    /// desk circuit, and a clock that does not tick is the lesser loss. An import that failed is
    /// let go so a later render may ask once more (<see cref="ClockImportAttempts"/>), and after
    /// that the clock is given up quietly; the tag still shows the server's reading.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || _disposing || !ClockShown || _game is null)
            return;

        if (_import is null && _clockImports >= ClockImportAttempts)
            return;

        var game = _game;
        var previous = _previousReading;
        var element = _clockEl;

        // Handed once per reading: a render that changes nothing about the clock — a play
        // appended, a drive opened — leaves the browser counting from the reading it has. The same
        // reading drawn again draws the same text, which the renderer leaves alone, so the tick
        // the browser wrote stays.
        var reading = new ClockKey(game.Status, game.StatusDetail, game.Period, game.ClockSeconds, game.DisplayClock,
            game.LiveUpdatedAt, previous?.At, element.Id);
        if (reading == _clockHanded)
            return;

        try
        {
            if (_import is null)
            {
                _clockImports++;
                _import = JS.InvokeAsync<IJSObjectReference>("import", "./js/gameclock.js").AsTask();
            }

            var module = await _import;

            if (_disposing)
                return;

            var (seconds, running, limit) = ClockRun(game, previous, Now);
            await module.InvokeVoidAsync("startClock", element, seconds, running, limit);
            _clockStarted = true;
            _clockHanded = reading;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
                                       or TaskCanceledException or ObjectDisposedException)
        {
            // A faulted import cached would fail every render after; let it go so one more may try.
            if (_import is { IsCompleted: true, IsCompletedSuccessfully: false })
                _import = null;

            Log.LogDebug(ex, "Gamecast {GameId}: the browser clock did not start; the tag shows the server's reading", GameId);
        }
    }

    /// <summary>Everything the browser's clock is started from: a new value of any is a new reading to hand it.</summary>
    private readonly record struct ClockKey(
        GameStatus Status, string? Detail, int? Period, int? Seconds, string? Display,
        DateTimeOffset? At, DateTimeOffset? PreviousAt, string? Element);

    /// <summary>The reading last handed to the browser; null until one has been, and kept only when it took.</summary>
    private ClockKey? _clockHanded;

    /// <summary>Imports of gameclock.js a window asks for before it gives the ticking clock up.</summary>
    private const int ClockImportAttempts = 2;

    private int _clockImports;

    /// <summary>
    /// What the browser's clock starts from, whether it runs, and for how many seconds at most.
    ///
    /// <para>
    /// ESPN does not say whether the clock is running, so the last two readings are asked: it
    /// runs only when the seconds dropped between them by about the wall-clock time between
    /// them (within <see cref="ClockTolerance"/>), in one period. A reading that repeats the
    /// last one's seconds is a stopped clock; one reading alone says nothing. A live game, a
    /// period not over, and a reading under <see cref="ClockRunsFor"/> old, besides.
    /// </para>
    ///
    /// <para>
    /// It starts from the reading less its age and may run for what is left of
    /// <see cref="ClockRunsFor"/>, never past 0:00. So the title's tag may run ahead of the rail
    /// chip — which reports the server's reading, as every pulse does — by at most that bound,
    /// and the next reading puts the two back together. That disagreement is accepted: the chip
    /// is a status line, redrawn on each notice, and cannot tick.
    /// </para>
    /// </summary>
    public static (int Seconds, bool Running, int Limit) ClockRun(Game game, ClockReading? previous, DateTimeOffset now)
    {
        var seconds = game.ClockSeconds ?? 0;
        var stopped = (seconds, false, 0);

        if (game.Status != GameStatus.Live || seconds <= 0 || IsBreak(game) || game.LiveUpdatedAt is not { } at)
            return stopped;

        if (previous is null || previous.Period != game.Period || previous.At >= at)
            return stopped;

        var drop = previous.Seconds - seconds;
        var between = (at - previous.At).TotalSeconds;
        if (drop <= 0 || Math.Abs(drop - between) > ClockTolerance.TotalSeconds)
            return stopped;

        var age = now - at;
        if (age < TimeSpan.Zero)
            age = TimeSpan.Zero;

        if (age >= ClockRunsFor)
            return stopped;

        var left = Math.Max(0, seconds - (int)age.TotalSeconds);
        if (left == 0)
            return (0, false, 0);

        return (left, true, Math.Min((int)(ClockRunsFor - age).TotalSeconds, left));
    }

    public async ValueTask DisposeAsync()
    {
        _disposing = true;
        Dispose();

        if (_import is not { } import)
            return;

        // Still in flight: dispose the module when it arrives, without holding the window's
        // disposal open on the browser.
        if (!import.IsCompleted)
        {
            _ = ReleaseAsync(import, stop: false);
            return;
        }

        await ReleaseAsync(import, _clockStarted);
    }

    private async Task ReleaseAsync(Task<IJSObjectReference> import, bool stop)
    {
        try
        {
            var module = await import;
            if (stop)
                await module.InvokeVoidAsync("stopClock", _clockEl);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (JSException)
        {
            // The import itself failed: there is no module to release.
        }
    }
}
