@using XLines.Data
@using XLines.Data.CrossReference
@using XLines.Web.Components.Snippets
@using XLines.Desk.Windowing
@using XLines.Web.Services
@inherits PanelBase

@*
    Line movement: how one side of a market moved at each book, a row per book.

    It used to be a chart of every book and both sides at once — eight lines for two books
    and a moneyline, each side the mirror of the other in probability, told apart by a palette
    and a legend that drew itself over the table beneath — and then that table again, with
    the latest prices the chart had just drawn. Apple's charting guidance is to keep a chart
    simple and let people choose the detail, to use a small chart for glanceable information
    about one item, and to put data in a table where nobody is being asked to analyse it. So
    the window shows one side at a time, because the other side is its mirror, and the rows
    are the representation: each book's open, where it is now, the move between them, when it
    last moved, and a sparkline of the path, on one time axis shared down the column so a move
    that hit every book in the same hour lines up.
*@

<PanelToolbar>
    <ChildContent>
    @* The games with moves on record — the ones this window can show. Scans are kept until
       first pitch and then folded into one closing line (ADR 0010), so every game ahead of
       us with a price on file is in this list. It is the only game control: the search that
       sat beside it named the same game a second time, cut off at the window's edge. A game
       opened from elsewhere and not in the list is added to it, so the select always names
       the game the rows are about.

       Each option leads with its day (GameOption). Capped at 280px, the select cut
       "Dallas Cowboys at Philadelphia Eagles — Oct 26" after the dash, so the picker read as a
       matchup trailing a stray dash and never showed the date that tells a series apart. It
       now takes the width its longest option asks, up to the toolbar's; a window narrower than
       that still clips, but at the end of the home club's name rather than mid-separator. *@
    <DeskSelect TValue="int?" aria-label="Game" Class="odds-game"
                disabled="@(_games.Count == 0 && _picked is null)"
                Value="@(Listed(_gameId) ? _gameId : null)" ValueChanged="OnGameChanged">
        <option value="">@(_games.Count == 0 ? "No game has moves on record" : "Games with moves…")</option>
        @if (_picked is { } picked && !_games.Any(g => g.Id == picked.Id))
        {
            <option value="@picked.Id">@GameOption(picked)</option>
        }
        @foreach (var g in _games)
        {
            <option value="@g.Id">@GameOption(g)</option>
        }
    </DeskSelect>
    </ChildContent>

    @* The view's own switches, on the toolbar's row beside the game, as the Board's scope
       pickers are. They had a row of their own: before the toolbar could fold, a window beside
       the Board ran out of row, the game was cut off and the side switch fell past the edge. Now
       they are the row's Overflow, so a narrow window folds them into More, each with its label,
       and the game stays on the row. *@
    <Overflow>
        <div class="ptoolbar__item">
            <span class="ptoolbar__label" aria-hidden="true">Market</span>
            <DeskSwitch Options="_marketOptions" Label="Market"
                        Value="_market" ValueChanged="@((string market) => SetMarketAsync(market))" />
        </div>

        @* The market's two outcomes, away first as the matchup reads, Over before Under. One at a
           time: a price that shortens on one side drifts on the other, so showing both doubles
           the rows and says nothing the first half did not. Built from the stored outcomes, so a
           market priced on one side offers no switch, and More no label with nothing beside it. *@
        @if (_sideOptions.Count > 1)
        {
            <div class="ptoolbar__item">
                <span class="ptoolbar__label" aria-hidden="true">Side</span>
                <DeskSwitch TValue="string" Options="_sideOptions" Label="Side"
                            Value="_side" ValueChanged="@((string side) => SetSide(side))" />
            </div>
        }
    </Overflow>

    @* The Board's pull menu, here too: a price moves only when lines are pulled (polling is
       Manual by default), so the window that shows prices standing still offers what would move
       them — every entry with its cost, and a metered one asking first. The standing view's Pull
       key presses this menu rather than running anything itself. Drawn once the window has
       loaded, as the rest of its body is. *@
    <Actions>
        @if (Loaded)
        {
            <DeskJobMenu @ref="_pull" Label="Pull data" Icon="@DeskIcons.CloudDownload" OnRan="LoadAsync" />
        }
    </Actions>
</PanelToolbar>

@* The failure line sits above whatever the window already holds, as the Board's does: Line
   movement refreshes on every odds signal, and one refresh that failed must not take the rows
   the operator was reading. Before the first load the window holds its shape — the headline
   and the first books' rows, where they will land — because "No stored prices" said there was
   nothing on record while the window was still asking, and a load that failed said it too. *@
@if (Failed)
{
    <PanelLoadFailure Message="@LoadError" OnRetry="RetryAsync" />
}
else if ((!Loaded && !_movesIn) || _turning)
{
    @* Turned to another game (_turning), as before the first load: the last game's rows are
       not this one's, and "No stored prices" is not known yet. *@
    <DeskSkeleton Width="40%" />
    <DeskGrid T="MovementRow" Items="@(Array.Empty<MovementRow>())" Loading="true" SkeletonRows="4"
              LoadingLabel="Fetching the line's moves" />
}

@* Line watch (ADR 0029): the window follows what is pressed on the Board, and says what. Before
   anything is pressed it picks nothing — a game nobody chose, shown as if it were the choice,
   was the complaint — and shows the slate's overview instead. *@
@if (Loaded && Overview)
{
    <section class="slatewatch" aria-label="The slate today">
        <p class="slatewatch__prompt">Press a game or a price on the Board to follow it here.</p>

        @if (_slate.Moves.Count > 0)
        {
            @* The list is one card with its name in its bar (ADR 0032): the name stood above the box
               as a grey heading, nearer the prompt than the rows it named. *@
            <div class="wgroup slatewatch__list">
                <div class="wgroup__bar"><h3 class="wgroup__title slatewatch__title">Biggest moves today</h3></div>
                @foreach (var move in _slate.Moves)
                {
                    var m = move;
                    <button type="button" class="slatewatch__row" @onclick="() => FollowAsync(m.Game, m.Market, m.Row.Now.Outcome)"
                            aria-label="@MoveLabel(m)">
                        <span class="slatewatch__game">
                            <span class="slatewatch__matchup">@Matchup(m.Game)</span>
                            <span class="slatewatch__detail">@SelectionText.MarketWord(m.Market) · @SideLabel(m.Row.Now.Outcome) · @BookNames.Display(m.Row.Book)</span>
                        </span>
                        <span class="slatewatch__move num">
                            <span>@Quote(m.Row.Open) → @Quote(m.Row.Now)</span>
                            <span class="slatewatch__size">@MoveText(m.Row)</span>
                        </span>
                    </button>
                }
            </div>
        }
        else
        {
            <p class="slatewatch__none">Nothing on the slate has moved today.</p>

            @if (_slate.Next.Count > 0)
            {
                <div class="wgroup slatewatch__list">
                    <div class="wgroup__bar"><h3 class="wgroup__title slatewatch__title">Next games</h3></div>
                    @foreach (var game in _slate.Next)
                    {
                        var g = game;
                        <button type="button" class="slatewatch__row" @onclick="() => FollowAsync(g, null, null)"
                                aria-label="@($"Follow {Matchup(g)}, {DisplayTime.Stamp(g.StartsAt)}")">
                            <span class="slatewatch__game">
                                <span class="slatewatch__matchup">@Matchup(g)</span>
                                <span class="slatewatch__detail">@g.Sport?.Key.ToUpperInvariant()</span>
                            </span>
                            <span class="slatewatch__move num">@DisplayTime.Stamp(g.StartsAt)</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="slatewatch__none">No game starts in the next two days.</p>
            }
        }
    </section>
}
else
{
@if (Loaded && Watching && _picked is { } followed)
{
    @* What is being followed, in words, and the way back to the overview. *@
    <div class="slatewatch__following" role="status">
        <span class="slatewatch__following-text">
            Following <strong>@Matchup(followed)</strong> · @SelectionText.MarketWord(_market)@(_side is { } side ? $" · {SideLabel(side)}" : "")
        </span>
        <DeskButton Size="DeskKeySize.Small" Icon="@DeskIcons.ArrowBack" OnClick="ShowOverviewAsync">
            Overview
        </DeskButton>
    </div>
}

@* The market's standing and the clubs' form, each at a table's reading width (.oddswin): one
   column of 720px, at the leading edge, and side by side once the window holds two. Maximised,
   the form's tables ran the whole 1600px window — the player at the far left, his numbers a
   screen away — under a 720px column of prices with the rest of the window empty beside it. *@
<div class="oddswin">
<div class="oddswin__cols">
@if (_rows.Count == 0)
{
    @* An empty result means "nothing here" only once there has been a result, and only while
       the last read did not fail. *@
    @if (Loaded && !Failed && !_turning)
    {
        <EmptyState Kind="EmptyStateKind.Filtered">
            No stored prices for this game and market. Try another market, or open the game: once
            it starts, its moves are folded into one closing line, which the Game window shows.
        </EmptyState>
    }
}
else
{
    @* The finding first, then the span it was found over (HIG charts: summarise the main
       message before the detail). The headline is about the side in focus, the same rows
       the table shows, so the sentence and the rows never disagree about who moved. *@
    <div class="movement">
        <div class="movement__cap">
            @* The side in focus leads with its club's crest when the side is a club: a total's Over
               and Under name none, and a bout's fighters carry none. *@
            <p class="movement__headline">
                @if (_market != Markets.Total && Club(_side) is { } club)
                {
                    <TeamMark Sport="@CrestSport" Abbrev="@club.Abbrev" Size="TeamMarkSize.Small" />
                }
                @_headline
            </p>
            <p class="movement__span">@_span</p>
        </div>

        @* Where the side stands now — the fair price, each side's best, the last change on record,
           and what could move it next — read from the board's row for this game. A side nobody
           has moved shows each book's standing in place of the movement columns, which would be
           "unmoved" and "seen once" in every row. *@
        <PriceStanding Rows="_rows" Side="@SideOffer" Other="@OtherOffer"
                       SideName="@SideName(_side)" OtherName="@SideName(OtherSide)"
                       ShowBooks="@(!AnyMoves)" Expanded="@_expanded.Contains(_market)" ExpandedChanged="@((bool open) => SetExpanded(open))" Closing="@(_board?.PricesAreClosing == true)"
                       Scheduled="@(_scheduled == true)"
                       PullLabel="@PullLabel" PullUnavailable="@PullUnavailable" OnPull="PullAsync" Polled="_polled" />

        @if (AnyMoves)
        {
        @* Ranked on the whole market, as every book table on the desk is (BookRanking): the main
           sportsbooks lead in their fixed order, then the rest by best price and lowest hold, and
           those are behind the More chip under the grid. It opened sorted by book name; a heading
           still sorts the rows showing. *@
        <div class="oddsbooks" id="@_booksId">
        <DeskGrid T="MovementRow" Items="BookRanking.Visible(BookRanking.Order(_rows, r => r.Book, SideOffer, OtherOffer), r => r.Book, _expanded.Contains(_market))" Resizable="false" EmptyText="No prices on this side.">
            @* The book by its name, as Every book names it: the feed's key ("draftkings") is
               for joining rows, not for reading. *@
            @* Every value here holds one line; the trend takes what is left, so the book's name
               and its figures never break while the sparkline has room to draw its path. *@
            <DeskColumn T="MovementRow" TProperty="string" Property="r => r.Book" Title="Book"
                            HeaderClass="ops-col--fit" CellClass="ops-col--fit">
                <CellTemplate>@BookNames.Display(context.Item.Book)</CellTemplate>
            </DeskColumn>

            @* No colour and no axis: the numbers are in the next cells, and the shape only has
               to say which way and when. A book seen once draws a dash, not a flat line. *@
            <DeskTemplateColumn T="MovementRow" Title="Trend" Sortable="false" HeaderClass="ops-col--grow" CellClass="ops-col--grow">
                <CellTemplate>
                    <DeskSparkline Values="context.Item.Trend" Positions="context.Item.Positions" Step="true"
                                   Label="@TrendLabel(context.Item)" />
                </CellTemplate>
            </DeskTemplateColumn>

            <DeskTemplateColumn T="MovementRow" Title="Open" Align="Align.Right" Sortable="true"
                            SortBy="@(r => Rank(r.Open))" HeaderClass="col--wide ops-col--fit" CellClass="col--wide ops-col--fit">
                <CellTemplate>
                    @* When the open was seen is a tooltip on a trigger that takes focus, not a title
                       only a pointer raises (HIG 12). *@
                    <DeskTooltip Text="@OpenedTooltip(context.Item)">
                        <span class="dim movement__quote" tabindex="0">@Quote(context.Item.Open)</span>
                    </DeskTooltip>
                </CellTemplate>
            </DeskTemplateColumn>

            @* Sorting on the current number is how you find the best one across books. *@
            <DeskTemplateColumn T="MovementRow" Title="Now" Align="Align.Right" Sortable="true"
                            SortBy="@(r => Rank(r.Now))" HeaderClass="ops-col--fit" CellClass="ops-col--fit">
                <CellTemplate>
                    <span class="movement__quote">@Quote(context.Item.Now)</span>
                </CellTemplate>
            </DeskTemplateColumn>

            @* The arrow is the direction the number moved as it is written, the same way the
               sparkline draws it, and nothing more: the ink is neutral because a price moving
               is not good or bad. The tooltip says it in words — shortened or drifted. *@
            <DeskTemplateColumn T="MovementRow" Title="Move" Align="Align.Right" Sortable="true"
                            SortBy="@(r => MoveSize(r))" HeaderClass="ops-col--fit" CellClass="ops-col--fit">
                <CellTemplate>
                    <DeskTooltip Text="@MoveTitle(context.Item, _market)">
                        <span class="movement__move @(context.Item.Moved ? null : "dim")" tabindex="0">@MoveText(context.Item)</span>
                    </DeskTooltip>
                </CellTemplate>
            </DeskTemplateColumn>

            <DeskTemplateColumn T="MovementRow" Title="Last moved" Align="Align.Right" Sortable="true"
                            SortBy="@(r => r.LastMoved ?? DateTimeOffset.MinValue)"
                            HeaderClass="col--wide ops-col--fit" CellClass="col--wide ops-col--fit">
                <CellTemplate>
                    @if (context.Item.LastMoved is { } at)
                    {
                        <DeskTooltip Text="@($"Last moved {DisplayTime.Stamp(at)}")">
                            <span class="dim" tabindex="0">@Ago(at, DateTimeOffset.UtcNow)</span>
                        </DeskTooltip>
                    }
                    else
                    {
                        @* Said in the cell: the dash meant it, but only to a pointer. When it was
                           seen is the Open cell's tooltip. *@
                        <span class="dim">seen once</span>
                    }
                </CellTemplate>
            </DeskTemplateColumn>
        </DeskGrid>
        <MoreBooks Books="_rows.Select(r => r.Book)" First="SideOffer" Second="OtherOffer" Expanded="@_expanded.Contains(_market)" ExpandedChanged="@((bool open) => SetExpanded(open))" Controls="@_booksId"
                   Polled="_polled" />
        </div>
        }
    </div>
}

@*
    The cross-reference. Odds say what the market thinks; these say what actually happened.
    Read live from the stats history by reference — nothing here is copied onto the odds tier,
    because form changes daily and a stored copy would go stale without saying so.

    Read in the same load as the moves, so it waits for that load: before the first one lands
    "Select a game" was the answer to a question the window was still asking.
*@

@* Only with something to cross-reference. An empty roster read under a line's standing was a
   second empty state about a different question, and pushed the window's one useful finding
   — where the price stands — into competition with "no appearances on record". The Form window
   and the Board row's Form glance answer it, and say how to fill it. *@
@if (Loaded && _form is { IsEmpty: false })
{
<PanelSection Title="Recent form">

@{ var form = _form!;

    <DeskRow>
        <DeskSwitch Options="GateOptions.LookbackDays" Label="Lookback window" Mono="true"
                    Value="_windowDays" ValueChanged="@((int days) => SetWindowAsync(days))" />
        <span class="meta">
            @form.LinesRead.ToString("N0") stat @(form.LinesRead == 1 ? "line" : "lines") read by reference
        </span>
    </DeskRow>

    @* Each club's roster a card with its name in the bar, as the Game window's players are
       (.gameroster's cards): a grey line over a bare table was a name floating above its box. *@
    <div class="oddsform">
        @RenderSide(form.Away, form.Game.AwayTeam?.Name ?? "Away", form.Game.AwayTeam)
        @RenderSide(form.Home, form.Game.HomeTeam?.Name ?? "Home", form.Game.HomeTeam)
    </div>
}
</PanelSection>
}
</div>
</div>
}

@code {
    // The Razor template the markup draws; the rest of the component is in OddsPanel.razor.cs
    // (parameters, aim and Line watch), OddsPanel.Loading.cs (the reads and what they hand over)
    // and OddsPanel.Movement.cs (the movement as data, and its words).

    private RenderFragment RenderSide(IReadOnlyList<PlayerForm> side, string teamName, Team? team) => @<text>
        @if (side.Count > 0)
        {
            @* Each roster under its club's name and crest. The crest is drawn only where the form
               is about the game the window holds, which is where its sport is known. *@
            <PanelSection>
            <TitleContent>
                @if (CrestSport is { } sport && _picked?.Id == _form?.Game.Id && team is not null)
                {
                    <TeamMark Sport="@sport" Abbrev="@team.Abbrev" Size="TeamMarkSize.Small" />
                }
                @teamName
            </TitleContent>
            <ChildContent>
            <XLines.Web.Components.Snippets.RosterTable Side="side" MaxColumns="5" ShowLastPlayed="true" GrowName="true" />
            </ChildContent>
            </PanelSection>
        }
    </text>;
}
