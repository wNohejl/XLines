@using XLines.Core.Analytics
@using XLines.Data.Gamecast

@*
    A list of plays, as a league's play-by-play prints them: when, then the down and the spot
    over what happened, then what it was worth. A scoring play's words carry the weight.

    A football play leads with its headline (PlayHeadline: "16-yard pass", "Punt, 48 yards"),
    as NFL.com's Game Center heads each play, so the log scans down its first words and ESPN's
    sentence stays beneath for the detail. Only football: the headline table is the NFL's types,
    and another league's "End Period" is not a quarter. A play with nothing worth heading draws
    no headline, and its row is the down and the sentence as before.

    The order is the caller's — newest first for a game that is on, from the kickoff down for one
    that is over — and so is the grouping: the Gamecast gives it one drive at a time, or every
    play of a game the feed wrote no drives for. Each row is keyed by the play's id, so a play
    appended is an insert and a play corrected is its own row redrawn, never a rewrite of the list.
    Past VirtualizeAt rows the list is virtualised.

    A play that moved the home side's win probability five points or more from the play before it
    in the game ends its row with the swing, from the side that gained ("WSH +14"), and the same in
    words for a reader who cannot see it; nothing where either play holds no probability.
*@

<ol class="gc__log">
    @if (Plays.Count > VirtualizeAt)
    {
        @* SpacerElement: inside an <ol> the spacers must be list items too. ItemSize is a headed
           play of one line at the standard density: --space-2 above and below (16), the headline
           and the sentence at subheadline (12px × 1.45, twice), the down at footnote (11px × 1.45)
           and the hairline (1) — 68. A sentence that wraps is taller; Virtualize measures the rows
           it draws and only estimates the ones it has not. *@
        <Virtualize Items="Plays" Context="play" ItemSize="68" SpacerElement="li">
            @Row(play)
        </Virtualize>
    }
    else
    {
        @foreach (var play in Plays)
        {
            @Row(play)
        }
    }
</ol>

@code {
    /// <summary>The plays, in the order they are to be read.</summary>
    [Parameter, EditorRequired] public ICollection<GamecastPlay> Plays { get; set; } = [];

    /// <summary>The league's key, for how a period is marked beside the clock.</summary>
    [Parameter] public string? Sport { get; set; }

    /// <summary>Past this many rows the list is virtualised.</summary>
    [Parameter] public int VirtualizeAt { get; set; } = 150;

    /// <summary>
    /// The id of the play that has just landed, null when none has since the window opened: its row
    /// is marked (gc__play--new), and under reduced motion — where the field's arc does not draw
    /// itself in — briefly washed, so the eye still finds what changed.
    /// </summary>
    [Parameter] public long? Fresh { get; set; }

    /// <summary>The home side's short name, for whom a swing in its favour is told.</summary>
    [Parameter] public string? HomeAbbrev { get; set; }

    /// <summary>The away side's short name.</summary>
    [Parameter] public string? AwayAbbrev { get; set; }

    /// <summary>
    /// Every play of the game, in any order, so a swing is measured from the play before in the
    /// game — a drive's first play from the last of the drive before it — rather than from the play
    /// before in <see cref="Plays"/>. Null measures within <see cref="Plays"/>, by sequence.
    /// </summary>
    [Parameter] public IReadOnlyCollection<GamecastPlay>? Game { get; set; }

    /// <summary>A move in the home side's win probability this large or larger (a fraction of one) is told on its play.</summary>
    public const double SwingAt = 0.05;

    /// <summary>The plays that swung the win probability, by id: the move in the home side's favour, in points.</summary>
    private Dictionary<long, int> _swings = [];

    // Measured on every set: a game's few hundred plays sort in no time, and a list the caller
    // appends to in place would leave a cached measure behind.
    protected override void OnParametersSet()
        => _swings = Swings(Game ?? (IEnumerable<GamecastPlay>)Plays);

    /// <summary>
    /// Every play whose home win probability moved <see cref="SwingAt"/> or more from the play
    /// before it in sequence, both of them holding one; the move in rounded points, home's way.
    /// </summary>
    public static Dictionary<long, int> Swings(IEnumerable<GamecastPlay> plays)
    {
        var swings = new Dictionary<long, int>();
        GamecastPlay? previous = null;

        foreach (var play in plays.OrderBy(p => p.Sequence))
        {
            if (previous?.HomeWinPct is { } before && play.HomeWinPct is { } after
                && Math.Abs(after - before) >= SwingAt - 1e-9)
            {
                swings[play.Id] = (int)Math.Round((after - before) * 100, MidpointRounding.AwayFromZero);
            }

            previous = play;
        }

        return swings;
    }

    /// <summary>Who gained, and by how many points.</summary>
    private (string Side, int Points) SwingOf(int homePoints)
        => homePoints > 0
            ? (string.IsNullOrWhiteSpace(HomeAbbrev) ? "Home" : HomeAbbrev, homePoints)
            : (string.IsNullOrWhiteSpace(AwayAbbrev) ? "Away" : AwayAbbrev, -homePoints);

    /// <summary>Whether the plays are football's, the only league whose plays are headed.</summary>
    private bool Football => Sport is "nfl" or "ncaaf";

    private RenderFragment Row(GamecastPlay play) => @<text>
        <li class="gc__play @(play.IsScoring ? "gc__play--score" : null) @(play.Id == Fresh ? "gc__play--new" : null)" @key="play.Id" data-seq="@play.Sequence" data-play="@play.Id">
            <span class="gc__when">@When(Sport, play)</span>
            <span class="gc__body">
                @if (Football && PlayHeadline.For(play) is { } headline)
                {
                    <span class="gc__headline">@headline</span>
                }
                @if (play.Start?.DownDistanceText is { Length: > 0 } dd)
                {
                    <span class="gc__dd">@dd</span>
                }
                <span class="gc__text">@(play.Text ?? play.Type ?? "Play")</span>
            </span>
            <span class="gc__trail">
                @if (play.IsScoring)
                {
                    <Tag State="DeskState.Positive">Score</Tag>
                }
                @if (play.IsTurnover)
                {
                    <Tag State="DeskState.Negative">Turnover</Tag>
                }
                @if (play.IsPenalty)
                {
                    <Tag State="DeskState.Warning">Penalty</Tag>
                }
                @if (play.Yardage is { } yards && !play.IsPenalty)
                {
                    <span class="gc__yards @(yards > 0 ? "up" : yards < 0 ? "down" : null)">@Yards(yards)</span>
                }
                @if (_swings.TryGetValue(play.Id, out var swing))
                {
                    var (side, points) = SwingOf(swing);
                    <span class="gc__swing">
                        <span aria-hidden="true">@side +@points</span>
                        <span class="sr-only">Win probability: @side up @points points</span>
                    </span>
                }
            </span>
        </li>
    </text>;

    /// <summary>When a play happened, as its row stamps it: "Q2 5:00", the mark or the clock alone, or nothing.</summary>
    public static string When(string? sport, GamecastPlay play)
        => (play.Period is { } period ? Periods.Mark(sport, period) : null, play.Clock) switch
        {
            ({ } mark, { Length: > 0 } clock) => $"{mark} {clock}",
            ({ } mark, _) => mark,
            (_, { Length: > 0 } clock) => clock,
            _ => string.Empty
        };

    private static string Yards(int yards) => yards switch
    {
        > 0 => $"+{yards}",
        < 0 => $"−{-yards}",
        _ => "0"
    };
}
