@using System.Globalization
@using XLines.Data.Gamecast

@*
    The field, drawn as a field: a hundred yards between two end zones, the away side's on the
    left and the home side's on the right, with the yard lines and their numbers, and a drive laid
    out on it play by play as ESPN's Gamecast draws one — each play an arc from where it started
    to where it ended, landing where the next begins: a pass thrown high, a run kept on the ground,
    a loss dipping back under it, a penalty dashed, a play for nothing a dot at its spot, a punt or
    a field goal a faint dotted long ball, the play that scored and the one that gave the ball away
    marked in their state colours. The arcs are in the colour of the side with the ball, the
    pair a chart spends on two series with no state (away the chart's neutral, home the accent's
    ink); the latest play is drawn heavier, and draws itself in, from where the ball was.

    Two modes. Live (Replay false): the drive in progress, with the line of scrimmage, the line to
    gain and the ball, pointing the way it is going; no spot, or nobody on the ball, draws the field
    alone, so the window does not jump between plays. Replay: a drive that is over, from DrivePlays
    for the side HomeBall names, with no ball and no lines (there is no next snap), its start marked
    and its end ringed with the result named under it — the one piece of words on the turf that is
    not a number or an end zone's name, because the drive's last word belongs where it happened.
    The result is in the image's accessible name as well.

    Every position is GamecastTelemetry's or FieldGeometry's, in the viewBox's own units (yards
    across, the same frame as the drive log's FieldSpan and the drive chart), so the markup says
    only how each mark looks. The ball and the two lines sit in groups moved by a transform, so when
    the server redraws on the next snap they slide from the old spot to the new one: motion that
    says where the ball came from. No edge and no card: the window's card holds it.
*@

@{
    var side = HomeBall;
    var marks = !Replay && side is { } home ? FieldGeometry.Marks(YardLine, Distance, home) : null;
    var drawn = side is not null && (Replay || marks is not null);
    var arcs = drawn ? GamecastTelemetry.DriveArcs(DrivePlays, side!.Value) : [];
    var band = !drawn ? null
        : Replay ? GamecastTelemetry.Band(DriveStartYardLine, DriveEndYardLine)
        : GamecastTelemetry.Band(DriveStartYardLine, YardLine);
    var sideClass = side switch { true => "fieldgraphic__arc--home", false => "fieldgraphic__arc--away", null => null };
    double? startX = drawn && DriveStartYardLine is { } s ? FieldGeometry.X(Math.Clamp(s, 0, 100)) : null;
    double? endX = drawn && Replay && DriveEndYardLine is { } e ? FieldGeometry.X(Math.Clamp(e, 0, 100)) : null;
    var result = Replay && !string.IsNullOrWhiteSpace(DriveResult) ? DriveResult.Trim() : null;
    var possession = side switch { true => HomeAbbrev, false => AwayAbbrev, null => null };
    var hasCaption = !string.IsNullOrWhiteSpace(Situation) || !string.IsNullOrWhiteSpace(LastPlay);
}

<div class="fieldgraphic @(Replay ? "fieldgraphic--replay" : null)">
    <svg class="fieldgraphic__svg" viewBox="0 0 @N(FieldGeometry.Width) @N(GamecastTelemetry.Height)"
         role="img" aria-label="@AccessibleName(drawn ? result : null)">
        @* The field and its two end zones. *@
        <rect class="fieldgraphic__field" x="@N(FieldGeometry.EndZone)" y="0" width="100" height="@N(GamecastTelemetry.Height)" />
        <rect class="fieldgraphic__zone fieldgraphic__zone--away" x="0" y="0" width="@N(FieldGeometry.EndZone)" height="@N(GamecastTelemetry.Height)" />
        <rect class="fieldgraphic__zone fieldgraphic__zone--home" x="@N(FieldGeometry.EndZone + 100)" y="0" width="@N(FieldGeometry.EndZone)" height="@N(GamecastTelemetry.Height)" />

        @* The red zone, only once the ball is inside the defence's twenty. *@
        @if (marks is { InRedZone: true })
        {
            <rect class="fieldgraphic__red"
                  x="@N(marks.RedFrom)" y="0" width="@N(marks.RedTo - marks.RedFrom)" height="@N(GamecastTelemetry.Height)" />
        }

        @* A tick at each five, top and bottom edge; a hairline at each ten, the fifty stronger. *@
        @foreach (var x in GamecastTelemetry.FiveYardTicks)
        {
            <line class="fieldgraphic__tick" x1="@N(x)" x2="@N(x)" y1="0" y2="@N(GamecastTelemetry.TickLength)" />
            <line class="fieldgraphic__tick" x1="@N(x)" x2="@N(x)" y1="@N(GamecastTelemetry.BottomTickTop)" y2="@N(GamecastTelemetry.Height)" />
        }

        @foreach (var x in GamecastTelemetry.TenYardLines)
        {
            <line class="fieldgraphic__yard @(x == GamecastTelemetry.Midfield ? "fieldgraphic__yard--mid" : null)"
                  x1="@N(x)" x2="@N(x)" y1="0" y2="@N(GamecastTelemetry.Height)" />
        }

        @foreach (var number in GamecastTelemetry.YardNumbers)
        {
            @* A group round each pair: Razor reads a bare <text> straight inside a loop as its own tag. *@
            <g class="fieldgraphic__nums">
                <text class="fieldgraphic__num" x="@N(number.X)" y="@N(GamecastTelemetry.TopNumberY)">@number.Number</text>
                <text class="fieldgraphic__num" x="@N(number.X)" y="@N(GamecastTelemetry.BottomNumberY)">@number.Number</text>
            </g>
        }

        @* Each side's abbreviation, set up its end zone. *@
        <text class="fieldgraphic__mark" transform="translate(@N(GamecastTelemetry.AwayMarkX) @N(GamecastTelemetry.Middle)) rotate(-90)">@AwayAbbrev</text>
        <text class="fieldgraphic__mark" transform="translate(@N(GamecastTelemetry.HomeMarkX) @N(GamecastTelemetry.Middle)) rotate(90)">@HomeAbbrev</text>

        @if (drawn)
        {
            @* The ground the drive has covered, a quiet strip under its arcs; then where it began. *@
            @if (band is not null)
            {
                <rect class="fieldgraphic__band" x="@N(band.Left)" y="@N(GamecastTelemetry.BandTop)"
                      width="@N(band.Width)" height="@N(GamecastTelemetry.BandThickness)" />
            }

            @if (startX is { } sx)
            {
                <line class="fieldgraphic__start" data-x="@N(sx)" x1="@N(sx)" x2="@N(sx)"
                      y1="@N(GamecastTelemetry.Baseline - GamecastTelemetry.StartMarkAbove)"
                      y2="@N(GamecastTelemetry.Baseline + GamecastTelemetry.StartMarkBelow)" />
            }

            @* The plays, one arc each, in order: a new play is appended as a new element, so only it draws in. *@
            <g class="fieldgraphic__arcs">
                @foreach (var arc in arcs)
                {
                    var classes = ArcClasses(arc, sideClass);
                    if (arc.Path is { } path)
                    {
                        <path class="@classes" data-kind="@Kind(arc.Kind)" d="@path"
                              pathLength="@(DrawsIn(arc) ? "1" : null)" />
                    }
                    else
                    {
                        <circle class="@classes" data-kind="@Kind(arc.Kind)"
                                cx="@N(arc.From)" cy="@N(GamecastTelemetry.Baseline)" r="@N(GamecastTelemetry.SpotRadius)" />
                    }
                }
            </g>

            @* Where the latest arc landed, so the eye finds the end of the drive's story. *@
            @if (arcs.Count > 0 && arcs[^1] is { Path: not null } last && marks is null && endX is null)
            {
                <circle class="fieldgraphic__landing @sideClass" cx="@N(last.To)" cy="@N(GamecastTelemetry.Baseline)" r="@N(GamecastTelemetry.SpotRadius)" />
            }

            @if (endX is { } ex)
            {
                <circle class="fieldgraphic__end @EndClass" data-x="@N(ex)"
                        cx="@N(ex)" cy="@N(GamecastTelemetry.Baseline)" r="@N(GamecastTelemetry.EndMarkRadius)" />
                @if (result is not null)
                {
                    @* In a group, for the same reason as the yard numbers: a bare <text> here is Razor's own tag. *@
                    <g class="fieldgraphic__results">
                        <text class="fieldgraphic__result @EndClass" x="@N(GamecastTelemetry.ResultX(ex))" y="@N(GamecastTelemetry.ResultY)">@result</text>
                    </g>
                }
            }
        }

        @if (marks is not null)
        {
            @if (marks.Gain is { } gain)
            {
                <g class="fieldgraphic__mover fieldgraphic__gain" style="transform: translateX(@(N(gain))px)">
                    <line x1="0" x2="0" y1="@N(GamecastTelemetry.LineTop)" y2="@N(GamecastTelemetry.LineBottom)" />
                </g>
            }

            <g class="fieldgraphic__mover fieldgraphic__scrim" style="transform: translateX(@(N(marks.Spot))px)">
                <line x1="0" x2="0" y1="@N(GamecastTelemetry.LineTop)" y2="@N(GamecastTelemetry.LineBottom)" />
            </g>

            @* The ball at the spot, on the ground the arcs land on, its arrow toward the goal being attacked. *@
            <g class="fieldgraphic__mover fieldgraphic__ball" data-spot="@N(marks.Spot)" style="transform: translateX(@(N(marks.Spot))px)">
                <polygon class="fieldgraphic__arrow" points="@GamecastTelemetry.ArrowPoints(marks.Leftward)" />
                <ellipse class="fieldgraphic__spot" cx="0" cy="@N(GamecastTelemetry.Baseline)" rx="1.6" ry="1" />
            </g>
        }
    </svg>

    @if (hasCaption)
    {
        <p class="fieldgraphic__caption">
            @if (!string.IsNullOrWhiteSpace(Situation))
            {
                <span class="fieldgraphic__situation">
                    @if (possession is not null)
                    {
                        <TeamMark Sport="@Sport" Abbrev="@possession" />
                        <span class="fieldgraphic__side">@possession</span>
                    }
                    @Situation
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(LastPlay))
            {
                <span class="fieldgraphic__lastplay">@LastPlay</span>
            }
        </p>
    }
</div>

@code {
    [Parameter] public string HomeAbbrev { get; set; } = "HOME";

    [Parameter] public string AwayAbbrev { get; set; } = "AWAY";

    /// <summary>Yards from the home goal line; null draws no ball, arcs or lines. Ignored in <see cref="Replay"/>.</summary>
    [Parameter] public int? YardLine { get; set; }

    /// <summary>Yards to go for a first down; null draws no line to gain. Ignored in <see cref="Replay"/>.</summary>
    [Parameter] public int? Distance { get; set; }

    /// <summary>
    /// True when the home side has the ball, false for the away side, null when nobody does. In
    /// <see cref="Replay"/>, the side whose drive it was; null draws the field alone.
    /// </summary>
    [Parameter] public bool? HomeBall { get; set; }

    /// <summary>The field in words, for a reader who cannot see it: "Field: PHI ball, 2nd and 6 at WSH 34".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>The league's key, for the crest beside the side with the ball in the caption.</summary>
    [Parameter] public string? Sport { get; set; }

    /// <summary>The plays of the drive on the field, in sequence order; empty draws no arcs.</summary>
    [Parameter] public IReadOnlyList<GamecastPlay> DrivePlays { get; set; } = [];

    /// <summary>Where the drive on the field started, on the home-goal frame; null draws no start mark and no covered ground.</summary>
    [Parameter] public int? DriveStartYardLine { get; set; }

    /// <summary>The last play in words, under the field.</summary>
    [Parameter] public string? LastPlay { get; set; }

    /// <summary>The down and the spot in words, "2nd & 6 at PHI 34", under the field.</summary>
    [Parameter] public string? Situation { get; set; }

    /// <summary>
    /// True for a drive that is over: its arcs, start and end, with no ball, scrimmage line or
    /// line to gain, and <see cref="YardLine"/> and <see cref="Distance"/> ignored.
    /// </summary>
    [Parameter] public bool Replay { get; set; }

    /// <summary>Where the finished drive ended, on the home-goal frame (a touchdown's is 0 or 100); null draws no end mark. Replay only.</summary>
    [Parameter] public int? DriveEndYardLine { get; set; }

    /// <summary>What the finished drive came to — "Touchdown", "Punt", "Field Goal", "Interception", "Downs" — named at its end. Replay only.</summary>
    [Parameter] public string? DriveResult { get; set; }

    /// <summary>The end mark's weight: a score strong and positive, a turnover negative, anything else the side's ink.</summary>
    private string EndClass => GamecastTelemetry.Outcome(DriveResult, isScore: false) switch
    {
        DriveOutcome.Score => "fieldgraphic__end--score",
        DriveOutcome.Turnover => "fieldgraphic__end--turnover",
        _ => HomeBall == true ? "fieldgraphic__end--home" : "fieldgraphic__end--away",
    };

    /// <summary>The label, with the finished drive's result after it when the label does not already say it.</summary>
    private string AccessibleName(string? result)
        => result is null || Label.Contains(result, StringComparison.OrdinalIgnoreCase)
            ? Label
            : string.IsNullOrWhiteSpace(Label) ? $"Result: {result}" : $"{Label.TrimEnd('.', ' ')}. Result: {result}";

    /// <summary>Only the latest solid arc draws in: a dashed or dotted one keeps its dashes in its own units.</summary>
    private static bool DrawsIn(DriveArc arc)
        => arc.Latest && arc.Kind is not (DriveArcKind.Penalty or DriveArcKind.Kick);

    private static string ArcClasses(DriveArc arc, string? side)
        => string.Join(' ', new[]
        {
            "fieldgraphic__arc",
            $"fieldgraphic__arc--{Kind(arc.Kind)}",
            side,
            arc.Score ? "fieldgraphic__arc--score" : null,
            arc.Turnover ? "fieldgraphic__arc--turnover" : null,
            arc.Latest ? "fieldgraphic__arc--latest" : null,
            DrawsIn(arc) ? "fieldgraphic__arc--draw" : null,
        }.Where(c => c is not null));

    private static string Kind(DriveArcKind kind) => kind switch
    {
        DriveArcKind.Pass => "pass",
        DriveArcKind.Run => "run",
        DriveArcKind.Loss => "loss",
        DriveArcKind.Penalty => "penalty",
        DriveArcKind.NoGain => "nogain",
        DriveArcKind.Kick => "kick",
        _ => "run",
    };

    private static string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
