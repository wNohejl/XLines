@using XLines.Core.Analytics
@using XLines.Data.CrossReference
@using XLines.Web.Services

@*
    Every priced side of a game, as three rows of a grouped form: a row per market, the
    market's name leading, and a two-segment control trailing — the two sides, each with its
    number and its best price. Pick one of a few, all visible, that sets a state: the HIG's
    segmented control (apple-hig-components, forms.md). One side across the three rows, so
    the other two rows show no cap at all rather than a wrong one.

    It was a 3×2 grid of outlined cells. A grid of cells reads as a table to look things up
    in, not a control to choose with; three rows of one control each read as a form, which
    is what this is. The market is named on the left of its row. Hovering or focusing a
    segment raises a tooltip that says in words what it wins on, and under that what the
    market means — a tooltip on the key itself, because a title on the market's name (text
    that takes no focus) never reached the keyboard (HIG 12).

    The accessible name of each segment is the desk's full label ("ML · Chiefs"), the same
    words the slip card and the journal use, so a screen reader hears the team and the
    market the eye gets from the row and the segment. One definition, shared by every
    window that logs a wager (SelectionGuardTests).
*@

<div class="selection-chips selection-form" role="group" aria-label="Your bet">
    @foreach (var group in SelectionChoice.All(Row).GroupBy(c => c.Market))
    {
        var cells = InColumns(group).ToList();
        var on = cells.FindIndex(IsChosen);
        var market = group.Key;
        var refs = RefsFor(market, cells.Count);

        <FormRow Label="@MarketTitle(group.Key)" Class="selection-group">
            @* One Tab stop per market, as DeskSwitch's gate is: Tab lands on the chosen side (or
               the first), the arrows travel inside the row. They move focus only — choosing a side
               folds the step, so an arrow that chose would fold the row out from under the key;
               Space or Enter chooses, as a press does. *@
            <div class="marble-row gate gate--lg selection-gate"
                 role="radiogroup"
                 aria-label="@MarketTitle(group.Key)"
                 @onkeydown="e => MoveAsync(e, market, on, refs)"
                 style="--n:@cells.Count; --i:@on">
                @if (on >= 0)
                {
                    <span class="marble gate__cap" aria-hidden="true"></span>
                }
                @foreach (var choice in cells)
                {
                    var chosen = IsChosen(choice);
                    var index = cells.IndexOf(choice);
                    @* mud-width-full: the tooltip's root becomes the grid cell, and MudBlazor's own
                       rule (.mud-tooltip-root:has(> .mud-width-full)) lets the segment fill it. *@
                    <DeskTooltip Text="@Tip(choice)">
                    <button type="button"
                            class="gate__opt selection-chip mud-width-full @(chosen ? "gate__opt--on selection-chip--on" : null)"
                            role="radio"
                            aria-checked="@(chosen ? "true" : "false")"
                            tabindex="@(index == Math.Max(on, 0) ? "0" : "-1")"
                            @ref="refs[index]"
                            @onfocus="() => _focused[market] = index"
                            aria-label="@choice.Label"
                            @onclick="() => OnChoose.InvokeAsync(choice)">
                        @* Two lines that never break inside themselves: who, then the numbers. Wide,
                           they sit on one line; narrow, every segment breaks in the same place. *@
                        @if (Team(choice) is { Length: > 0 } team)
                        {
                            @* The club's crest leads its name, so the two segments are told apart
                               before either is read. Decorative: the label says who it is. *@
                            <span class="selection-chip__team"><TeamMark Sport="@Row?.Game.Sport?.Key" Abbrev="@ClubAbbrev(choice)" />@team</span>
                        }
                        <span class="selection-chip__nums">
                            @if (Side(choice) is { Length: > 0 } side)
                            {
                                <span class="selection-chip__side num">@side</span>
                            }
                            @if (choice.Offer is { } offer)
                            {
                                <span class="selection-chip__price num">@OddsText.Price(offer.PriceAmerican)</span>
                            }
                            else
                            {
                                <span class="selection-chip__price selection-chip__price--none">no price</span>
                            }
                        </span>
                    </button>
                    </DeskTooltip>
                }
            </div>
        </FormRow>
    }
</div>

@code {
    [Parameter] public BoardRow? Row { get; set; }

    /// <summary>The chosen side's market (<c>Markets.*</c>). Null: nothing chosen.</summary>
    [Parameter] public string? Market { get; set; }

    [Parameter] public string? Outcome { get; set; }

    [Parameter] public EventCallback<SelectionChoice> OnChoose { get; set; }

    // Each market's segments, for the arrows to focus, and which one has focus now.
    private readonly Dictionary<string, ElementReference[]> _refs = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _focused = new(StringComparer.Ordinal);

    private ElementReference[] RefsFor(string market, int count)
    {
        if (!_refs.TryGetValue(market, out var refs) || refs.Length != count)
            _refs[market] = refs = new ElementReference[count];

        return refs;
    }

    /// <summary>DeskSwitch's keys: arrows step, Home and End jump, and the ends hold rather than wrap.</summary>
    private async Task MoveAsync(KeyboardEventArgs e, string market, int on, ElementReference[] refs)
    {
        var current = _focused.TryGetValue(market, out var f) && f < refs.Length ? f : Math.Max(on, 0);

        var next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => Math.Min(current + 1, refs.Length - 1),
            "ArrowLeft" or "ArrowUp" => Math.Max(current - 1, 0),
            "Home" => 0,
            "End" => refs.Length - 1,
            _ => current
        };

        if (next == current)
            return;

        _focused[market] = next;
        await refs[next].FocusAsync();
    }

    private bool IsChosen(SelectionChoice choice)
        => choice.Market == Market && string.Equals(choice.Outcome, Outcome, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The row's segments in reading order: away then home, as the matchup reads ("Steelers at
    /// Saints"); Over then Under. SelectionChoice.All lists home first.
    /// </summary>
    private IEnumerable<SelectionChoice> InColumns(IGrouping<string, SelectionChoice> group)
    {
        var cells = group.ToList();
        if (group.Key == Markets.Total)
            return cells.OrderBy(c => IsOver(c) ? 0 : 1);

        // A fight is billed red corner (home) first, as the Board and Every book bill it (ADR 0021).
        var lead = Fight ? Row?.Game.HomeTeam?.Name : Row?.Game.AwayTeam?.Name;
        return cells.OrderBy(c => string.Equals(c.Outcome, lead, StringComparison.OrdinalIgnoreCase) ? 0 : 1);
    }

    private static string MarketTitle(string market) => market switch
    {
        Markets.Moneyline => "Moneyline",
        Markets.Spread => "Spread",
        Markets.Total => "Total",
        _ => market
    };

    private static string MarketHelp(string market) => market switch
    {
        Markets.Moneyline => "Moneyline: the side you pick wins the game, by any margin.",
        Markets.Spread => "Spread: the side you pick has to beat the margin the book sets.",
        Markets.Total => "Total: the two teams' combined score, over or under the book's number.",
        _ => string.Empty
    };

    /// <summary>The club a segment is for, by its outcome's name, as ESPN abbreviates it; null for a total.</summary>
    private string? ClubAbbrev(SelectionChoice choice)
    {
        if (choice.Market == Markets.Total || Row?.Game is not { } game)
            return null;

        return string.Equals(choice.Outcome, game.AwayTeam?.Name, StringComparison.OrdinalIgnoreCase) ? game.AwayTeam?.Abbrev
            : string.Equals(choice.Outcome, game.HomeTeam?.Name, StringComparison.OrdinalIgnoreCase) ? game.HomeTeam?.Abbrev
            : null;
    }

    /// <summary>The team a segment is, said short ("Chiefs"); a total's segments say Over or Under in <see cref="Side"/>.</summary>
    private static string Team(SelectionChoice choice)
        => choice.Market == Markets.Total ? string.Empty : SelectionText.Short(choice.Outcome);

    /// <summary>
    /// The number in the segment: "-3", "Over 47.5". A moneyline has none — the team says the
    /// side, the price says what it pays.
    /// </summary>
    private static string Side(SelectionChoice choice) => choice.Market switch
    {
        Markets.Moneyline => string.Empty,
        // "Over 47.5", not "Over o47.5": the word already says which side of the number.
        Markets.Total => SelectionText.Short(choice.Outcome)
                         + (choice.Offer?.Line is { } total ? " " + Math.Abs(total).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : ""),
        _ => choice.Offer?.Line is { } line ? OddsMath.FormatLine(line, choice.Outcome) : string.Empty
    };

    /// <summary>
    /// A segment's tooltip: what it wins on, then on a line of its own what the market means —
    /// the help the market's name used to carry in a title only a pointer could raise.
    /// </summary>
    private string Tip(SelectionChoice choice)
        => MarketHelp(choice.Market) is { Length: > 0 } help ? $"{Explain(choice)}\n{help}" : Explain(choice);

    private bool Fight => FightSports.IsFight(Row?.Game.Sport?.Key);

    /// <summary>
    /// What the option wins on, in a sentence, for whoever does not read a line by eye — in the
    /// sport's own unit: a baseball total is runs, a fight's is rounds, and a fight is not a game.
    /// </summary>
    private string Explain(SelectionChoice choice)
    {
        var line = choice.Offer?.Line;
        var by = line is { } l ? Math.Abs(l).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : null;
        var unit = Fight ? "rounds" : string.Equals(Row?.Game.Sport?.Key, "mlb", StringComparison.OrdinalIgnoreCase) ? "runs" : "points";

        return choice.Market switch
        {
            Markets.Moneyline => $"{choice.Outcome} win the {(Fight ? "fight" : "game")}.",
            Markets.Spread when line is < 0 => $"{choice.Outcome} win by more than {by}.",
            Markets.Spread when line is > 0 => $"{choice.Outcome} win, or lose by less than {by}.",
            Markets.Spread => $"{choice.Outcome} cover the spread.",
            Markets.Total when Fight && by is not null =>
                $"The fight goes {(IsOver(choice) ? "longer" : "shorter")} than {by} rounds.",
            Markets.Total when by is not null =>
                $"The two teams score {(IsOver(choice) ? "more" : "fewer")} than {by} {unit} combined.",
            Markets.Total => $"The combined score goes {(IsOver(choice) ? "over" : "under")} the total.",
            _ => choice.Label
        };
    }

    private static bool IsOver(SelectionChoice choice)
        => string.Equals(choice.Outcome, "over", StringComparison.OrdinalIgnoreCase);
}
